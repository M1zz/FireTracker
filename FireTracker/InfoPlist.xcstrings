    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح Face ID التطبيق لحماية بياناتك المالية."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID odemyká aplikaci, aby vaše finanční údaje zůstaly v bezpečí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID låser appen op, så dine økonomiske oplysninger forbliver private."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID entsperrt die App, damit deine Finanzdaten geschützt bleiben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Face ID ξεκλειδώνει την εφαρμογή για να προστατεύει τα οικονομικά σας στοιχεία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID unlocks the app to keep your financial details private."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID unlocks the app to keep your financial details private."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID desbloquea la app para proteger tus datos financieros."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID avaa apin lukituksen, jotta taloustietosi pysyvät suojassa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID déverrouille l'app pour protéger vos données financières."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID membuka kunci aplikasi untuk melindungi data keuangan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID sblocca l'app per proteggere i tuoi dati finanziari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "資産情報を守るため、Face IDでロックを解除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자산 정보를 보호하기 위해 Face ID로 잠금을 해제합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID låser opp appen slik at økonomien din holdes privat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID ontgrendelt de app om je financiële gegevens te beschermen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID odblokowuje aplikację, by chronić Twoje dane finansowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Face ID desbloqueia o app para proteger seus dados financeiros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID разблокирует приложение, чтобы защитить ваши финансовые данные."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID låser upp appen så att din ekonomi förblir privat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ Face ID ปลดล็อกแอปเพื่อปกป้องข้อมูลทรัพย์สินของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID, finansal bilgilerini korumak için uygulamanın kilidini açar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID mở khóa ứng dụng để bảo vệ thông tin tài sản của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用面容 ID 解锁，保护你的资产信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Face ID 解鎖，保護你的資產資訊。"
          }
        }
      }
    }
  },
  "version": "1.0"
}