    "연도를 고르고 그때 받던 월급을 적어보세요. 두 해 이상이면 구매력 변화가 보여요." : {
      "comment" : "Text displayed below the wage input form.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a year and enter the salary you earned then. With two or more years, you'll see your buying power change."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a year and enter the salary you earned then. With two or more years, you'll see your buying power change."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "年を選んで、そのころもらっていた給料を入力してください。2年以上あると購買力の変化がわかります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选一个年份，填入当时拿的月薪。两个年份以上就能看到购买力的变化。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選一個年份，填入當時拿的月薪。兩個年份以上就能看到購買力的變化。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un año e introduce el sueldo que cobrabas entonces. Con dos o más años verás cambiar tu poder adquisitivo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle ein Jahr und trag das Gehalt ein, das du damals hattest. Ab zwei Jahren siehst du, wie sich deine Kaufkraft verändert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une année et saisissez le salaire que vous touchiez alors. À partir de deux années, vous voyez l’évolution de votre pouvoir d’achat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un anno e inserisci lo stipendio di allora. Con due o più anni vedi come cambia il potere d’acquisto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um ano e informe o salário que você recebia na época. Com dois ou mais anos, você vê o poder de compra mudar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите год и укажите зарплату, которую вы тогда получали. С двумя годами и больше видно изменение покупательной способности."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกปีแล้วกรอกเงินเดือนที่ได้ตอนนั้น ตั้งแต่สองปีขึ้นไปจะเห็นอำนาจซื้อเปลี่ยน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn một năm và nhập mức lương khi đó. Từ hai năm trở lên sẽ thấy sức mua thay đổi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte rok a zadejte tehdejší mzdu. Od dvou let výš uvidíte změnu kupní síly."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg et år og indtast den løn, du havde dengang. Med to eller flere år kan du se købekraften ændre sig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαλέξτε ένα έτος και βάλτε τον μισθό που παίρνατε τότε. Με δύο ή περισσότερα έτη βλέπετε πώς αλλάζει η αγοραστική δύναμη."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse vuosi ja syötä silloin saamasi palkka. Kahdella tai useammalla vuodella näet ostovoiman muutoksen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih tahun dan masukkan gaji yang Anda terima saat itu. Dengan dua tahun atau lebih, Anda melihat daya beli berubah."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg et år og skriv inn lønnen du hadde da. Med to eller flere år ser du kjøpekraften endre seg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies een jaar en voer het salaris in dat je toen kreeg. Met twee of meer jaren zie je je koopkracht veranderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz rok i wpisz pensję, którą wtedy miałeś. Przy dwóch lub więcej latach zobaczysz zmianę siły nabywczej."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj ett år och ange lönen du hade då. Med två eller fler år ser du köpkraften förändras."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir yıl seçip o zaman aldığınız maaşı girin. İki veya daha fazla yılla satın alma gücünün değişimini görürsünüz."
          }
        }
      }
