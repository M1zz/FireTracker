    "고점 %@원에서 %@%% 넘게 빠졌어요(지금 %@원). 정해 둔 원칙대로 팔아 주세요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cena klesla o víc než %2$@%% z maxima %1$@ wonů (teď %3$@ wonů). Prodejte podle svého pravidla."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fra toppen på %@ won er den faldet mere end %@ %% (nu %@ won). Sælg efter dine regler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vom Hoch bei %@ Won um mehr als %@ %% gefallen (jetzt %@ Won). Verkaufe nach deiner Regel."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έπεσε πάνω από %2$@%% από την κορυφή των %1$@ γουόν (τώρα %3$@ γουόν). Πουλήστε σύμφωνα με τον κανόνα σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Down more than %2$@%% from its %1$@ won peak (now %3$@ won). Sell as your rule says."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Down more than %2$@%% from its %1$@ won peak (now %3$@ won). Sell as your rule says."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha caído más de un %2$@%% desde el máximo de %1$@ wones (ahora %3$@ wones). Vende según la regla que fijaste."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laskenut yli %2$@ %% huipusta %1$@ wonia (nyt %3$@ wonia). Myy asettamasi säännön mukaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En baisse de plus de %2$@ %% depuis le plus haut de %1$@ wons (actuellement %3$@ wons). Vendez comme le prévoit votre règle."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turun lebih dari %2$@%% dari puncak %1$@ won (sekarang %3$@ won). Jual sesuai aturan yang Anda tetapkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È sceso di oltre il %2$@%% dal massimo di %1$@ won (ora %3$@ won). Vendi secondo la regola che hai fissato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高値%@ウォンから%@%%以上下がりました（現在%@ウォン）。決めておいたルールどおりに売りましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fra toppen på %@ won har den falt mer enn %@ %% (nå %@ won). Selg etter reglene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vanaf de top van %@ won meer dan %@%% gedaald (nu %@ won). Verkoop volgens je regel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cena spadła o ponad %2$@%% od szczytu %1$@ wonów (teraz %3$@ wonów). Sprzedaj zgodnie ze swoją zasadą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caiu mais de %2$@%% do pico de %1$@ wons (agora %3$@ wons). Venda conforme sua regra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цена упала больше чем на %2$@%% от пика %1$@ вон (сейчас %3$@ вон). Продайте по своему правилу."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Från toppen på %@ won har den fallit mer än %@ %% (nu %@ won). Sälj enligt dina regler."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลดลงเกิน %2$@%% จากจุดสูงสุด %1$@ วอน (ตอนนี้ %3$@ วอน) ขายตามกฎที่ตั้งไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ won zirveden %%%2$@ fazla düştü (şu an %3$@ won). Belirlediğiniz kurala göre satın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã giảm hơn %2$@%% từ đỉnh %1$@ won (hiện %3$@ won). Hãy bán theo nguyên tắc đã định."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已从高点%@韩元下跌超过%@%%（现价%@韩元）。请按设定的原则卖出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已從高點%@韓元下跌超過%@%%（現價%@韓元）。請照設定的原則賣出。"
          }
        }
