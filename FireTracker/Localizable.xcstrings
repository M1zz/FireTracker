{
  "sourceLanguage": "ko",
  "strings": {
    " · 지난 기록보다 %@ 가까워졌어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " · %@ closer than last record"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " · 지난 기록보다 %@ 가까워졌어요"
          }
        }
      }
    },
    " · 지난 기록보다 %@ 멀어졌어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " · %@ further than last record"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " · 지난 기록보다 %@ 멀어졌어요"
          }
        }
      }
    },
    "%@ · 한 번 결제로 평생": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · Pay once, keep forever"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 한 번 결제로 평생"
          }
        }
      }
    },
    "%@ 기능은 프로에서 열려요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is part of Pro."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 기능은 프로에서 열려요."
          }
        }
      }
    },
    "%@년, %lld세에 퇴사할 수 있어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can quit in %1$@, at age %2$lld"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@년, %lld세에 퇴사할 수 있어요"
          }
        }
      }
    },
    "%@년에 퇴사할 수 있어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can quit in %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@년에 퇴사할 수 있어요"
          }
        }
      }
    },
    "같은 돈으로 빚을 갚을까, 투자할까. 어느 쪽이 퇴사를 앞당기는지 비교해요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay off debt or invest the same money? Compare which brings your quit date closer."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 돈으로 빚을 갚을까, 투자할까. 어느 쪽이 퇴사를 앞당기는지 비교해요."
          }
        }
      }
    },
    "같은 돈으로 빚을 갚을지 투자할지, 어느 쪽이 퇴사를 앞당기는지 비교해요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare paying off debt with investing the same money, and see which brings your quit date closer."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 돈으로 빚을 갚을지 투자할지, 어느 쪽이 퇴사를 앞당기는지 비교해요."
          }
        }
      }
    },
    "개인정보처리방침": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy Policy"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인정보처리방침"
          }
        }
      }
    },
    "계산 무제한 저장": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlimited Saved Calculations"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계산 무제한 저장"
          }
        }
      }
    },
    "구독이 아니에요. 다시 결제할 일이 없어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not a subscription. You never pay again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독이 아니에요. 다시 결제할 일이 없어요."
          }
        }
      }
    },
    "구매 복원": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore Purchase"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매 복원"
          }
        }
      }
    },
    "구매력": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchasing Power"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매력"
          }
        }
      }
    },
    "구매를 복원했어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your purchase has been restored."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매를 복원했어요."
          }
        }
      }
    },
    "권한 강제 (개발자)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Force Access (Developer)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한 강제 (개발자)"
          }
        }
      }
    },
    "내 목표에 반영했어요. 대시보드 퇴사각이 이 값으로 다시 계산돼요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved to your goals. The quit date on the Dashboard now uses these values."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 목표에 반영했어요. 대시보드 퇴사각이 이 값으로 다시 계산돼요."
          }
        }
      }
    },
    "내 시급으로 돈을 시간으로 바꿔 보고, 저축이 시급을 넘는 시점을 찾아요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn money into hours at your hourly wage, and find when your savings out-earn your work."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 시급으로 돈을 시간으로 바꿔 보고, 저축이 시급을 넘는 시점을 찾아요."
          }
        }
      }
    },
    "닫기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫기"
          }
        }
      }
    },
    "대출": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loan"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대출"
          }
        }
      }
    },
    "대출 상환에 매달 얼마가 묶이는지 봐요. 빚이 끝나는 날이 퇴사각을 바꿔요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See how much loan repayment ties up every month. The day your debt ends moves your quit date."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대출 상환에 매달 얼마가 묶이는지 봐요. 빚이 끝나는 날이 퇴사각을 바꿔요."
          }
        }
      }
    },
    "돈과 시간": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money & Time"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "돈과 시간"
          }
        }
      }
    },
    "돈을 내 시간으로 바꿔 보고, 자산 수익이 시급을 넘는 시점을 찾아요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn money into your hours, and find when your investment income out-earns your hourly wage."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "돈을 내 시간으로 바꿔 보고, 자산 수익이 시급을 넘는 시점을 찾아요."
          }
        }
      }
    },
    "매매 원장": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trade Ledger"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매매 원장"
          }
        }
      }
    },
    "매매 원장은 프로 기능이에요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The trade ledger is a Pro feature"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매매 원장은 프로 기능이에요"
          }
        }
      }
    },
    "모으는 시기와 쓰는 시기를 한 곡선으로 그려, 은퇴 후 자산이 몇 살까지 버티는지 봐요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw saving and spending years as one curve, and see how long your money lasts after you retire."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모으는 시기와 쓰는 시기를 한 곡선으로 그려, 은퇴 후 자산이 몇 살까지 버티는지 봐요."
          }
        }
      }
    },
    "목표 %@원 중 %@원 남음": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ won left of %1$@ won"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표 %@원 중 %@원 남음"
          }
        }
      }
    },
    "목표 생활비 정하기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set your target living costs"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표 생활비 정하기"
          }
        }
      }
    },
    "목표 생활비를 정해 주세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set your target living costs"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표 생활비를 정해 주세요"
          }
        }
      }
    },
    "목표 자산(연간 목표 지출 ÷ 인출률)에 닿는 시점이에요. 지금 순자산에서 시작해 월 저축과 기대 수익률로 계산했어요. 목표는 여정 탭 오른쪽 위 과녁에서 바꿀 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is when you reach your target (annual spending ÷ withdrawal rate), starting from today's net worth with your monthly savings and expected return. Change the target from the target icon at the top right of the Journey tab."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표 자산(연간 목표 지출 ÷ 인출률)에 닿는 시점이에요. 지금 순자산에서 시작해 월 저축과 기대 수익률로 계산했어요. 목표는 여정 탭 오른쪽 위 과녁에서 바꿀 수 있어요."
          }
        }
      }
    },
    "목표 자산까지": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toward your target"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표 자산까지"
          }
        }
      }
    },
    "목표 자산을 이미 넘었어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've already passed your target."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표 자산을 이미 넘었어요."
          }
        }
      }
    },
    "목표한 %lld세보다 %lld년 늦어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld years later than your target age of %1$lld"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표한 %lld세보다 %lld년 늦어요"
          }
        }
      }
    },
    "목표한 %lld세보다 %lld년 빨라요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld years earlier than your target age of %1$lld"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표한 %lld세보다 %lld년 빨라요"
          }
        }
      }
    },
    "목표한 %lld세에 딱 맞아요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right on your target age of %lld"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표한 %lld세에 딱 맞아요"
          }
        }
      }
    },
    "무료 저장 %lld개를 다 썼어요. 프로는 제한 없이 저장해요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've used all %lld free saves. Pro saves without limits."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 저장 %lld개를 다 썼어요. 프로는 제한 없이 저장해요."
          }
        }
      }
    },
    "무료로 %lld개 더 저장할 수 있어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld more free saves left"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료로 %lld개 더 저장할 수 있어요"
          }
        }
      }
    },
    "무료로는 3개까지 저장할 수 있어요. 프로는 제한 없이 저장해요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save up to 3 calculations for free. Pro saves without limits."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료로는 3개까지 저장할 수 있어요. 프로는 제한 없이 저장해요."
          }
        }
      }
    },
    "복원할 구매가 없어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No purchase to restore."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원할 구매가 없어요."
          }
        }
      }
    },
    "빚 vs 투자": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Debt vs Invest"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빚 vs 투자"
          }
        }
      }
    },
    "빚 갚기 vs 투자하기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay Off Debt vs Invest"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빚 갚기 vs 투자하기"
          }
        }
      }
    },
    "상품 다시 불러오기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload"
          }
        },
