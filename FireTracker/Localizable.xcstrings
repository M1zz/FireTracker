          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "例：転職で貯蓄が増えるなら+30%、引っ越しで生活費が減るなら−20%。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
