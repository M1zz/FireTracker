          "stringUnit": {
            "state": "translated",
            "value": "%@년, %lld세에 퇴사할 수 있어요"
          }
        }
      }
    },
    "%@년에 퇴사할 수 있어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can quit in %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@년에 퇴사할 수 있어요"
          }
        }
      }
