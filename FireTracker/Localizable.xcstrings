    "%@년 → %@년 물가가 %@ 올랐어요. 다른 해의 월급도 한 줄 더 넣으면 구매력 변화를 볼 수 있어요." : {
      "comment" : "A note that compares the inflation rate from one year to another.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@년 → %2$@년 물가가 %3$@ 올랐어요. 다른 해의 월급도 한 줄 더 넣으면 구매력 변화를 볼 수 있어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prices rose %3$@ from %1$@ to %2$@. Add a salary from another year to see how your buying power changed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prices rose %3$@ from %1$@ to %2$@. Add a salary from another year to see how your buying power changed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@年→%2$@年で物価が%3$@上がりました。別の年の給料も1行足すと、購買力の変化がわかります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@年→%2$@年，物价上涨了%3$@。再加一行其他年份的月薪，就能看到购买力的变化。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@年→%2$@年，物價上漲了%3$@。再加一行其他年份的月薪，就能看到購買力的變化。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre %1$@ y %2$@ los precios subieron un %3$@. Añade el sueldo de otro año para ver cómo cambió tu poder adquisitivo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von %1$@ bis %2$@ sind die Preise um %3$@ gestiegen. Trag ein Gehalt aus einem weiteren Jahr ein, um die Veränderung deiner Kaufkraft zu sehen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre %1$@ et %2$@, les prix ont augmenté de %3$@. Ajoutez le salaire d’une autre année pour voir l’évolution de votre pouvoir d’achat."
          }
        },
        "it" : {
          "stringUnit" : {
