          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’hypothèse « rendement selon la taille » est activée : un scénario optimiste qui ajoute 0,5 à 1,5 point de pourcentage au rendement annuel à mesure que le patrimoine grandit (Fagereng 2020, Piketty). En réalité, ce surplus de rendement s’accompagne de plus de risque."
          }
        },
