    "지난 월급을 물가로 나눠 내 실질 구매력이 늘었는지 알려줘요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjust past salaries for inflation to see whether your real purchasing power grew."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지난 월급을 물가로 나눠 내 실질 구매력이 늘었는지 알려줘요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjust past salaries for inflation to see whether your real purchasing power grew."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "過去の給料を物価で調整して、実質の購買力が伸びたかを確かめます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按物价调整过去的月薪，看实际购买力有没有增长。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按物價調整過去的月薪，看實際購買力有沒有增長。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta sueldos pasados por la inflación para ver si creció tu poder adquisitivo real."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereinige frühere Gehälter um die Inflation und sieh, ob deine reale Kaufkraft gewachsen ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustez les anciens salaires de l’inflation pour voir si votre pouvoir d’achat réel a progressé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adegua gli stipendi passati all’inflazione per vedere se il tuo potere d’acquisto reale è cresciuto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste salários passados pela inflação para ver se seu poder de compra real cresceu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скорректируйте прошлые зарплаты на инфляцию, чтобы увидеть, выросла ли реальная покупательная способность."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปรับเงินเดือนในอดีตตามเงินเฟ้อ เพื่อดูว่าอำนาจซื้อจริงเพิ่มขึ้นไหม"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều chỉnh lương trong quá khứ theo lạm phát để xem sức mua thực có tăng không."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upravte dřívější mzdy o inflaci a uvidíte, zda vaše reálná kupní síla vzrostla."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Justér tidligere lønninger for inflation og se, om din reelle købekraft steg."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσαρμόστε τους παλιούς μισθούς για τον πληθωρισμό και δείτε αν αυξήθηκε η πραγματική αγοραστική σας δύναμη."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oikaise aiempia palkkoja inflaatiolla nähdäksesi, kasvoiko reaalinen ostovoimasi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesuaikan gaji masa lalu dengan inflasi untuk melihat apakah daya beli riil Anda naik."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juster tidligere lønninger for inflasjon og se om den reelle kjøpekraften din økte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrigeer eerdere salarissen voor inflatie om te zien of je reële koopkracht is gegroeid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skoryguj dawne pensje o inflację, aby zobaczyć, czy twoja realna siła nabywcza wzrosła."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Justera tidigare löner för inflation och se om din reala köpkraft ökade."
          }
        }
      }
    },
