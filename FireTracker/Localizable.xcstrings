        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βάλτε τον κωδικό και ενεργοποιήστε την αυτόματη τιμή και θα σας ειδοποιούμε σύμφωνα με τον κανόνα σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter the ticker and turn on auto price and we'll alert you by your rule."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter the ticker and turn on auto price and we'll alert you by your rule."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
