    "일을 그만둔 뒤 매달 쓰고 싶은 돈이에요. 지금 생활비를 떠올리면 쉬워요." : {
      "comment" : "A description of the monthly amount the user wants to save each month.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To, co chcete měsíčně utrácet, až přestanete pracovat. Vzpomeňte si na své současné životní náklady."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det, du vil bruge hver måned, når du holder op med at arbejde. Tænk på dine nuværende leveomkostninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was du jeden Monat ausgeben möchtest, wenn du nicht mehr arbeitest. Denk an deine heutigen Lebenskosten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ό,τι θέλετε να ξοδεύετε κάθε μήνα όταν σταματήσετε να εργάζεστε. Σκεφτείτε το τωρινό κόστος ζωής σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What you want to spend each month after you stop working. Think of your current living costs."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What you want to spend each month after you stop working. Think of your current living costs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que quieres gastar cada mes cuando dejes de trabajar. Piensa en tus gastos de vida actuales."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se, mitä haluat käyttää joka kuukausi, kun lopetat työnteon. Ajattele nykyisiä elinkustannuksiasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que vous voulez dépenser chaque mois quand vous ne travaillez plus. Pensez à vos frais de vie actuels."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yang ingin Anda belanjakan tiap bulan setelah berhenti bekerja. Bayangkan biaya hidup Anda sekarang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quello che vuoi spendere ogni mese quando smetti di lavorare. Pensa alle tue spese di vita attuali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仕事を辞めたあとに毎月使いたいお金です。今の生活費を思い浮かべると簡単です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det du vil bruke hver måned når du slutter å jobbe. Tenk på dagens levekostnader."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat je elke maand wilt uitgeven zodra je stopt met werken. Denk aan je huidige leefkosten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To, co chcesz wydawać co miesiąc, gdy przestaniesz pracować. Pomyśl o obecnych kosztach życia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que você quer gastar por mês depois de parar de trabalhar. Pense no seu custo de vida atual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "То, что вы хотите тратить каждый месяц, перестав работать. Представьте нынешние расходы на жизнь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det du vill spendera varje månad när du slutar arbeta. Tänk på dina nuvarande levnadskostnader."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เงินที่อยากใช้ทุกเดือนเมื่อเลิกทำงาน นึกถึงค่าครองชีพตอนนี้จะง่ายขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalışmayı bıraktığınızda her ay harcamak istediğiniz para. Şimdiki geçim giderinizi düşünün."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số tiền bạn muốn chi mỗi tháng sau khi thôi làm việc. Hãy nghĩ đến sinh hoạt phí hiện tại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你不再工作后每月想花的钱。想想现在的生活费就容易了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你不再工作後每月想花的錢。想想現在的生活費就容易了。"
          }
        }
      }
    },
    "일하지 않아도 돈이 들어오게 하는 대표적인 방법이에요. 누르면 바로 그 자산을 추가할 수 있어요." : {
      "comment" : "A description of a section that shows how to make passive income.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typické způsoby, jak získat peníze bez práce. Klepnutím hned přidáte takový majetek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typiske måder at få penge ind uden at arbejde. Tryk for straks at tilføje det aktiv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typische Wege, Geld ohne Arbeit zu bekommen. Tippe, um dieses Vermögen sofort hinzuzufügen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τυπικοί τρόποι να μπαίνουν χρήματα χωρίς δουλειά. Πατήστε για να προσθέσετε αμέσως αυτό το περιουσιακό στοιχείο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typical ways to have money come in without working. Tap to add that asset right away."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typical ways to have money come in without working. Tap to add that asset right away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formas típicas de que entre dinero sin trabajar. Toca para añadir ese activo al instante."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyypillisiä tapoja saada rahaa ilman työtä. Napauta lisätäksesi kyseinen vara heti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des moyens classiques de recevoir de l’argent sans travailler. Touchez pour ajouter aussitôt cet actif."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cara umum agar uang masuk tanpa bekerja. Ketuk untuk langsung menambahkan aset itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modi tipici per far entrare denaro senza lavorare. Tocca per aggiungere subito quell’attività."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "働かなくてもお金が入る代表的な方法です。タップするとすぐその資産を追加できます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typiske måter å få penger inn uten å jobbe. Trykk for å legge til den eiendelen med en gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruikelijke manieren om geld binnen te krijgen zonder te werken. Tik om dat bezit meteen toe te voegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typowe sposoby na wpływ pieniędzy bez pracy. Stuknij, aby od razu dodać to aktywo."
