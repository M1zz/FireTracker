    "필요할 때 연금부터 한꺼번에 꺼내는 것보다 세금이 %@원 줄어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ušetří %@ wonů na daních oproti jednorázovému výběru důchodu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparer %@ won i skat sammenlignet med at hæve pensionen på én gang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spart %@ Won Steuern gegenüber einer einmaligen Rentenauszahlung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εξοικονομεί %@ γουόν σε φόρους σε σχέση με την εφάπαξ ανάληψη της σύνταξης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saves %@ won in tax versus drawing your pension all at once."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saves %@ won in tax versus drawing your pension all at once."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahorra %@ wones en impuestos frente a cobrar la pensión de golpe."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säästää %@ wonia verossa verrattuna eläkkeen nostamiseen kerralla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Économise %@ wons d’impôts par rapport à un retrait de la retraite en une fois."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghemat pajak %@ won dibanding menarik pensiun sekaligus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Risparmi %@ won di tasse rispetto a prelevare la pensione in un’unica soluzione."
          }
        },
        "ja" : {
          "stringUnit" : {
