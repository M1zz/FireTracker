          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใส่เงินเดือนตั้งแต่สองปีขึ้นไป\nจะเห็นอำนาจซื้อที่หักเงินเฟ้อแล้ว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập lương của hai năm trở lên\nđể thấy sức mua sau khi trừ lạm phát."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadejte mzdy ze dvou a více let,\nuvidíte kupní sílu po odečtení inflace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indtast lønninger for to eller flere år,\nså ser du købekraften efter inflation."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βάλτε μισθούς δύο ή περισσότερων ετών\nγια να δείτε την αγοραστική δύναμη χωρίς τον πληθωρισμό."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syötä kahden tai useamman vuoden palkat,\nniin näet ostovoiman inflaation poistettuna."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
