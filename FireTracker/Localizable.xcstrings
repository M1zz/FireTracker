    "대비를 높이거나 색을 구별하기 어려워도 내용을 알아볼 수 있어요." : {
      "comment" : "Roadmap item detail: contrast and color",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vše zůstane čitelné, i při zapnutém zvýšeném kontrastu nebo když se barvy špatně rozlišují."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt kan stadig læses, selv med Øg kontrast slået til, eller hvis farver er svære at skelne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles bleibt lesbar, auch mit erhöhtem Kontrast oder wenn Farben schwer zu unterscheiden sind."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλα παραμένουν ευανάγνωστα, ακόμα και με ενεργή την Αύξηση αντίθεσης ή αν δυσκολεύεστε να ξεχωρίσετε χρώματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything stays readable, even with Increase Contrast on or if colors are hard to tell apart."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything stays readable, even with Increase Contrast on or if colours are hard to tell apart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo sigue siendo legible, incluso con Aumentar contraste activado o si te cuesta distinguir los colores."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki pysyy luettavana, vaikka Lisää kontrastia olisi päällä tai värien erottaminen olisi vaikeaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout reste lisible, même avec Augmenter le contraste ou si les couleurs sont difficiles à distinguer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua tetap terbaca, bahkan dengan Tingkatkan Kontras aktif atau jika sulit membedakan warna."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto resta leggibile, anche con Aumenta contrasto attivo o se fai fatica a distinguere i colori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントラストを上げたり、色の区別が難しくても、内容を読み取れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대비를 높이거나 색을 구별하기 어려워도 내용을 알아볼 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt er fortsatt lesbart, selv med Øk kontrast slått på eller hvis farger er vanskelige å skille."
