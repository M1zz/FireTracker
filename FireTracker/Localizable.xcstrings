    "월세를 줬습니다. 매달 월세가 현금흐름으로 잡힙니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rented out monthly. The rent counts as cash flow each month."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rented out monthly. The rent counts as cash flow each month."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月払いで貸しています。毎月の家賃がキャッシュフローとして計上されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已按月出租。每月房租计为现金流。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已按月出租。每月房租計為現金流。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo tienes alquilado al mes. El alquiler mensual cuenta como flujo de caja."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monatlich vermietet. Die Miete zählt jeden Monat als Cashflow."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loué au mois. Le loyer mensuel est compté comme flux de trésorerie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’hai data in affitto. L’affitto mensile conta come flusso di cassa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alugado mensalmente. O aluguel entra como fluxo de caixa todo mês."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сдано помесячно. Аренда каждый месяц идёт в денежный поток."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปล่อยเช่ารายเดือน ค่าเช่าแต่ละเดือนนับเป็นกระแสเงินสด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn cho thuê theo tháng. Tiền thuê hằng tháng được tính vào dòng tiền."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pronajato za nájem. Nájem se každý měsíc počítá do peněžního toku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udlejet mod månedlig husleje. Huslejen regnes som pengestrøm hver måned."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το νοικιάσατε με μηνιαίο ενοίκιο. Το ενοίκιο μετράει κάθε μήνα ως ταμειακή ροή."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annettu vuokralle. Kuukausivuokra lasketaan rahavirraksi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disewakan bulanan. Sewa tiap bulan dihitung sebagai arus kas."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utleid mot månedlig leie. Leien regnes som kontantstrøm hver måned."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verhuurd per maand. De huur telt elke maand als kasstroom."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wynajęte za czynsz. Co miesiąc czynsz trafia do przepływu pieniędzy."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uthyrd mot månadshyra. Hyran räknas som kassaflöde varje månad."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiraya verdiniz. Her ayki kira nakit akışı olarak sayılır."
          }
        }
      }
    },
