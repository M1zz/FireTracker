    "%lld~%lld세: 일반계좌와 ISA에서 꺼내 써요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ages %1$lld–%2$lld: draw from your taxable account and ISA"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld~%lld세: 일반계좌와 ISA에서 꺼내 써요"
          }
        }
      }
    },
    "%lld년 늦게": {
      "localizations": {
        "en": {
