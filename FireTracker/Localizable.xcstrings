          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nonaktif menyingkat jumlah besar dalam satuan Korea (eok = 100 juta, man = 10 ribu); aktif menampilkan angka penuh seperti “600.000.000 won”. Berlaku di seluruh app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivato abbrevia le cifre grandi in unità coreane (eok = 100 mln, man = 10.000); attivato mostra numeri interi come «600.000.000 won». Vale per tutta l’app."
          }
        },
        "ja" : {
          "stringUnit" : {
