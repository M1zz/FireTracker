    "원리금균등 — 매달 같은 금액을 내요. 초반엔 이자 비중이 크고, 갈수록 원금 비중이 커져요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anuita — každý měsíc platíte stejnou částku. Zpočátku tvoří větší díl úroky, postupně roste podíl jistiny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuitet – du betaler det samme beløb hver måned. I starten er renteandelen stor, og efterhånden vokser afdragsandelen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuität – du zahlst jeden Monat den gleichen Betrag. Anfangs ist der Zinsanteil hoch, mit der Zeit wächst der Tilgungsanteil."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ίσες δόσεις — πληρώνετε το ίδιο ποσό κάθε μήνα. Στην αρχή οι τόκοι είναι μεγάλο μέρος, και σιγά σιγά μεγαλώνει το μέρος του κεφαλαίου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equal payments — you pay the same amount every month. Early on most of it is interest; over time more goes to principal."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equal payments — you pay the same amount every month. Early on most of it is interest; over time more goes to principal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuota constante: pagas lo mismo cada mes. Al principio pesan más los intereses y con el tiempo, el principal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuiteetti — maksat joka kuukausi saman summan. Alussa koron osuus on suuri, myöhemmin pääoman osuus kasvaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mensualités constantes — vous payez le même montant chaque mois. Au début, les intérêts pèsent lourd, puis la part du capital augmente."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cicilan tetap — bayar jumlah yang sama tiap bulan. Awalnya porsi bunga besar, lalu porsi pokok makin besar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rata costante: paghi ogni mese lo stesso importo. All’inizio pesano di più gli interessi, poi il capitale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元利均等 — 毎月同じ額を払います。最初は利息の割合が大きく、だんだん元本の割合が大きくなります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuitetslån – du betaler samme beløp hver måned. I starten er renteandelen stor, og etter hvert vokser avdragsandelen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuïteit: je betaalt elke maand hetzelfde. In het begin is het rentedeel groot, later groeit het aflossingsdeel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raty równe — co miesiąc płacisz tyle samo. Na początku większą część stanowią odsetki, z czasem rośnie udział kapitału."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parcelas iguais (Price) — você paga o mesmo valor todo mês. No início pesa mais o juro; com o tempo, o principal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аннуитет — каждый месяц одинаковый платёж. Сначала больше доля процентов, со временем растёт доля основного долга."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuitet – du betalar samma belopp varje månad. I början är räntedelen stor, sedan växer amorteringsdelen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ผ่อนเท่ากันทุกงวด — จ่ายเท่ากันทุกเดือน ช่วงแรกสัดส่วนดอกเบี้ยสูง แล้วสัดส่วนเงินต้นจะค่อยๆ มากขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eşit taksit — her ay aynı tutarı ödersiniz. Başta faizin payı büyüktür, zamanla anaparanın payı artar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trả đều gốc và lãi — mỗi tháng trả cùng một số tiền. Ban đầu phần lãi lớn, càng về sau phần gốc càng lớn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等额本息 — 每月还款金额相同。前期利息占比大，越往后本金占比越大。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本息平均攤還 — 每月繳相同金額。前期利息占比大，越往後本金占比越大。"
          }
        }
      }
    },
