    "홈 화면에서 퇴사까지 남은 시간을 바로 봐요." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na ploše hned uvidíte, za jak dlouho můžete skončit."
