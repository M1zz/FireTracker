          "stringUnit" : {
            "state" : "translated",
            "value" : "Angiv det, der faktisk kommer ind på kontoen, ikke lønnen før skat, så bliver timelønnen ærlig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib nicht das Brutto-, sondern das tatsächlich ausgezahlte Gehalt ein, damit dein Stundenlohn ehrlich ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γράψτε τι μπαίνει πραγματικά στον λογαριασμό, όχι το μικτό, για να είναι ειλικρινές το ωρομίσθιο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use what actually lands in your account, not pre-tax pay, for an honest hourly wage."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use what actually lands in your account, not pre-tax pay, for an honest hourly wage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para que el valor por hora sea honesto, pon lo que de verdad entra en tu cuenta, no el bruto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syötä summa, joka oikeasti tulee tilillesi, ei bruttopalkkaa, niin tuntipalkka on rehellinen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez le montant qui arrive vraiment sur votre compte, pas le brut, pour un taux horaire honnête."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isi jumlah yang benar-benar masuk ke rekening, bukan sebelum pajak, agar upah per jam jujur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci quanto ti arriva davvero sul conto, non il lordo: così la paga oraria è onesta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "税引前ではなく、実際に口座に入る金額で入力すると、時給が正確になります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg inn det som faktisk kommer inn på kontoen, ikke lønn før skatt, så blir timelønnen ærlig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vul niet je brutoloon in maar wat er echt op je rekening komt, dan klopt je uurloon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz kwotę, która faktycznie trafia na konto, a nie brutto — wtedy stawka będzie uczciwa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o valor que cai na conta, não o bruto, para o valor da hora ser honesto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Указывайте сумму, которая реально приходит на счёт, а не до налогов, — тогда ставка будет честной."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ange det som faktiskt kommer in på kontot, inte lönen före skatt, så blir timlönen ärlig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กรอกเป็นเงินที่เข้าบัญชีจริง ไม่ใช่ก่อนหักภาษี ค่าแรงต่อชั่วโมงจึงจะตรงความจริง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saatlik ücretin dürüst olması için brüt değil, hesabınıza gerçekten yatan tutarı girin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy nhập số tiền thực vào tài khoản, không phải trước thuế, để lương giờ trung thực."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要填实际到账的金额而不是税前，时薪才真实。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要填實際入帳的金額而不是稅前，時薪才真實。"
          }
        }
      }
    },
