    "질문 네 개면 내 퇴사일이 나와요.\n자산은 그다음에 하나씩 적어도 돼요." : {
      "comment" : "A description of the onboarding process for onboarding new users.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Four questions and your quit date appears.\nYou can add assets one by one afterward."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Four questions and your quit date appears.\nYou can add assets one by one afterward."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "質問4つで自分の退職日が出ます。\n資産はそのあと1つずつ入力しても大丈夫です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "四个问题就能算出我的辞职日。\n资产可以之后再一项一项填。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "四個問題就能算出我的離職日。\n資產可以之後再一項一項填。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con cuatro preguntas sale tu fecha de salida.\nLos activos puedes añadirlos uno a uno después."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vier Fragen, und dein Ausstiegsdatum steht.\nDas Vermögen kannst du danach nach und nach eintragen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quatre questions et votre date de départ s’affiche.\nVous ajouterez les actifs un par un ensuite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quattro domande e compare la tua data di uscita.\nIl patrimonio puoi aggiungerlo dopo, una voce alla volta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quatro perguntas e sua data de saída aparece.\nOs ativos você pode cadastrar depois, um a um."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Четыре вопроса — и появится дата вашего ухода.\nАктивы можно добавить потом по одному."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตอบสี่ข้อ ก็ได้วันออกจากงานของคุณ\nสินทรัพย์ค่อยเพิ่มทีละรายการทีหลังได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bốn câu hỏi là ra ngày nghỉ việc của bạn.\nTài sản có thể thêm từng cái sau."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čtyři otázky a objeví se datum vašeho odchodu.\nMajetek můžete doplnit potom po jednom."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fire spørgsmål, så har du din stopdato.\nAktiver kan du tilføje ét ad gangen bagefter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τέσσερις ερωτήσεις και βγαίνει η ημερομηνία αποχώρησής σας.\nΤα περιουσιακά στοιχεία μπορείτε να τα προσθέσετε μετά ένα ένα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
