        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acompanhe os ativos que você tem em uma lista:\nações, cripto, imóveis, jeonse, dinheiro e mais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ведите список своих активов —\nакции, крипта, недвижимость, чонсе, наличные и другое."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Följ de tillgångar du har som en lista –\naktier, krypto, fastigheter, jeonse, kontanter och mer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ติดตามสินทรัพย์ที่ถือเป็นรายการ —\nหุ้น คริปโต อสังหาริมทรัพย์ ช็อนเซ เงินสด และอื่นๆ"
