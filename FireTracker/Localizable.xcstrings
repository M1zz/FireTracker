    "빈 칸을 누르면 그 종류의 자산을 바로 추가할 수 있어요." : {
      "comment" : "A description of the benefits of adding a new asset.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepnutím na prázdné pole hned přidáte majetek tohoto druhu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på en tom plads for straks at tilføje den slags aktiv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf einen leeren Platz, um sofort diese Art von Vermögen hinzuzufügen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε σε μια κενή θέση για να προσθέσετε αμέσως αυτό το είδος περιουσιακού στοιχείου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap an empty slot to add that type of asset right away."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap an empty slot to add that type of asset right away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un hueco vacío para añadir enseguida ese tipo de activo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta tyhjää paikkaa lisätäksesi heti tämän tyyppisen varan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
