          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser når du kan slutte i nåværende tempo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat zien wanneer je in het huidige tempo kunt stoppen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje, kiedy możesz skończyć przy obecnym tempie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra quando você pode parar no ritmo atual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
