            "state" : "translated",
            "value" : "Se rellenará la calculadora de %2$@ con las condiciones de «%1$@». Los valores actuales se perderán."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Täyttää %2$@-laskurin kohteen ”%1$@” ehdoilla. Nykyiset arvot katoavat."
