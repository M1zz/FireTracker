    "번 시급과 산 시급이 같아요. 밀도는 올랐지만 시간이 자리만 옮겼을 뿐, 늘지는 않았어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše sazba je stejná jako sazba koupeného času. Hustota vzrostla, ale čas se jen přesunul, nepřibyl."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optjent og købt timeløn er ens. Tætheden steg, men tiden blev bare flyttet – der kom ikke mere af den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verdienter und gekaufter Stundenlohn sind gleich. Die Dichte ist gestiegen, aber die Zeit hat nur den Platz getauscht, nicht zugenommen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ωρομίσθιό σας και το αγορασμένο είναι ίδια. Η πυκνότητα ανέβηκε, αλλά ο χρόνος απλώς άλλαξε θέση, δεν αυξήθηκε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your earned and bought rates are the same. Density went up, but time only moved around; it didn't grow."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your earned and bought rates are the same. Density went up, but time only moved around; it didn't grow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu valor por hora ganado y el comprado son iguales. La densidad sube, pero el tiempo solo cambia de sitio; no aumenta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ansaittu ja ostettu tuntihinta ovat samat. Tiheys kasvoi, mutta aika vain vaihtoi paikkaa eikä lisääntynyt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
