          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この数字は正解ではなく、方向を決める錨です。毎日追いかける必要はありません。方向さえ合っていれば、あとは今週1歩ずつで十分です。"
          }
        },
        "zh-Hans" : {
