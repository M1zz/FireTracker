    "연금·자동차·비상금·코인·보험·전세보증금 등 빠뜨린 자산이 있다면 추가해보세요." : {
      "comment" : "A description of the benefits of adding other assets.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you've missed assets like a pension, car, emergency fund, crypto, insurance or a jeonse deposit, add them."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you've missed assets like a pension, car, emergency fund, crypto, insurance or a jeonse deposit, add them."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "年金・車・生活防衛資金・暗号資産・保険・全貸保証金など、抜けている資産があれば追加してみてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果漏了养老金、汽车、应急金、加密货币、保险、全租押金等资产，请补充添加。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果漏了養老金、汽車、應急金、加密貨幣、保險、全租押金等資產，請補充新增。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si se te ha pasado algún activo, como pensión, coche, fondo de emergencia, criptomonedas, seguros o una fianza jeonse, añádelo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falls du Vermögen wie Rente, Auto, Notgroschen, Krypto, Versicherung oder eine Jeonse-Kaution vergessen hast, füge es hinzu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous avez oublié des actifs comme une retraite, une voiture, un fonds d’urgence, des cryptos, une assurance ou une caution jeonse, ajoutez-les."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se hai dimenticato attività come pensione, auto, fondo di emergenza, cripto, assicurazione o cauzione jeonse, aggiungile."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se faltou algum ativo, como previdência, carro, reserva de emergência, cripto, seguro ou caução jeonse, adicione."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вы пропустили активы вроде пенсии, машины, подушки безопасности, крипты, страховки или залога чонсе, добавьте их."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้าตกหล่นสินทรัพย์อย่างบำนาญ รถ เงินสำรองฉุกเฉิน คริปโต ประกัน หรือเงินมัดจำช็อนเซ ลองเพิ่มเข้าไป"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bỏ sót tài sản như lương hưu, xe, quỹ khẩn cấp, tiền mã hóa, bảo hiểm hay tiền đặt cọc jeonse, hãy thêm vào."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud jste vynechali majetek jako důchod, auto, rezervu, krypto, pojištění nebo jeonse kauci, přidejte ho."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du har glemt aktiver som pension, bil, nødopsparing, krypto, forsikring eller et jeonse-depositum, så tilføj dem."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν παραλείψατε περιουσιακά στοιχεία όπως σύνταξη, αυτοκίνητο, αποθεματικό έκτακτης ανάγκης, κρυπτονομίσματα, ασφάλεια ή εγγύηση jeonse, προσθέστε τα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos olet unohtanut varoja kuten eläkkeen, auton, puskurirahaston, kryptoja, vakuutuksen tai jeonse-vakuuden, lisää ne."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika ada aset yang terlewat, seperti pensiun, mobil, dana darurat, kripto, asuransi, atau deposit jeonse, tambahkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du har glemt eiendeler som pensjon, bil, buffer, krypto, forsikring eller et jeonse-depositum, legg dem til."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heb je bezittingen gemist zoals pensioen, auto, noodfonds, crypto, verzekering of een jeonse-borg, voeg ze dan toe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli pominąłeś aktywa takie jak emerytura, samochód, fundusz awaryjny, krypto, ubezpieczenie czy kaucja jeonse, dodaj je."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har du missat tillgångar som pension, bil, buffert, krypto, försäkring eller en jeonse-deposition, lägg till dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emeklilik, araç, acil durum fonu, kripto, sigorta veya jeonse depozitosu gibi atladığınız varlıklar varsa ekleyin."
          }
        }
      }
    },
