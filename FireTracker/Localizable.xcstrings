    "데모 데이터로 전환했어요. 자산·추이·계산 탭을 확인해보세요. 토글을 끄면 내 데이터가 그대로 돌아옵니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přepnuto na ukázková data. Podívejte se na karty Majetek, Vývoj a Počítat. Po vypnutí přepínače se vaše data vrátí beze změny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skiftede til demodata. Se fanerne Aktiver, Udvikling og Beregn. Slå kontakten fra, så kommer dine egne data tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf Demodaten umgestellt. Sieh dir die Tabs Vermögen, Verlauf und Rechnen an. Schaltest du den Schalter aus, sind deine Daten unverändert zurück."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μεταβήκατε σε δεδομένα επίδειξης. Δείτε τις καρτέλες Περιουσία, Πορεία και Υπολογισμός. Απενεργοποιήστε τον διακόπτη και τα δικά σας δεδομένα επιστρέφουν όπως ήταν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switched to demo data. Take a look at the Assets, Trends and Calculate tabs. Turn the toggle off and your own data comes back as it was."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switched to demo data. Take a look at the Assets, Trends and Calculate tabs. Turn the toggle off and your own data comes back as it was."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora ves datos de demostración. Echa un vistazo a las pestañas Activos, Tendencia y Calcular. Al desactivarlo, vuelven tus datos tal cual."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaihdettu demotietoihin. Katso Varat-, Kehitys- ja Laske-välilehtiä. Kun kytket valinnan pois, omat tietosi palaavat ennallaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Données de démo activées. Jetez un œil aux onglets Actifs, Évolution et Calculer. Désactivez l’option pour retrouver vos données intactes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beralih ke data demo. Coba lihat tab Aset, Tren, dan Hitung. Matikan sakelar untuk mengembalikan data Anda apa adanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei passato ai dati demo. Guarda le schede Patrimonio, Andamento e Calcola. Disattivando l’interruttore tornano i tuoi dati così com’erano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デモデータに切り替えました。資産・推移・計算タブを見てみましょう。オフにすると自分のデータがそのまま戻ります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byttet til demodata. Se fanene Eiendeler, Utvikling og Beregn. Slå av bryteren, så kommer dine egne data tilbake."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overgeschakeld naar demogegevens. Bekijk de tabbladen Bezittingen, Verloop en Berekenen. Zet de schakelaar uit en je eigen gegevens zijn terug."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włączono dane demonstracyjne. Zajrzyj na karty Aktywa, Trend i Oblicz. Wyłącz przełącznik, a twoje dane wrócą bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está nos dados de demonstração. Confira as abas Ativos, Tendência e Calcular. Desative a chave para voltar aos seus dados, intactos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включены демо-данные. Загляните на вкладки «Активы», «Динамика» и «Расчёты». Выключите переключатель — и ваши данные вернутся без изменений."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bytte till demodata. Titta på flikarna Tillgångar, Utveckling och Beräkna. Slå av reglaget så kommer dina egna data tillbaka."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปลี่ยนเป็นข้อมูลตัวอย่างแล้ว ลองดูแท็บสินทรัพย์ แนวโน้ม และคำนวณ ปิดสวิตช์แล้วข้อมูลของคุณจะกลับมาเหมือนเดิม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demo verilerine geçildi. Varlıklar, seyir ve hesap sekmelerine göz atın. Anahtarı kapatınca kendi verileriniz aynen geri gelir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã chuyển sang dữ liệu mẫu. Hãy xem các tab Tài sản, Diễn biến và Tính. Tắt công tắc để dữ liệu của bạn trở lại nguyên vẹn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已切换到演示数据。去看看资产、走势和计算页吧。关闭开关后，你的数据会原样回来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已切換為演示資料。去看看資產、走勢和計算頁吧。關閉開關後，你的資料會原封不動回來。"
          }
        }
      }
    },
