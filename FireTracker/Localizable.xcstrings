    "기록을 저장할수록 이번 달 안의 변화가 촘촘하게 그려져요." : {
      "comment" : "A description of the trend view's disclaimer.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čím víc záznamů uložíte, tím podrobněji se vykreslí změny v tomto měsíci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jo flere registreringer du gemmer, jo mere detaljeret tegnes ændringerne inden for denne måned."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je mehr Einträge du speicherst, desto feiner zeichnen sich die Veränderungen in diesem Monat ab."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όσο περισσότερες καταγραφές αποθηκεύετε, τόσο πιο αναλυτικά σχεδιάζονται οι αλλαγές μέσα σε αυτόν τον μήνα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The more records you save, the more detail you'll see in this month's changes."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The more records you save, the more detail you'll see in this month's changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuantos más registros guardes, más detallados se dibujan los cambios dentro de este mes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitä enemmän merkintöjä tallennat, sitä tarkemmin tämän kuukauden muutokset piirtyvät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus vous enregistrez, plus les variations de ce mois sont dessinées finement."
