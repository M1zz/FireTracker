          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點旅程頁頂部的時鐘圖示（記錄），可以修改或刪除這條記錄。異常的點也可以在那裡修正。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el icono del reloj (Registros) en la parte superior de la pestaña Trayecto para editar o eliminar este registro. También puedes corregir ahí un punto raro."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
