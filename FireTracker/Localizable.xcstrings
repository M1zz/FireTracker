    "반전세입니다. 보증금(현금) + 월세(현금흐름) 둘 다 입력하세요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Částečné jeonse. Zadejte kauci (hotovost) i nájem (peněžní tok)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delvis jeonse. Angiv både depositum (kontanter) og månedlig husleje (pengestrøm)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teil-Jeonse. Gib Kaution (Bargeld) und Monatsmiete (Cashflow) ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μερικό jeonse. Βάλτε και την εγγύηση (μετρητά) και το ενοίκιο (ταμειακή ροή)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Part-jeonse. Enter both the deposit (cash) and the monthly rent (cash flow)."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Part-jeonse. Enter both the deposit (cash) and the monthly rent (cash flow)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es un jeonse parcial. Introduce la fianza (efectivo) y el alquiler mensual (flujo de caja)."
          }
        },
        "fi" : {
          "stringUnit" : {
