    "산 시급 %@ · 내 시급보다 %@" : {
      "comment" : "A line that compares the calculated hourly wage (`buys[idx].boughtWage`) with the user's hourly wage (`earnWage`). The argument is the string “0원” or the string “%arg원”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
