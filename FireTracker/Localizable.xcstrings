    "지금 바로 현금화해 쓸 수 있는 자산(현금·주식·코인 등)이에요. 실거주 부동산·전세보증금·연금처럼 묶인 돈과 부채는 빠집니다." : {
      "comment" : "A description of the liquidity of the user's assets.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assets you can turn into cash and spend right now (cash, stocks, crypto, etc.). Locked-up money like a home you live in, jeonse deposits and pensions, and debt, are left out."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assets you can turn into cash and spend right now (cash, stocks, crypto, etc.). Locked-up money like a home you live in, jeonse deposits and pensions, and debt, are left out."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今すぐ現金化して使える資産（現金・株式・暗号資産など）です。自宅・全貸保証金・年金のように拘束されたお金と負債は含まれません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以立刻变现使用的资产（现金、股票、加密货币等）。自住房产、全租押金、养老金这类被占用的钱以及负债不计入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以立刻變現使用的資產（現金、股票、加密貨幣等）。自住房產、全租押金、養老金這類被佔用的錢以及負債不計入。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activos que puedes convertir en efectivo y gastar ahora mismo (efectivo, acciones, criptomonedas, etc.). Se dejan fuera el dinero inmovilizado, como la vivienda habitual, las fianzas jeonse y las pensiones, y la deuda."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vermögen, das du sofort zu Geld machen und ausgeben kannst (Bargeld, Aktien, Krypto usw.). Gebundenes Geld wie selbst bewohnte Immobilien, Jeonse-Kautionen und Renten sowie Schulden bleiben außen vor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actifs que vous pouvez convertir en liquidités et dépenser tout de suite (liquidités, actions, cryptos, etc.). Les sommes immobilisées comme la résidence principale, les cautions jeonse et les retraites, ainsi que la dette, sont exclues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attività che puoi convertire subito in contanti e spendere (contanti, azioni, cripto, ecc.). Restano fuori il denaro vincolato come la casa in cui abiti, le cauzioni jeonse e le pensioni, e i debiti."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativos que você pode converter em dinheiro e gastar agora (dinheiro, ações, cripto etc.). Ficam de fora o dinheiro preso, como o imóvel onde mora, as cauções jeonse e a previdência, e as dívidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Активы, которые можно сразу обратить в наличные и потратить (наличные, акции, криптовалюта и т. д.). Замороженные деньги — жильё, залоги чонсе, пенсии — и долги не учитываются."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สินทรัพย์ที่เปลี่ยนเป็นเงินสดแล้วใช้ได้ทันที (เงินสด หุ้น คริปโต ฯลฯ) ไม่รวมเงินที่ผูกไว้ เช่น บ้านที่อยู่เอง เงินมัดจำช็อนเซ บำนาญ และหนี้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tài sản có thể đổi ngay thành tiền mặt để chi (tiền mặt, cổ phiếu, tiền mã hóa, v.v.). Không tính tiền bị khóa như nhà đang ở, tiền đặt cọc jeonse, hưu trí và các khoản nợ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Majetek, který můžete hned proměnit v hotovost a utratit (hotovost, akcie, krypto apod.). Vázané peníze jako vlastní bydlení, jeonse kauce a důchody i dluhy se nezapočítávají."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiver, du kan omsætte til kontanter og bruge med det samme (kontanter, aktier, krypto m.m.). Bundne penge som din egen bolig, jeonse-depositummer og pensioner samt gæld er udeladt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Περιουσιακά στοιχεία που μπορείτε να μετατρέψετε αμέσως σε μετρητά και να ξοδέψετε (μετρητά, μετοχές, κρυπτονομίσματα κ.λπ.). Εξαιρούνται δεσμευμένα χρήματα όπως το σπίτι που κατοικείτε, οι εγγυήσεις jeonse και οι συντάξεις, καθώς και τα χρέη."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varat, jotka voit muuttaa heti käteiseksi ja käyttää (käteinen, osakkeet, kryptot jne.). Sidottu raha kuten asuinkoti, jeonse-vakuudet ja eläkkeet sekä velka jätetään pois."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aset yang bisa langsung diuangkan dan dibelanjakan (tunai, saham, kripto, dll.). Uang terikat seperti rumah tinggal, deposit jeonse, dan pensiun, serta utang, tidak dihitung."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eiendeler du kan gjøre om til kontanter og bruke med en gang (kontanter, aksjer, krypto osv.). Bundne penger som egen bolig, jeonse-depositum og pensjoner, samt gjeld, er utelatt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezittingen die je meteen kunt verzilveren en uitgeven (contant geld, aandelen, crypto enz.). Vastgezet geld zoals een eigen woning, jeonse-borgsommen en pensioenen, en schuld, blijven buiten beschouwing."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktywa, które możesz od razu zamienić na gotówkę i wydać (gotówka, akcje, krypto itp.). Zablokowane pieniądze, jak własne mieszkanie, kaucje jeonse i emerytury, oraz długi nie są uwzględniane."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillgångar du kan göra om till kontanter och spendera direkt (kontanter, aktier, krypto m.m.). Bundna pengar som egen bostad, jeonse-depositioner och pensioner, samt skulder, är undantagna."
          }
        }
      }
