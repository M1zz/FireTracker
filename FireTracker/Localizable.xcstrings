    "지금 월급 %@은 %@년 월급을 오늘 물가로 옮긴 %@보다 %@ 많아요." : {
      "comment" : "A text that compares the real wage (what you can buy with your salary) from a past year to the current year. If the result is positive, it means that your salary has increased. If the result is negative, it means that your salary has decreased.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše současná mzda %1$@ je o %4$@ vyšší než mzda z roku %2$@ přepočtená na dnešní ceny (%3$@)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din nuværende løn %1$@ er %4$@ højere end lønnen fra %2$@ i dagens priser (%3$@)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein jetziges Gehalt %1$@ liegt %4$@ über dem Gehalt von %2$@ in heutigen Preisen (%3$@)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο τρέχων μισθός σας %1$@ είναι κατά %4$@ υψηλότερος από τον μισθό του %2$@ σε σημερινές τιμές (%3$@)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your salary now, %1$@, is %4$@ more than your %2$@ salary in today's prices (%3$@)."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your salary now, %1$@, is %4$@ more than your %2$@ salary in today's prices (%3$@)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu sueldo actual, %1$@, es un %4$@ superior al de %2$@ a precios de hoy (%3$@)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nykyinen palkkasi %1$@ on %4$@ suurempi kuin vuoden %2$@ palkka tämän päivän hinnoin (%3$@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre salaire actuel, %1$@, est supérieur de %4$@ à celui de %2$@ aux prix d’aujourd’hui (%3$@)."
          }
        },
        "id" : {
          "stringUnit" : {
