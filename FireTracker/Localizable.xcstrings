    "지금 속도면 언제 그만둘 수 있는지 보여 줘요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows when you could quit at your current pace."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows when you could quit at your current pace."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今のペースで、いつ辞められるかを表示します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按现在的速度，显示你什么时候可以辞职。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依現在的速度，顯示你什麼時候可以離職。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra cuándo podrás dejarlo al ritmo actual."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt, wann du beim aktuellen Tempo aufhören kannst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique quand vous pourrez arrêter à votre rythme actuel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra quando potrai smettere al ritmo attuale."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra quando você pode parar no ritmo atual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает, когда можно уйти при нынешнем темпе."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงว่าด้วยจังหวะตอนนี้ คุณจะลาออกได้เมื่อไร"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho biết với tốc độ hiện tại khi nào bạn có thể nghỉ việc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukazuje, kdy můžete skončit při současném tempu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser, hvornår du kan stoppe i dit nuværende tempo."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δείχνει πότε μπορείτε να σταματήσετε με τον τωρινό ρυθμό."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttää, milloin voit lopettaa nykyisellä tahdilla."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menunjukkan kapan Anda bisa berhenti dengan laju sekarang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser når du kan slutte i nåværende tempo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat zien wanneer je in het huidige tempo kunt stoppen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
