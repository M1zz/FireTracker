            "value" : "Delvis jeonse. Legg inn både depositum (kontanter) og månedlig leie (kontantstrøm)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deels jeonse. Vul zowel de borg (contant) als de maandhuur (kasstroom) in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
