          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeonse parziale: inserisci sia la cauzione (contanti) sia l’affitto mensile (flusso di cassa)."
          }
        },
        "ja" : {
          "stringUnit" : {
