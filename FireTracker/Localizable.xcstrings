        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đây chỉ là tổng thu nhập đã dự kiến. Không giả định cổ phiếu, bất động sản hay tài sản khác sẽ tăng giá trị."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
