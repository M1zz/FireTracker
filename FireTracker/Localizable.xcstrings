            "value" : "關閉時以「6億韓元」這樣的億、萬為單位顯示；開啟時只顯示「600,000,000韓元」這樣的數字。適用於整個App。"
          }
        }
      }
    },
    "끄면 원래 내 데이터로 그대로 돌아가요." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po vypnutí se vrátíte ke svým vlastním datům beze změny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slår du det fra, vender du tilbage til dine egne data, præcis som de var."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Ausschalten kehrst du unverändert zu deinen eigenen Daten zurück."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν το απενεργοποιήσετε, επιστρέφετε στα δικά σας δεδομένα όπως ήταν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn off to return to your own data."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn this off to go back to your own data, just as it was."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al desactivarlo, vuelves a tus propios datos tal como estaban."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun poistat tämän käytöstä, palaat omiin tietoihisi sellaisinaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En désactivant, vous retrouvez vos propres données telles quelles."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matikan untuk kembali ke data Anda sendiri seperti semula."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivando torni ai tuoi dati, esattamente com’erano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにすると、元の自分のデータにそのまま戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끄면 원래 내 데이터로 그대로 돌아가요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slår du det av, går du tilbake til dine egne data akkurat som de var."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet je dit uit, dan ga je terug naar je eigen gegevens zoals ze waren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po wyłączeniu wrócisz do swoich danych dokładnie w takiej postaci, jak były."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao desativar, você volta aos seus próprios dados, do jeito que estavam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если выключить, вернутся ваши собственные данные в прежнем виде."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stänger du av återgår du till dina egna data precis som de var."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อปิด ข้อมูลของคุณจะกลับมาเหมือนเดิม"
          }
        },
        "tr" : {
          "stringUnit" : {
