    "지금 시급의 %@배예요. 지금 1시간의 진짜 가격은 오늘 시급이 아니라, 그 시간이 올려 줄 미래 시급이에요." : {
      "comment" : "A comparison of the real value of a current hour of work with the value of that hour of work in the future, based on the current hourly wage and the future hourly wage. The argument is the string “%.1f”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That's %@ times your current wage. The real price of an hour now isn't today's wage, but the future wage that hour will raise."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That's %@ times your current wage. The real price of an hour now isn't today's wage, but the future wage that hour will raise."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今の時給の%@倍です。今の1時間の本当の値段は、今日の時給ではなく、その時間が引き上げてくれる将来の時給です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是现在时薪的%@倍。现在这1小时的真正价格，不是今天的时薪，而是这段时间能抬高的未来时薪。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是現在時薪的%@倍。現在這1小時的真正價格，不是今天的時薪，而是這段時間能抬高的未來時薪。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son %@ veces tu sueldo actual. El precio real de una hora ahora no es el sueldo de hoy, sino el sueldo futuro que esa hora hará subir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist das %@-Fache deines jetzigen Lohns. Der wahre Preis einer Stunde jetzt ist nicht der heutige Lohn, sondern der künftige Lohn, den diese Stunde anhebt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est %@ fois votre salaire actuel. Le vrai prix d’une heure maintenant n’est pas le salaire d’aujourd’hui, mais le salaire futur que cette heure fera monter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È %@ volte la tua paga attuale. Il vero prezzo di un’ora adesso non è la paga di oggi ma la paga futura che quell’ora farà salire."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equivale a %@× o seu valor-hora atual. O preço real de uma hora agora não é o valor-hora de hoje, e sim o valor-hora futuro que essa hora vai elevar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это в %@ раз больше вашей нынешней ставки. Реальная цена часа сейчас — не сегодняшняя ставка, а будущая ставка, которую этот час поднимет."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เป็น %@ เท่าของค่าแรงตอนนี้ ราคาแท้จริงของหนึ่งชั่วโมงตอนนี้ไม่ใช่ค่าแรงวันนี้ แต่เป็นค่าแรงในอนาคตที่ชั่วโมงนั้นจะยกระดับขึ้น"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gấp %@ lần lương giờ hiện tại. Giá thực của một giờ bây giờ không phải lương giờ hôm nay mà là lương giờ tương lai mà giờ đó sẽ nâng lên."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je to %@násobek vaší současné sazby. Skutečná cena hodiny teď není dnešní sazba, ale budoucí sazba, kterou tato hodina zvedne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er %@ gange din nuværende løn. Prisen på en time nu er ikke dagens løn, men den fremtidige løn, som den time vil løfte."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Είναι %@ φορές το τρέχον ωρομίσθιό σας. Η πραγματική τιμή μιας ώρας τώρα δεν είναι το σημερινό ωρομίσθιο, αλλά το μελλοντικό ωρομίσθιο που θα ανεβάσει αυτή η ώρα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se on %@-kertainen nykyiseen tuntipalkkaasi. Tunnin todellinen hinta nyt ei ole tämän päivän tuntipalkka vaan tuleva tuntipalkka, jota tämä tunti nostaa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itu %@ kali upah per jam Anda sekarang. Harga sebenarnya satu jam sekarang bukan upah hari ini, melainkan upah masa depan yang akan dinaikkan jam itu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er %@ ganger dagens timelønn. Prisen på en time nå er ikke dagens timelønn, men den fremtidige timelønnen den timen vil løfte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dat is %@ keer je huidige uurloon. De echte prijs van een uur nu is niet het uurloon van vandaag, maar het toekomstige uurloon dat dat uur omhoog brengt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To %@ razy twoja obecna stawka. Prawdziwa cena godziny teraz to nie dzisiejsza stawka, lecz przyszła stawka, którą ta godzina podniesie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det är %@ gånger din nuvarande timlön. Det verkliga priset på en timme nu är inte dagens timlön utan den framtida timlön den timmen lyfter."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şu anki saatlik ücretinizin %@ katı. Şimdi 1 saatin gerçek fiyatı bugünkü ücret değil, o saatin yükselteceği gelecekteki ücrettir."
          }
        }
      }
    },
    "지금 월 생활비에서 ‘남들이 사니까 산 것’을 한번 빼보세요. 진짜 나를 만족시키는 금액은 생각보다 적을지도 몰라요." : {
      "comment" : "A message for the Vanity Mirror Tip.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try removing what you bought ‘because others did’ from your monthly living costs. What truly satisfies you may be less than you think."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try removing what you bought ‘because others did’ from your monthly living costs. What truly satisfies you may be less than you think."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今の月の生活費から「みんなが買うから買ったもの」を一度引いてみてください。本当の自分を満たす金額は、思ったより少ないかもしれません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "试着从现在的月生活费中去掉“别人买所以我也买”的东西。真正让你满足的金额，也许比想象中少。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "試著從現在的月生活費中去掉「別人買所以我也買」的東西。真正讓你滿足的金額，也許比想象中少。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba a quitar de tus gastos de vida mensuales lo que compraste «porque los demás lo hacían». Lo que de verdad te satisface puede ser menos de lo que crees."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm aus deinen monatlichen Lebenskosten heraus, was du „gekauft hast, weil andere es kaufen“. Was dich wirklich zufriedenstellt, ist vielleicht weniger, als du denkst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retirez de vos frais de vie mensuels ce que vous avez acheté « parce que les autres l’achetaient ». Ce qui vous satisfait vraiment est peut-être moins que vous ne le pensez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova a togliere dalle spese di vita mensili ciò che hai comprato «perché lo comprano gli altri». Ciò che ti soddisfa davvero potrebbe essere meno di quanto pensi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tente tirar do seu custo de vida mensal o que você comprou “porque os outros compram”. O que realmente te satisfaz pode ser menos do que você pensa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попробуйте убрать из месячных расходов на жизнь то, что вы купили «потому что покупают другие». Что вас действительно удовлетворяет, может стоить меньше, чем кажется."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลองตัดสิ่งที่ซื้อ “เพราะคนอื่นซื้อ” ออกจากค่าครองชีพรายเดือน สิ่งที่ทำให้คุณพอใจจริงๆ อาจน้อยกว่าที่คิด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy thử bớt khỏi sinh hoạt phí hằng tháng những thứ bạn mua “vì người khác mua”. Số tiền thật sự làm bạn hài lòng có thể ít hơn bạn nghĩ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkuste z měsíčních životních nákladů odečíst to, co jste koupili „protože to kupují ostatní“. To, co vás opravdu uspokojí, může být méně, než si myslíte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøv at trække det, du købte, „fordi andre købte det“, fra dine månedlige leveomkostninger. Det, der virkelig tilfredsstiller dig, er måske mindre, end du tror."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δοκιμάστε να αφαιρέσετε από το μηνιαίο κόστος ζωής ό,τι αγοράσατε «επειδή το αγοράζουν οι άλλοι». Αυτό που σας ικανοποιεί πραγματικά ίσως είναι λιγότερο απ’ όσο νομίζετε."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kokeile vähentää kuukausittaisista elinkustannuksistasi se, minkä ostit ”koska muutkin ostavat”. Se, mikä todella tyydyttää sinua, voi olla vähemmän kuin luulet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coba keluarkan dari biaya hidup bulanan apa yang Anda beli “karena orang lain membelinya”. Yang benar-benar memuaskan Anda mungkin lebih sedikit dari dugaan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøv å trekke fra det du kjøpte «fordi andre kjøper det» i de månedlige levekostnadene dine. Det som virkelig tilfredsstiller deg, er kanskje mindre enn du tror."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probeer uit je maandelijkse leefkosten te halen wat je kocht ‘omdat anderen het kopen’. Wat jou echt tevredenstelt, is misschien minder dan je denkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spróbuj odjąć od miesięcznych kosztów życia to, co kupiłeś „bo inni kupują”. To, co naprawdę cię zadowala, może być mniejsze, niż myślisz."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova att dra av det du köpte ”för att andra köper det” från dina månatliga levnadskostnader. Det som verkligen tillfredsställer dig är kanske mindre än du tror."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aylık geçim giderinizden “başkaları aldığı için aldığınız” şeyleri çıkarmayı deneyin. Sizi gerçekten tatmin eden tutar düşündüğünüzden az olabilir."
          }
        }
      }
    },
