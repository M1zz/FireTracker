    "필요할 때 연금부터 한꺼번에 꺼내는 것보다 세금이 %@원 줄어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saves %@ won in tax versus drawing your pension all at once."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필요할 때 연금부터 한꺼번에 꺼내는 것보다 세금이 %@원 줄어요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saves %@ won in tax versus drawing your pension all at once."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "年金を一度に取り崩すより、税金が%@ウォン少なくなります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
