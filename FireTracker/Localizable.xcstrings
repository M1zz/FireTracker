          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capitale costante"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元金均等"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serielån"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lineair"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raty malejące"
          }
        },
        "pt-BR" : {
