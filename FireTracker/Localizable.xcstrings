    "자산이 버는 시급이 내 한계 시급을 넘었어요. 시간을 팔지 않아도 되는 구간이에요." : {
      "comment" : "A description of the point where your real-world wage (`marginalWage`) is",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What your assets earn per hour has passed your marginal wage. You're in the zone where you don't have to sell your time."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What your assets earn per hour has passed your marginal wage. You're in the zone where you don't have to sell your time."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資産が稼ぐ時給が自分の限界時給を超えました。時間を売らなくてもよい領域です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "资产每小时赚的钱已超过我的边际时薪，进入了不必卖时间的区间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資產每小時賺的錢已超過我的邊際時薪，進入了不必賣時間的區間。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que ganan tus activos por hora ya superó tu sueldo marginal. Estás en la zona en la que no necesitas vender tu tiempo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was dein Vermögen pro Stunde verdient, liegt über deinem Grenzstundenlohn. Du bist in der Zone, in der du keine Zeit verkaufen musst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que vos actifs gagnent par heure dépasse votre salaire marginal. Vous êtes dans la zone où vous n’avez plus à vendre votre temps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto guadagna all’ora il tuo patrimonio ha superato la tua paga marginale. Sei nella zona in cui non devi vendere il tuo tempo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que seus ativos ganham por hora passou o seu valor-hora marginal. Você está na zona em que não precisa vender seu tempo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "То, что активы зарабатывают в час, превысило вашу предельную ставку. Вы в зоне, где не нужно продавать время."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เงินที่สินทรัพย์หาได้ต่อชั่วโมงเกินค่าแรงส่วนเพิ่มของคุณแล้ว คุณอยู่ในช่วงที่ไม่ต้องขายเวลา"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số tiền tài sản kiếm mỗi giờ đã vượt lương giờ biên của bạn. Bạn đang ở vùng không cần bán thời gian."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To, co váš majetek vydělává za hodinu, předstihlo vaši mezní sazbu. Jste v pásmu, kdy nemusíte prodávat čas."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det, dine aktiver tjener i timen, er gået forbi din marginaltimeløn. Du er i zonen, hvor du ikke behøver at sælge tid."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό που κερδίζουν ανά ώρα τα περιουσιακά σας στοιχεία ξεπέρασε το οριακό ωρομίσθιό σας. Βρίσκεστε στη ζώνη όπου δεν χρειάζεται να πουλάτε χρόνο."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitä varasi ansaitsevat tunnissa, on ohittanut rajatuntipalkkasi. Olet vyöhykkeellä, jossa sinun ei tarvitse myydä aikaasi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yang dihasilkan aset Anda per jam telah melampaui upah per jam marginal Anda. Anda berada di zona tak perlu menjual waktu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det eiendelene dine tjener i timen, har gått forbi marginaltimelønnen din. Du er i sonen der du ikke trenger å selge tid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat je bezittingen per uur verdienen, is voorbij je marginale uurloon. Je zit in de zone waarin je geen tijd hoeft te verkopen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To, co aktywa zarabiają na godzinę, przekroczyło twoją krańcową stawkę godzinową. Jesteś w strefie, w której nie musisz sprzedawać czasu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det dina tillgångar tjänar per timme har gått förbi din marginaltimlön. Du är i zonen där du inte behöver sälja tid."
          }
        }
      }
