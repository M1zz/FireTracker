        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der %2$@-Rechner wird mit den Werten von „%1$@“ befüllt. Aktuell eingetragene Werte gehen verloren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συμπληρώνει τον υπολογιστή %2$@ με τις συνθήκες του «%1$@». Οι τρέχουσες τιμές θα χαθούν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fill the %2$@ calculator with the settings from ‘%1$@’? Current values will be replaced."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
