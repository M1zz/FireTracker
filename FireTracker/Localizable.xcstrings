    "종목 코드를 넣고 자동 시세를 켜면 원칙대로 알려 드려요." : {
      "comment" : "A description of the feature that lets you set up and manage your stock and funds.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter the ticker and turn on auto price and we'll alert you by your rule."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter the ticker and turn on auto price and we'll alert you by your rule."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "銘柄コードを入れて自動価格をオンにすると、ルールどおりにお知らせします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "填入股票代码并开启自动行情，就会按规则提醒你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "填入股票程式碼並開啟自動行情，就會按規則提醒你。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce el código y activa el precio automático y te avisaremos según tu regla."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trag das Kürzel ein und schalte den Auto-Kurs ein, dann sagen wir dir nach deiner Regel Bescheid."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez le code et activez le cours automatique, et nous vous alertons selon votre règle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci il codice e attiva il prezzo automatico e ti avvisiamo secondo la tua regola."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informe o código e ligue o preço automático e avisamos conforme a sua regra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
