    "은퇴(%lld세) 후 월 %@원으로 %lld세까지 버틸 수 있어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po odchodu ve věku %lld vám %@ wonů měsíčně vystačí do věku %lld."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efter pensionen som %lld rækker %@ won om måneden, til du er %lld."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruhestand mit %lld: Mit %@ Won pro Monat reicht es bis %lld."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν αποχωρήσετε στα %lld με %@ γουόν τον μήνα, αντέχετε ως τα %lld."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retire at %lld and %@ won a month lasts you to %lld."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retire at %lld and %@ won a month lasts you to %lld."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con %2$@ wones al mes tras jubilarte (a los %1$lld), aguantas hasta los %3$lld años."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eläkkeellä (%1$lld v) %2$@ wonia kuukaudessa riittää %3$lld ikävuoteen asti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec %2$@ wons par mois après votre départ (%1$lld ans), vous tenez jusqu’à %3$lld ans."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah pensiun (usia %1$lld), %2$@ won per bulan cukup sampai usia %3$lld."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andando in pensione a %1$lld anni, con %2$@ won al mese arrivi fino a %3$lld anni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退職（%lld歳）後、月%@ウォンで%lld歳まで持ちこたえられます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etter pensjonering som %lld holder %@ won i måneden til du er %lld."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na het stoppen (op je %lld) kom je met %@ won per maand rond tot je %lld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po odejściu w wieku %lld lat %@ wonów miesięcznie wystarczy do wieku %lld lat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parando aos %1$lld, %2$@ wons por mês duram até os %3$lld anos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После ухода в %lld на %@ вон в месяц хватит до %lld."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efter pensionen vid %lld räcker %@ won i månaden fram till %lld års ålder."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หลังเกษียณ (อายุ %lld ปี) ใช้เดือนละ %@ วอน อยู่ได้ถึงอายุ %lld ปี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emeklilikte (%1$lld yaş) ayda %2$@ won ile %3$lld yaşına kadar idare edebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau khi nghỉ hưu (%lld tuổi), với %@ won mỗi tháng bạn trụ được đến tuổi %lld."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退休（%lld岁）后每月%@韩元，可以撑到%lld岁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退休（%lld歲）後每月%@韓元，可以撐到%lld歲。"
          }
        }
      }
    },
    "은퇴(%lld세) 후 월 %@원을 써도 %lld세에 %@원이 남아요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po odchodu ve věku %lld můžete utrácet %@ wonů měsíčně a ve věku %lld vám ještě zbude %@ wonů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efter pensionen som %lld kan du bruge %@ won om måneden og stadig have tilbage som %lld: %@ won."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruhestand mit %lld: Auch bei %@ Won pro Monat bleiben mit %lld noch %@ Won übrig."
