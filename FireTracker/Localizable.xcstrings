    "여정 탭 ‘내 목표’에 월 저축을 넣으면 예정된 수입으로 올해 말 자산을 예측합니다." : {
      "comment" : "A description of how the projected year-end balance is calculated.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter monthly savings in ‘My Goals’ on the Journey tab and we project year-end assets from your scheduled income."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter monthly savings in ‘My Goals’ on the Journey tab and we project year-end assets from your scheduled income."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ジャーニータブの「マイ目標」に月間貯蓄を入れると、予定された収入で今年末の資産を予測します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在旅程页的“我的目标”中填入月储蓄，就会按预定收入预测今年年底的资产。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在旅程頁的「我的目標」中填入月儲蓄，就會按預定收入預測今年年底的資產。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce el ahorro mensual en «Mis objetivos» de la pestaña Trayecto y proyectamos los activos a final de año con tus ingresos previstos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trag die monatliche Sparrate unter „Meine Ziele“ im Weg-Tab ein, dann schätzen wir dein Vermögen zum Jahresende anhand deiner geplanten Einnahmen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez l’épargne mensuelle dans « Mes objectifs » de l’onglet Parcours et nous projetons vos actifs de fin d’année à partir des revenus prévus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci il risparmio mensile in «I miei obiettivi» nella scheda Percorso e prevediamo il patrimonio di fine anno con le entrate programmate."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informe a poupança mensal em “Minhas metas” na aba Jornada e projetamos os ativos do fim do ano com a receita prevista."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Укажите месячные сбережения в «Моих целях» на вкладке «Путь» — и мы спрогнозируем активы на конец года по запланированному доходу."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใส่เงินออมรายเดือนใน “เป้าหมายของฉัน” ในแท็บเส้นทาง แล้วเราจะคาดการณ์สินทรัพย์ปลายปีจากรายได้ที่กำหนดไว้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập tiền tiết kiệm tháng trong “Mục tiêu của tôi” ở tab Hành trình, chúng tôi sẽ dự báo tài sản cuối năm theo thu nhập dự kiến."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadejte měsíční spoření v „Mých cílech“ na kartě Cesta a podle plánovaných příjmů odhadneme majetek na konci roku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indtast månedlig opsparing i „Mine mål“ på fanen Rejse, så forudsiger vi aktiverne ved årets slutning ud fra den planlagte indkomst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βάλτε τη μηνιαία αποταμίευση στους «Στόχους μου» της καρτέλας Πορεία και προβλέπουμε τα περιουσιακά στοιχεία στο τέλος του έτους με βάση τα προγραμματισμένα έσοδα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syötä kuukausisäästö Matka-välilehden kohtaan ”Omat tavoitteet”, niin ennustamme vuoden lopun varat suunnitelluilla tuloilla."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan tabungan bulanan di “Target Saya” pada tab Perjalanan dan kami proyeksikan aset akhir tahun dari pendapatan terjadwal."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv inn månedlig sparing i «Mine mål» på Reise-fanen, så anslår vi eiendelene ved årets slutt ut fra planlagt inntekt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer het maandelijks sparen in bij ‘Mijn doelen’ op het tabblad Reis, dan voorspellen we je bezittingen aan het einde van het jaar met je geplande inkomsten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz miesięczne oszczędności w „Moich celach” na karcie Droga, a prognozujemy aktywa na koniec roku z planowanych przychodów."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ange månadssparande i ”Mina mål” på fliken Resa, så beräknar vi tillgångarna vid årets slut utifrån planerade inkomster."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yolculuk sekmesindeki “Hedeflerim”e aylık birikimi girin; planlı gelirlerle yıl sonu varlıklarınızı öngörelim."
          }
        }
      }
    },
    "여정 탭 ▸ 내 목표(과녁 아이콘)에서 현재 나이와 목표 은퇴 나이를 넣으면, 은퇴까지 필요한 속도로 이번달·올해·5년·은퇴 목표를 단계별로 보여드려요." : {
      "comment" : "A description of the feature that shows the user's",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the Journey tab ▸ My Goals (target icon), enter your current age and target retirement age to see this month's, this year's, 5-year and retirement targets at the pace you need."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the Journey tab ▸ My Goals (target icon), enter your current age and target retirement age to see this month's, this year's, 5-year and retirement targets at the pace you need."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ジャーニータブ▸マイ目標（的のアイコン）で現在の年齢と目標の退職年齢を入れると、退職までに必要なペースで今月・今年・5年・退職の目標を段階的に表示します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在旅程页 ▸ 我的目标（靶心图标）中填入当前年龄和目标退休年龄，会按退休前所需的节奏，分阶段显示本月、今年、5年和退休目标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在旅程頁 ▸ 我的目標（靶心圖示）中填入當前年齡和目標退休年齡，會按退休前所需的節奏，分階段顯示本月、今年、5年和退休目標。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la pestaña Trayecto ▸ Mis objetivos (icono de diana), introduce tu edad actual y la edad objetivo de retiro para ver los objetivos de este mes, este año, 5 años y retiro al ritmo necesario."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib im Weg-Tab ▸ Meine Ziele (Zielscheibe-Symbol) dein Alter und dein Zielrentenalter ein, dann zeigen wir dir Monats-, Jahres-, 5-Jahres- und Ruhestandsziel im nötigen Tempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans l’onglet Parcours ▸ Mes objectifs (icône de cible), saisissez votre âge et l’âge de départ visé pour voir les objectifs du mois, de l’année, de 5 ans et du départ au rythme nécessaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nella scheda Percorso ▸ I miei obiettivi (icona bersaglio) inserisci età attuale ed età di uscita obiettivo per vedere gli obiettivi del mese, dell’anno, dei 5 anni e dell’uscita al ritmo necessario."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na aba Jornada ▸ Minhas metas (ícone de alvo), informe sua idade atual e a idade de saída desejada para ver as metas do mês, do ano, de 5 anos e da saída no ritmo necessário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На вкладке «Путь» ▸ «Мои цели» (значок мишени) укажите текущий возраст и целевой возраст ухода — и увидите цели на месяц, год, 5 лет и на уход в нужном темпе."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ในแท็บเส้นทาง ▸ เป้าหมายของฉัน (ไอคอนเป้า) กรอกอายุปัจจุบันและอายุเกษียณเป้าหมาย จะเห็นเป้าหมายเดือนนี้ ปีนี้ 5 ปี และเกษียณ ตามจังหวะที่ต้องใช้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ở tab Hành trình ▸ Mục tiêu của tôi (biểu tượng đích ngắm), nhập tuổi hiện tại và tuổi nghỉ hưu mục tiêu để xem mục tiêu tháng này, năm nay, 5 năm và nghỉ hưu theo nhịp cần thiết."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na kartě Cesta ▸ Moje cíle (ikona terče) zadejte svůj věk a cílový věk odchodu a uvidíte cíle na tento měsíc, rok, 5 let a odchod v potřebném tempu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På fanen Rejse ▸ Mine mål (målskive-ikonet) indtaster du din alder og ønskede pensionsalder og ser målene for denne måned, i år, 5 år og pension i det tempo, der skal til."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στην καρτέλα Πορεία ▸ Στόχοι μου (εικονίδιο στόχου), βάλτε την τρέχουσα ηλικία και την ηλικία-στόχο αποχώρησης για να δείτε τους στόχους μήνα, έτους, 5 ετών και αποχώρησης με τον ρυθμό που χρειάζεται."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matka-välilehdellä ▸ Omat tavoitteet (maalitaulukuvake) syötä nykyinen ikäsi ja tavoiteeläkeikä, niin näet tämän kuun, vuoden, 5 vuoden ja eläkkeen tavoitteet tarvittavalla vauhdilla."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di tab Perjalanan ▸ Target Saya (ikon sasaran), masukkan usia saat ini dan usia pensiun target untuk melihat target bulan ini, tahun ini, 5 tahun, dan pensiun pada laju yang dibutuhkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På Reise-fanen ▸ Mine mål (blinkskive-ikonet) skriver du inn alderen din og ønsket pensjonsalder, så ser du målene for denne måneden, i år, 5 år og pensjon i det tempoet som trengs."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer op het tabblad Reis ▸ Mijn doelen (doelwit-icoon) je huidige leeftijd en doelpensioenleeftijd in om de doelen voor deze maand, dit jaar, 5 jaar en pensioen in het benodigde tempo te zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na karcie Droga ▸ Moje cele (ikona tarczy) wpisz obecny wiek i docelowy wiek odejścia, aby zobaczyć cele na ten miesiąc, rok, 5 lat i odejście w wymaganym tempie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På fliken Resa ▸ Mina mål (måltavleikonen) anger du din ålder och önskade pensionsålder så ser du målen för den här månaden, i år, 5 år och pension i den takt som behövs."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yolculuk sekmesi ▸ Hedeflerim’de (hedef simgesi) mevcut yaşınızı ve hedef emeklilik yaşınızı girin; bu ay, bu yıl, 5 yıl ve emeklilik hedeflerini gereken hızla görün."
          }
        }
      }
    },
    "여정 탭 상단의 시계 아이콘(기록)에서 이 기록을 수정하거나 지울 수 있어요. 잘못 튄 점도 거기서 고치면 됩니다." : {
      "comment" : "A description of how to edit or delete a record.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the clock icon (Records) at the top of the Journey tab to edit or delete this record. You can fix a stray point there too."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the clock icon (Records) at the top of the Journey tab to edit or delete this record. You can fix a stray point there too."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ジャーニータブ上部の時計アイコン（記録）から、この記録を修正したり削除したりできます。外れた点もそこで直せます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点旅程页顶部的时钟图标（记录），可以修改或删除这条记录。异常的点也可以在那里修正。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點旅程頁頂部的時鐘圖示（記錄），可以修改或刪除這條記錄。異常的點也可以在那裡修正。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el icono del reloj (Registros) en la parte superior de la pestaña Trayecto para editar o eliminar este registro. También puedes corregir ahí un punto raro."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe oben im Weg-Tab auf das Uhr-Symbol (Einträge), um diesen Eintrag zu bearbeiten oder zu löschen. Auch einen Ausreißer kannst du dort korrigieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez l’icône d’horloge (Enregistrements) en haut de l’onglet Parcours pour modifier ou supprimer cet enregistrement. Vous pouvez aussi y corriger un point aberrant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca l’icona dell’orologio (Registrazioni) in alto nella scheda Percorso per modificare o eliminare questa registrazione. Puoi correggere lì anche un punto anomalo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque no ícone de relógio (Registros) no alto da aba Jornada para editar ou excluir este registro. Você também pode corrigir ali um ponto fora da curva."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите значок часов («Записи») вверху вкладки «Путь», чтобы изменить или удалить эту запись. Выбившуюся точку тоже можно исправить там."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะไอคอนนาฬิกา (บันทึก) ด้านบนแท็บเส้นทาง เพื่อแก้ไขหรือลบบันทึกนี้ จุดที่พุ่งผิดปกติก็แก้ได้ที่นั่น"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm biểu tượng đồng hồ (Bản ghi) ở đầu tab Hành trình để sửa hoặc xóa bản ghi này. Điểm bất thường cũng sửa được ở đó."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepněte na ikonu hodin (Záznamy) nahoře na kartě Cesta a tento záznam upravíte nebo smažete. Odlehlý bod tam také opravíte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på ur-ikonet (Registreringer) øverst på fanen Rejse for at rette eller slette denne registrering. Et afvigende punkt kan du også rette der."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε το εικονίδιο ρολογιού (Καταγραφές) στην κορυφή της καρτέλας Πορεία για να επεξεργαστείτε ή να διαγράψετε αυτή την καταγραφή. Εκεί διορθώνετε και ένα ακραίο σημείο."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta Matka-välilehden yläreunan kellokuvaketta (Merkinnät) muokataksesi tai poistaaksesi tämän merkinnän. Poikkeavan pisteen voi korjata siellä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk ikon jam (Catatan) di atas tab Perjalanan untuk mengubah atau menghapus catatan ini. Titik yang menyimpang juga bisa diperbaiki di sana."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på klokkeikonet (Registreringer) øverst på Reise-fanen for å redigere eller slette denne registreringen. Et avvikende punkt kan du også rette der."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op het klokpictogram (Registraties) bovenaan het tabblad Reis om deze registratie te wijzigen of te verwijderen. Een uitschieter kun je daar ook corrigeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij ikonę zegara (Zapisy) u góry karty Droga, aby edytować lub usunąć ten zapis. Odstający punkt można tam też poprawić."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på klockikonen (Registreringar) överst på fliken Resa för att redigera eller ta bort den här registreringen. En avvikande punkt kan du också rätta där."
          }
        },
        "tr" : {
          "stringUnit" : {
