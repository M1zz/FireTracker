    "부채 이자율(%@)이 투자 수익률(%@)보다 높아요. 빚 상환은 위험 없는 확정 이득이에요." : {
      "comment" : "\"투자 수익률\" and \"부채 이자율\" are used as placeholders for the actual interest rates.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "부채 이자율(%1$@)이 투자 수익률(%2$@)보다 높아요. 빚 상환은 위험 없는 확정 이득이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The debt interest rate (%@) is higher than the investment return (%@). Paying off debt is a guaranteed, risk-free gain."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The debt interest rate (%@) is higher than the investment return (%@). Paying off debt is a guaranteed, risk-free gain."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "負債の利率（%@）が投資リターン（%@）より高いです。借金の返済はリスクのない確実な利益です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "负债利率（%@）高于投资收益率（%@）。还债是没有风险的确定收益。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "負債利率（%@）高於投資報酬率（%@）。還債是沒有風險的確定收益。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tipo de interés de la deuda (%@) es mayor que la rentabilidad de la inversión (%@). Pagar deuda es una ganancia segura y sin riesgo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schuldzins (%@) liegt über der Anlagerendite (%@). Schulden zu tilgen ist ein sicherer, risikofreier Gewinn."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le taux d’intérêt de la dette (%@) est supérieur au rendement de l’investissement (%@). Rembourser une dette est un gain certain et sans risque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tasso d’interesse del debito (%@) è superiore al rendimento dell’investimento (%@). Estinguere il debito è un guadagno certo e senza rischio."
          }
        }
      }
    },
