    "꺼내 쓸 수 있는 돈만으로 %lld세까지 버틸 확률이 85%%를 넘는 가장 이른 나이예요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejnižší věk, ve kterém je šance vydržet do věku %lld jen z peněz, které lze skutečně utratit, nad 85 %%."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er den tidligste alder, hvor chancen for at holde til %lld år kun med penge, du reelt kan bruge, overstiger 85 %%."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das früheste Alter, in dem allein mit Geld, das du wirklich ausgeben kannst, die Chance, bis %lld durchzuhalten, über 85 %% liegt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Είναι η νωρίτερη ηλικία στην οποία, μόνο με χρήματα που μπορείτε πράγματι να ξοδέψετε, η πιθανότητα να φτάσετε ως τα %lld ξεπερνά το 85%%."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The earliest age at which money you can actually spend has an 85%% chance of lasting to %lld."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The earliest age at which money you can actually spend has an 85%% chance of lasting to %lld."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es la edad más temprana en la que, solo con dinero que realmente puedes gastar, la probabilidad de llegar a los %lld años supera el 85 %%."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aikaisin ikä, jossa pelkästään oikeasti käytettävissä olevilla rahoilla todennäköisyys riittää %lld ikään ylittää 85 %%."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est l’âge le plus précoce auquel, avec le seul argent réellement dépensable, la chance de tenir jusqu’à %lld ans dépasse 85 %%."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usia paling awal ketika, hanya dengan uang yang benar-benar bisa dibelanjakan, peluang bertahan hingga usia %lld melebihi 85%%."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È l’età più precoce in cui, con il solo denaro che puoi davvero spendere, la probabilità di arrivare a %lld anni supera l’85%%."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取り崩せるお金だけで%lld歳まで持つ確率が85%%を超える、最も早い年齢です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "꺼내 쓸 수 있는 돈만으로 %lld세까지 버틸 확률이 85%%를 넘는 가장 이른 나이예요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette er den tidligste alderen der sjansen for å holde til %lld år bare med penger du faktisk kan bruke, overstiger 85 %%."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit is de vroegste leeftijd waarop de kans dat het tot %lld jaar meegaat, alleen met geld dat je echt kunt uitgeven, boven de 85%% komt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To najwcześniejszy wiek, w którym przy samych pieniądzach, które naprawdę można wydać, szansa, że starczy do wieku %lld lat, przekracza 85%%."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É a idade mais cedo em que, só com o dinheiro que você pode realmente gastar, a chance de durar até os %lld anos passa de 85%%."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это самый ранний возраст, в котором шанс дотянуть до %lld только на реально тратимые деньги превышает 85 %%."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det är den tidigaste ålder då chansen att hålla till %lld år, med enbart pengar du faktiskt kan spendera, överstiger 85 %%."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เป็นอายุที่เร็วที่สุดที่ ถ้าใช้เฉพาะเงินที่ใช้ได้จริง โอกาสอยู่ได้ถึงอายุ %lld ปีจะเกิน 85%%"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca gerçekten harcayabileceğiniz parayla %lld yaşına dayanma ihtimalinin %%85’i aştığı en erken yaştır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đây là độ tuổi sớm nhất mà nếu chỉ dùng số tiền thực sự chi được, khả năng trụ đến %lld tuổi vượt 85%%."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是在只用可支取的钱的情况下，撑到%lld岁的概率超过85%%的最早年龄。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是在只用可支取的錢的情況下，撐到%lld歲的機率超過85%%的最早年齡。"
          }
        }
      }
    },
    "끄면 ‘6억원’처럼 억·만 단위로, 켜면 ‘600,000,000원’처럼 숫자로만 표시합니다. 앱 전체에 적용돼요." : {
      "comment" : "A description of the display settings section.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypnuto zkracuje velké částky v korejských jednotkách (eok = 100 mil., man = 10 tis.); zapnuto ukazuje plná čísla jako „600 000 000 wonů“. Platí v celé aplikaci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slået fra forkorter store beløb i koreanske enheder (eok = 100 mio., man = 10.000); slået til viser hele tal som „600.000.000 won“. Gælder i hele appen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus: große Beträge in koreanischen Einheiten (Eok = 100 Mio., Man = 10.000); an: volle Zahlen wie „600.000.000 Won“. Gilt für die ganze App."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν είναι ανενεργό, τα μεγάλα ποσά συντομεύονται σε κορεατικές μονάδες (eok = 100 εκατ., man = 10.000)· όταν είναι ενεργό, εμφανίζονται ολόκληροι αριθμοί όπως «600.000.000 γουόν». Ισχύει σε όλη την εφαρμογή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off abbreviates large amounts in Korean units (eok = 100M, man = 10K); on shows full numbers like ‘600,000,000 won’. Applies across the whole app."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off abbreviates large amounts in Korean units (eok = 100M, man = 10K); on shows full numbers like ‘600,000,000 won’. Applies across the whole app."
          }
        },
        "es" : {
          "stringUnit" : {
