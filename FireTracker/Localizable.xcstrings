        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja obecna pensja %1$@ jest o %4$@ wyższa niż pensja z %2$@ w dzisiejszych cenach (%3$@)."
          }
        },
        "sv" : {
          "stringUnit" : {
