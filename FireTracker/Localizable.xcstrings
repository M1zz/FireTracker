        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn cho thuê theo tháng. Tiền thuê hằng tháng được tính vào dòng tiền."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
