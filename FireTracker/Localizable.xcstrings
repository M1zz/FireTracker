    "배당·이자·월세 등 수입이 잡혀야 ‘내 전략의 수익률’이 계산돼요. 자산 탭에서 배당률·월세·이자율을 넣어 보세요." : {
      "comment" : "A description of how the strategy yield is calculated.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Income such as dividends, interest and rent is needed to calculate ‘your strategy's return’. Enter dividend yield, rent or interest rate on the Assets tab."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Income such as dividends, interest and rent is needed to calculate ‘your strategy's return’. Enter dividend yield, rent or interest rate on the Assets tab."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配当・利息・家賃などの収入があって初めて「自分の戦略のリターン」が計算されます。資産タブで配当率・家賃・利率を入れてみてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有了分红、利息、房租等收入，才能计算“我的策略收益率”。请在资产页填入分红率、房租或利率。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有了分紅、利息、房租等收入，才能計算「我的策略報酬率」。請在資產頁填入分紅率、房租或利率。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hacen falta ingresos como dividendos, intereses y alquileres para calcular «la rentabilidad de tu estrategia». Introduce el dividendo, el alquiler o el interés en la pestaña Activos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für die „Rendite deiner Strategie“ braucht es Einnahmen wie Dividenden, Zinsen und Mieten. Trag im Vermögen-Tab Dividendenrendite, Miete oder Zins ein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il faut des revenus comme dividendes, intérêts et loyers pour calculer le « rendement de votre stratégie ». Saisissez le taux de dividende, le loyer ou le taux d’intérêt dans l’onglet Actifs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servono entrate come dividendi, interessi e affitti per calcolare il «rendimento della tua strategia». Inserisci rendimento da dividendo, affitto o tasso nella scheda Patrimonio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É preciso ter receitas como dividendos, juros e aluguéis para calcular o “retorno da sua estratégia”. Informe a taxa de dividendos, o aluguel ou a taxa de juros na aba Patrimônio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы посчитать «доходность вашей стратегии», нужны доходы — дивиденды, проценты, аренда. Укажите доходность дивидендов, аренду или ставку на вкладке «Активы»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องมีรายได้อย่างเงินปันผล ดอกเบี้ย และค่าเช่า จึงจะคำนวณ “ผลตอบแทนกลยุทธ์ของฉัน” ได้ ลองกรอกอัตราปันผล ค่าเช่า หรืออัตราดอกเบี้ยในแท็บสินทรัพย์"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cần có thu nhập như cổ tức, lãi, tiền thuê thì mới tính được “lợi suất chiến lược của tôi”. Hãy nhập tỷ suất cổ tức, tiền thuê hoặc lãi suất ở tab Tài sản."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro výpočet „výnosu vaší strategie“ jsou potřeba příjmy jako dividendy, úroky a nájem. Zadejte dividendový výnos, nájem nebo úrok na kartě Majetek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der skal være indtægter som udbytte, renter og husleje for at beregne „din strategis afkast“. Indtast udbytteprocent, husleje eller rente på fanen Aktiver."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρειάζονται έσοδα όπως μερίσματα, τόκοι και ενοίκια για να υπολογιστεί η «απόδοση της στρατηγικής σας». Βάλτε μερισματική απόδοση, ενοίκιο ή επιτόκιο στην καρτέλα Περιουσιακά στοιχεία."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Strategiasi tuoton” laskemiseen tarvitaan tuloja kuten osinkoja, korkoja ja vuokria. Syötä osinkotuotto, vuokra tai korko Varat-välilehdellä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendapatan seperti dividen, bunga, dan sewa diperlukan untuk menghitung “imbal hasil strategi saya”. Masukkan imbal hasil dividen, sewa, atau suku bunga di tab Aset."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det trengs inntekter som utbytte, renter og leie for å beregne «avkastningen på strategien din». Skriv inn utbytteprosent, leie eller rente på Eiendeler-fanen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er zijn inkomsten zoals dividend, rente en huur nodig om het ‘rendement van jouw strategie’ te berekenen. Vul op het tabblad Bezittingen dividendrendement, huur of rente in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do obliczenia „zwrotu twojej strategii” potrzebne są przychody, takie jak dywidendy, odsetki i czynsz. Wpisz stopę dywidendy, czynsz lub oprocentowanie na karcie Aktywa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det behövs inkomster som utdelning, ränta och hyra för att beräkna ”din strategis avkastning”. Ange direktavkastning, hyra eller ränta på fliken Tillgångar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Stratejinizin getirisi”ni hesaplamak için temettü, faiz ve kira gibi gelirler gerekir. Varlıklar sekmesinde temettü oranı, kira veya faiz oranı girin."
          }
        }
      }
    },
