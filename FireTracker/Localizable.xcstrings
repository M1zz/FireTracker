          }
        }
      }
    },
    "하나만 골라 바꿔 보고, 다음 기록에서 확인하세요." : {
      "comment" : "A description of the benefits of changing the amount saved each month.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
