            "value" : "Emeklilikte (%1$lld yaş) ayda %2$@ won harcasanız bile %3$lld yaşında %4$@ won kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau khi nghỉ hưu (%1$lld tuổi), chi %2$@ won mỗi tháng vẫn còn %4$@ won ở tuổi %3$lld."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退休（%lld岁）后每月花%@韩元，到%lld岁还剩%@韩元。"
          }
