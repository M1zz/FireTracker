          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a holding to set a drop from peak or a target price, and we'll tell you when to sell"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a holding to set a drop from peak or a target price, and we'll tell you when to sell"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "銘柄をタップして、高値からの下落幅や目標価格を決めると、売り時をお知らせします"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按持仓，设定高点回落幅度或目标价，到了卖出时机会提醒你"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下持倉，設定高點回落幅度或目標價，到了賣出時機會提醒你"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un valor y fija una caída desde el máximo o un precio objetivo para avisarte de cuándo vender"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf eine Position und lege einen Rückgang vom Hoch oder ein Kursziel fest, dann sagen wir dir, wann du verkaufen solltest"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une position pour fixer une baisse depuis le plus haut ou un prix cible, et nous vous dirons quand vendre"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca un titolo e fissa un calo dal massimo o un prezzo obiettivo: ti diremo quando vendere"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque num ativo e defina uma queda do pico ou um preço-alvo para saber quando vender"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите на позицию и задайте падение от пика или целевую цену — мы подскажем, когда продавать"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะรายการเพื่อตั้งการลดลงจากจุดสูงสุดหรือราคาเป้าหมาย แล้วเราจะบอกเมื่อถึงเวลาขาย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm vào một mã để đặt mức giảm từ đỉnh hoặc giá mục tiêu, chúng tôi sẽ báo khi đến lúc bán"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepněte na pozici a nastavte pokles od maxima nebo cílovou cenu — dáme vědět, kdy prodat"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på en position, og angiv fald fra toppen eller en målkurs, så siger vi til, når det er tid til at sælge"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε μια θέση και ορίστε πτώση από την κορυφή ή τιμή-στόχο — θα σας πούμε πότε να πουλήσετε"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta positiota ja aseta pudotus huipusta tai tavoitehinta, niin kerromme, milloin on myynnin aika"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk saham untuk menetapkan batas turun dari puncak atau target harga, kami akan memberi tahu saat waktunya jual"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på en posisjon og angi fall fra toppen eller en målkurs, så sier vi fra når det er tid for å selge"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op een positie en stel een daling vanaf de top of een koersdoel in, dan laten we weten wanneer je moet verkopen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij pozycję i ustal spadek od szczytu lub cenę docelową, a damy znać, kiedy sprzedać"
