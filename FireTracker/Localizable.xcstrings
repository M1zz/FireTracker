          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Merkintöihin perustuva” korjaa tuottoa Matka-välilehden merkinnöillä. Merkinnöissä on mukana myös säästötalletuksia, joten luku voi olla todellista tuottoa korkeampi; siksi se sekoitetaan puoliksi kunkin lajin tyypillisen arvon kanssa."
