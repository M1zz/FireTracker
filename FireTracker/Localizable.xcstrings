    "예금·적금 만기에 얼마를 받는지, 이자에 세금은 얼마인지 계산해요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Work out what a deposit or savings plan pays at maturity, and the tax on its interest."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예금·적금 만기에 얼마를 받는지, 이자에 세금은 얼마인지 계산해요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Work out what a deposit or savings plan pays at maturity, and the tax on its interest."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預金や積立の満期時の受取額と、利息にかかる税金を計算します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "计算存款或定投到期能拿多少，以及利息要交的税。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計算存款或定投到期能拿多少，以及利息要交的稅。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calcula lo que paga un depósito o plan de ahorro al vencimiento y el impuesto sobre sus intereses."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berechne, was ein Festgeld oder Sparplan bei Fälligkeit auszahlt und welche Steuer auf die Zinsen anfällt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculez ce que rapporte un dépôt ou un plan d’épargne à l’échéance, ainsi que l’impôt sur ses intérêts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calcola quanto rende un deposito o un piano di risparmio alla scadenza e la tassa sui suoi interessi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calcule quanto rende um depósito ou plano de poupança no vencimento e o imposto sobre os juros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Узнайте, сколько выплатит вклад или накопительный план по сроку и какой налог с процентов."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำนวณว่าเงินฝากหรือแผนออมจ่ายเท่าไรเมื่อครบกำหนด และภาษีของดอกเบี้ย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tính xem khoản tiền gửi hay kế hoạch tiết kiệm trả bao nhiêu khi đáo hạn và thuế trên tiền lãi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spočítejte, kolik vyplatí vklad nebo spořicí plán při splatnosti a jaká je daň z úroků."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beregn, hvad et indskud eller en opsparingsplan udbetaler ved udløb, og skatten på renterne."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Υπολογίστε τι αποδίδει μια κατάθεση ή ένα πρόγραμμα αποταμίευσης στη λήξη και τον φόρο στους τόκους."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laske, paljonko talletus tai säästösuunnitelma maksaa erääntyessään, ja koron vero."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitung berapa yang dibayar deposito atau rencana tabungan saat jatuh tempo, dan pajak atas bunganya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beregn hva et innskudd eller en spareplan betaler ved forfall, og skatten på rentene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereken wat een deposito of spaarplan bij afloop uitkeert en de belasting op de rente."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oblicz, ile wypłaci lokata lub plan oszczędnościowy w terminie zapadalności i podatek od odsetek."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beräkna vad en insättning eller sparplan betalar ut vid förfall och skatten på räntan."
          }
        }
      }
    },
