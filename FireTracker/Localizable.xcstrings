    "글자 크기를 키워도 잘리지 않고 보기 좋게 다시 배치돼요." : {
      "comment" : "Roadmap item detail: Dynamic Type layouts",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screens rearrange neatly instead of getting cut off when you enlarge text."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "글자 크기를 키워도 잘리지 않고 보기 좋게 다시 배치돼요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screens rearrange neatly instead of getting cut off when you enlarge text."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字サイズを大きくしても切れずに、きれいに配置し直されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放大字体后，界面也不会被截断，而是整齐地重新排布。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放大字型後，介面也不會被截斷，而是整齊地重新排布。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al aumentar el tamaño del texto, las pantallas se reorganizan en lugar de cortarse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei größerer Schrift werden Bildschirme ordentlich neu angeordnet, statt abgeschnitten zu werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand vous agrandissez le texte, les écrans se réorganisent proprement au lieu d’être tronqués."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ingrandisci il testo, le schermate si riorganizzano bene invece di essere tagliate."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao aumentar o tamanho do texto, as telas se reorganizam bem em vez de serem cortadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При увеличении шрифта экраны аккуратно перестраиваются, а не обрезаются."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อขยายขนาดตัวอักษร หน้าจอจะจัดวางใหม่อย่างเรียบร้อยโดยไม่ถูกตัด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi tăng cỡ chữ, màn hình được bố trí lại gọn gàng thay vì bị cắt."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
