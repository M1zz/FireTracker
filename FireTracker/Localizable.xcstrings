    "2,000가지 시장 흐름 중 나쁜 쪽 10%에서도 끝까지 버텨요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vydrží do konce i v nejhorších 10 % z 2 000 vývojů trhu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holder til det sidste, selv i de dårligste 10 % af 2.000 markedsforløb."
