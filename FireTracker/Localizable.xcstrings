    "공포 구간이에요. 정해 둔 만큼 나눠서 사는 때예요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fear zone. Time to buy in slices, as much as you planned."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공포 구간이에요. 정해 둔 만큼 나눠서 사는 때예요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fear zone. Time to buy in slices, as much as you planned."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恐怖ゾーンです。決めておいた分だけ、分けて買う時期です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "处于恐惧区间。是按计划分批买入的时候。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "處於恐懼區間。是按計劃分批買入的時候。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zona de miedo. Es momento de comprar por tramos, lo que hayas planificado."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angstzone. Zeit, gestaffelt so viel zu kaufen, wie du geplant hast."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zone de peur. C’est le moment d’acheter par tranches, selon ce que vous avez prévu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zona di paura. È il momento di comprare a rate, quanto pianificato."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zona de medo. É hora de comprar aos poucos, na medida do que você planejou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зона страха. Время покупать частями — столько, сколько запланировали."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อยู่ในโซนกลัว ถึงเวลาทยอยซื้อตามที่วางแผนไว้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vùng sợ hãi. Đến lúc chia nhỏ để mua đúng như đã định."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zóna strachu. Čas nakupovat po částech, kolik jste si naplánovali."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frygtzone. Tid til at købe i etaper, så meget som du har planlagt."
