    },
    "지난 월급을 물가로 나눠, 내 실질 구매력이 늘었는지 봐요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjust past salaries for inflation to see whether your real purchasing power grew."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지난 월급을 물가로 나눠, 내 실질 구매력이 늘었는지 봐요."
          }
