          "stringUnit" : {
            "state" : "translated",
            "value" : "Noteer bij elke aankoop een regel en je ziet altijd hoeveel %@ je hebt en wanneer en tegen welke prijs je kocht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
