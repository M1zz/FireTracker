    "시급은 일하는 시간에만 붙는 국소 밀도예요. 하루 24시간 전체로 펴면 시간당 %@ 수준이에요." : {
      "comment" : "A paragraph explaining that the hourly wage is only valid for the time you work, and when you add it up for the whole month, it's only 3/10th of what it should be. The argument is the string “0원” or the string “%arg원”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your hourly wage is a local density that only applies to hours you work. Spread over all 24 hours of the day, it's about %@ an hour."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your hourly wage is a local density that only applies to hours you work. Spread over all 24 hours of the day, it's about %@ an hour."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時給は働く時間にだけつく局所的な密度です。1日24時間全体に広げると、1時間あたり%@程度です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "时薪是只附着在工作时间上的局部密度。摊到一天24小时，大约是每小时%@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時薪是隻附著在工作時間上的區域性密度。攤到一天24小時，大約是每小時%@。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sueldo por hora es una densidad local que solo se aplica a las horas que trabajas. Repartido en las 24 horas del día, son unos %@ por hora."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Stundenlohn ist eine lokale Dichte, die nur auf Arbeitsstunden entfällt. Auf alle 24 Stunden des Tages verteilt sind es etwa %@ pro Stunde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le salaire horaire est une densité locale qui ne s’applique qu’aux heures travaillées. Réparti sur les 24 heures de la journée, cela fait environ %@ par heure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La paga oraria è una densità locale che vale solo per le ore di lavoro. Distribuita sulle 24 ore del giorno, sono circa %@ all’ora."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O valor-hora é uma densidade local que só vale para as horas trabalhadas. Distribuído pelas 24 horas do dia, dá cerca de %@ por hora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Почасовая ставка — это локальная плотность, относящаяся только к рабочим часам. Если распределить её на все 24 часа суток, получится около %@ в час."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ค่าแรงต่อชั่วโมงเป็นความหนาแน่นเฉพาะที่ติดกับชั่วโมงทำงานเท่านั้น ถ้ากระจายไปทั้ง 24 ชั่วโมงของวัน จะอยู่ที่ราว %@ ต่อชั่วโมง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lương theo giờ là mật độ cục bộ chỉ gắn với giờ làm việc. Dàn đều ra cả 24 giờ trong ngày thì khoảng %@ mỗi giờ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hodinová sazba je lokální hustota, která platí jen pro odpracované hodiny. Rozložená na všech 24 hodin dne je to zhruba %@ za hodinu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timelønnen er en lokal tæthed, der kun gælder for arbejdstimerne. Fordelt over alle døgnets 24 timer er den ca. %@ pr. time."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ωρομίσθιο είναι μια τοπική πυκνότητα που αφορά μόνο τις ώρες εργασίας. Απλωμένο στις 24 ώρες της ημέρας, είναι περίπου %@ ανά ώρα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuntipalkka on paikallinen tiheys, joka koskee vain työtunteja. Levitettynä vuorokauden kaikille 24 tunnille se on noin %@ tunnissa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upah per jam adalah kepadatan lokal yang hanya melekat pada jam kerja. Jika disebar ke seluruh 24 jam sehari, sekitar %@ per jam."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timelønnen er en lokal tetthet som bare gjelder arbeidstimene. Fordelt over alle døgnets 24 timer er den ca. %@ per time."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het uurloon is een lokale dichtheid die alleen voor werkuren geldt. Uitgesmeerd over alle 24 uur van de dag is het ongeveer %@ per uur."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stawka godzinowa to lokalna gęstość, która dotyczy tylko godzin pracy. Rozłożona na wszystkie 24 godziny doby to około %@ na godzinę."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timlönen är en lokal täthet som bara gäller arbetstimmarna. Utspridd över dygnets alla 24 timmar är den cirka %@ per timme."
          }
        }
      }
    },
    "시급이 오르는 동안엔 시간을 팔지 말고 시급에 투자할 것." : {
      "comment" : "A one-liner summarizing the time-saving strategy.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While your wage is rising, don't sell time — invest in your wage."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While your wage is rising, don't sell time — invest in your wage."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時給が上がっている間は、時間を売らずに時給に投資すること。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "时薪上涨期间，不要卖时间，要投资时薪。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時薪上漲期間，不要賣時間，要投資時薪。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras tu sueldo sube, no vendas tiempo: invierte en tu sueldo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solange dein Lohn steigt, verkauf keine Zeit – investiere in deinen Lohn."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tant que votre salaire monte, ne vendez pas de temps : investissez dans votre salaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finché la tua paga cresce, non vendere tempo: investi nella tua paga."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enquanto seu valor-hora sobe, não venda tempo: invista no seu valor-hora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока ваша ставка растёт, не продавайте время — вкладывайтесь в свою ставку."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระหว่างที่ค่าแรงกำลังขึ้น อย่าขายเวลา ให้ลงทุนในค่าแรงของตัวเอง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi lương giờ đang tăng, đừng bán thời gian — hãy đầu tư vào lương giờ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokud vaše sazba roste, neprodávejte čas – investujte do své sazby."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mens din timeløn stiger, så sælg ikke tid – invester i din timeløn."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όσο ανεβαίνει το ωρομίσθιό σας, μην πουλάτε χρόνο — επενδύστε στο ωρομίσθιό σας."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tuntipalkkasi nousee, älä myy aikaa – sijoita tuntipalkkaasi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selama upah per jam Anda naik, jangan jual waktu — investasikan pada upah per jam Anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mens timelønnen din stiger, ikke selg tid – invester i timelønnen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terwijl je uurloon stijgt, verkoop je geen tijd – beleg in je uurloon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopóki twoja stawka rośnie, nie sprzedawaj czasu – inwestuj w swoją stawkę."
