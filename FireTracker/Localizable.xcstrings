    "앱을 완전히 닫았다가 다시 열면 동기화가 시작돼요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizace začne po úplném zavření a opětovném otevření aplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkroniseringen starter, når du har lukket appen helt og åbnet den igen."
