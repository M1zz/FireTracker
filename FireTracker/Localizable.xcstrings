    "%@ · 현재 %@%@원 · %@%@원 더 필요" : {
      "comment" : "A label indicating that a financial goal has been met, showing the current amount and the target amount.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ko" : {
