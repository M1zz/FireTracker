    "기록을 저장할수록 이번 달 안의 변화가 촘촘하게 그려져요." : {
      "comment" : "A description of the trend view's disclaimer.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The more records you save, the more detail you'll see in this month's changes."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The more records you save, the more detail you'll see in this month's changes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録を保存するほど、今月の中の変化が細かく描かれます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存的记录越多，本月内的变化就画得越细致。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儲存的記錄越多，本月內的變化就畫得越細緻。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuantos más registros guardes, más detallados se dibujan los cambios dentro de este mes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je mehr Einträge du speicherst, desto feiner zeichnen sich die Veränderungen in diesem Monat ab."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus vous enregistrez, plus les variations de ce mois sont dessinées finement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più registrazioni salvi, più i cambiamenti di questo mese vengono disegnati nel dettaglio."
          }
        }
      }
    },
    "기록이 쌓이면 분기마다 리포트가 만들어져요. 자산을 바꾸면 그날 기록이 자동으로 남아요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reports appear each quarter as records build up. Records are saved automatically whenever your assets change."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록이 쌓이면 분기마다 리포트가 만들어져요. 자산을 바꾸면 그날 기록이 자동으로 남아요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reports appear each quarter as records build up. Records are saved automatically whenever your assets change."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録が溜まると四半期ごとにレポートが作られます。資産を変えるとその日の記録が自動で残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录累积后，每个季度都会生成报告。资产变动时，当天的记录会自动保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記錄累積後，每個季度都會生成報告。資產變動時，當天的記錄會自動儲存。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con registros acumulados se genera un informe cada trimestre. Los registros se guardan solos cuando cambian tus activos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit wachsenden Einträgen entsteht jedes Quartal ein Bericht. Ändern sich deine Vermögen, wird der Eintrag des Tages automatisch gespeichert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À mesure que les enregistrements s’accumulent, un rapport est créé chaque trimestre. Un enregistrement est ajouté automatiquement dès que vos actifs changent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Man mano che le registrazioni si accumulano, ogni trimestre viene creato un rapporto. Quando il patrimonio cambia, la registrazione del giorno si salva da sola."
          }
        }
      }
    },
