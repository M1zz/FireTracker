          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer op het tabblad Bezittingen het dividendrendement van een aandeel, de huur van een pand of de rente van een deposito in, dan verschijnen hier maand- en weekinkomsten."
          }
