        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με αυτό το σχέδιο, η πιθανότητα αντοχής δεν φτάνει το 85%% πριν τα %lld. Συγκρίνετε παρακάτω σενάρια με περισσότερη αποταμίευση ή χαμηλότερο κόστος."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tällä suunnitelmalla kestämisen todennäköisyys ei yllä 85 %%:iin ennen %lld ikää. Vertaa alla skenaarioita, joissa säästetään enemmän tai kulutetaan vähemmän."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan rencana ini, peluang bertahan tidak mencapai 85%% sebelum usia %lld. Bandingkan di bawah skenario dengan tabungan lebih banyak atau biaya lebih rendah."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med denne planen når ikke sjansen for å holde 85 %% før %lld år. Sammenlign nedenfor scenarier med mer sparing eller lavere kostnader."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met dit plan haalt de kans dat het meegaat de 85%% niet vóór %lld jaar. Vergelijk hieronder scenario’s met meer sparen of lagere kosten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy tym planie szansa, że starczy, nie osiąga 85%% przed wiekiem %lld lat. Porównaj niżej scenariusze z większymi oszczędnościami lub niższymi kosztami."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
