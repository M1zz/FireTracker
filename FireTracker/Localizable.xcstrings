        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv inn lønn for to eller flere år,\nså ser du kjøpekraften etter inflasjon."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vul salarissen van twee of meer jaren in\nom de koopkracht na inflatie te zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
