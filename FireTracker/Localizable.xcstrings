        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync starts after you fully close and reopen the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización empieza después de cerrar la app del todo y volver a abrirla."
