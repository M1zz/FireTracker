    "기억나는 해의 월급만 적어도 돼요. 세전·세후 중 하나로만 통일하면 비교는 정확해요. 금액은 %@ 통화 기준이에요." : {
      "comment" : "A description of how to record past wages.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can enter just the salaries you remember. Use before-tax or after-tax consistently and the comparison stays accurate. Amounts are in %@."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can enter just the salaries you remember. Use before-tax or after-tax consistently and the comparison stays accurate. Amounts are in %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "覚えている年の給料だけでも大丈夫です。税引前か税引後のどちらかに揃えれば、比較は正確になります。金額は%@の通貨基準です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只填还记得的年份的月薪也可以。统一用税前或税后其中一种，比较就是准确的。金额按%@货币计算。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只填還記得的年份的月薪也可以。統一用稅前或稅後其中一種，比較就是準確的。金額按%@貨幣計算。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes poner solo los sueldos de los años que recuerdes. Si usas siempre bruto o siempre neto, la comparación es exacta. Los importes están en %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst nur die Gehälter der Jahre eintragen, an die du dich erinnerst. Bleib bei brutto oder netto, dann stimmt der Vergleich. Beträge in der Währung %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez ne saisir que les salaires des années dont vous vous souvenez. Restez en brut ou en net et la comparaison reste juste. Montants dans la devise %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi inserire solo gli stipendi degli anni che ricordi. Usa sempre lordo o sempre netto e il confronto resta corretto. Gli importi sono nella valuta %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode colocar só os salários dos anos de que se lembra. Use sempre bruto ou sempre líquido e a comparação fica correta. Os valores estão na moeda %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можно указать зарплату только за те годы, которые помните. Берите либо до вычета налогов, либо после — тогда сравнение точное. Суммы в валюте: %@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใส่เฉพาะเงินเดือนของปีที่จำได้ก็ได้ ใช้ก่อนหักภาษีหรือหลังหักภาษีอย่างใดอย่างหนึ่งให้เหมือนกัน การเปรียบเทียบจะแม่นยำ จำนวนเงินอิงสกุลเงิน %@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ cần nhập lương của những năm bạn nhớ. Thống nhất dùng trước thuế hoặc sau thuế thì so sánh sẽ chính xác. Số tiền tính theo đơn vị tiền %@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stačí zadat mzdy z let, které si pamatujete. Držte se buď hrubé, nebo čisté mzdy a srovnání bude přesné. Částky jsou v měně %@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan nøjes med at skrive lønnen for de år, du husker. Hold dig til enten brutto eller netto, så bliver sammenligningen korrekt. Beløb er i valutaen %@."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μπορείτε να βάλετε μόνο τους μισθούς των ετών που θυμάστε. Κρατήστε είτε μεικτά είτε καθαρά και η σύγκριση θα είναι ακριβής. Τα ποσά είναι στο νόμισμα %@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit syöttää vain muistamiesi vuosien palkat. Pidä kaikki joko brutto- tai nettomuodossa, niin vertailu on tarkka. Summat ovat valuutassa %@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda boleh mengisi gaji tahun-tahun yang diingat saja. Pakai gaji kotor atau bersih secara konsisten dan perbandingannya akurat. Jumlah dalam mata uang %@."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan nøye deg med lønnen for årene du husker. Hold deg til enten brutto eller netto, så blir sammenligningen riktig. Beløp er i valutaen %@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt alleen de salarissen invullen van de jaren die je je herinnert. Houd het bij bruto of bij netto, dan klopt de vergelijking. Bedragen zijn in de valuta %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz wpisać tylko pensje z lat, które pamiętasz. Trzymaj się albo brutto, albo netto, a porównanie będzie dokładne. Kwoty są w walucie %@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan nöja dig med att ange lönerna för de år du minns. Håll dig till antingen brutto eller netto så blir jämförelsen exakt. Belopp är i valutan %@."
          }
        }
      }
    },
    "기억나는 해의 월급을 두 개 이상 넣으면\n물가를 뺀 구매력 변화가 보여요." : {
      "comment" : "A description of the effect of adding multiple salary records.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter salaries from two or more years\nto see your purchasing power after inflation."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter salaries from two or more years\nto see your purchasing power after inflation."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "覚えている年の給料を2つ以上入れると、\n物価を除いた購買力の変化がわかります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "填入两个或更多年份的月薪，\n就能看到扣除物价后的购买力变化。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "填入兩個或更多年份的月薪，\n就能看到扣除物價後的購買力變化。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce sueldos de dos o más años\npara ver tu poder adquisitivo descontando la inflación."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trag Gehälter aus zwei oder mehr Jahren ein,\num die inflationsbereinigte Kaufkraft zu sehen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez les salaires de deux années ou plus\npour voir l’évolution du pouvoir d’achat hors inflation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci gli stipendi di due o più anni\nper vedere il potere d’acquisto al netto dell’inflazione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
