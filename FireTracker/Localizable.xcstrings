      }
    },
    "퇴사각 프로를 쓰고 있어요. 모든 기능이 열려 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have FireTracker Pro. Everything is unlocked."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "퇴사각 프로를 쓰고 있어요. 모든 기능이 열려 있어요."
          }
        }
      }
    },
    "퇴사각 프로에서 위젯을 켤 수 있어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock the widget with FireTracker Pro"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "퇴사각 프로에서 위젯을 켤 수 있어요"
          }
        }
      }
    },
    "퇴사까지": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until I Quit"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "퇴사까지"
          }
        }
      }
    },
    "퇴사하는 날의 나를 미리 봐요. 건강보험료·국민연금까지 넣은 진짜 생활비, 그 돈이 몇 살까지 버틸 확률, 세금이 가장 적은 인출 순서, 다른 선택을 했을 때의 미래까지.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See yourself on the day you quit: real living costs with health insurance and pension, the chance your money lasts, the withdrawal order with the least tax, and how other choices change your future."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "퇴사하는 날의 나를 미리 봐요. 건강보험료·국민연금까지 넣은 진짜 생활비, 그 돈이 몇 살까지 버틸 확률, 세금이 가장 적은 인출 순서, 다른 선택을 했을 때의 미래까지."
          }
        }
      }
    },
    "퇴사할 수 있는 날까지 남은 시간을 보여줘요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows how long until you can quit."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "퇴사할 수 있는 날까지 남은 시간을 보여줘요."
          }
        }
      }
    },
    "투자": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invest"
          }
        },
        "ko": {
