    "티커/종목코드(ETF 포함)를 먼저 넣고 칸을 벗어나면 이름이 자동으로 채워지고, ‘시세 자동’으로 현재가도 불러올 수 있어요. 미국=Finnhub, 국내=Yahoo. 비워두면 직접 입력합니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejprve zadejte ticker nebo kód akcie (i ETF) a opusťte pole — název se doplní sám a „Automatická cena“ načte aktuální kurz. USA = Finnhub, Korea = Yahoo. Když pole necháte prázdné, zadáte vše ručně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angiv først ticker eller aktiekode (også ETF). Når du forlader feltet, udfyldes navnet automatisk, og med „Automatisk kurs“ kan du hente den aktuelle pris. USA = Finnhub, Korea = Yahoo. Lad feltet være tomt for at indtaste manuelt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib zuerst Kürzel oder Aktiencode (auch ETF) ein. Wenn du das Feld verlässt, wird der Name automatisch ergänzt, und mit „Auto-Kurs“ lässt sich auch der aktuelle Kurs abrufen. USA = Finnhub, Korea = Yahoo. Leer lassen, um manuell einzugeben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βάλτε πρώτα ticker/κωδικό μετοχής (και ETF) και βγείτε από το πεδίο: το όνομα συμπληρώνεται αυτόματα και με την «Αυτόματη τιμή» φορτώνετε και την τρέχουσα τιμή. ΗΠΑ=Finnhub, Κορέα=Yahoo. Αν το αφήσετε κενό, τα βάζετε χειροκίνητα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter the ticker or stock code (ETFs included) first and leave the field to fill in the name automatically; ‘Auto price’ can also fetch the current price. US = Finnhub, Korea = Yahoo. Leave it blank to enter values yourself."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter the ticker or stock code (ETFs included) first and leave the field to fill in the name automatically; ‘Auto price’ can also fetch the current price. US = Finnhub, Korea = Yahoo. Leave it blank to enter values yourself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe primero el ticker o código del valor (ETF incluidos) y, al salir del campo, el nombre se rellena solo; con «Precio automático» también se carga el precio actual. EE. UU. = Finnhub, Corea = Yahoo. Si lo dejas vacío, lo introduces a mano."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syötä ensin tikkeri tai osakekoodi (myös ETF:t) ja siirry pois kentästä, niin nimi täyttyy automaattisesti, ja ”Automaattinen hinta” voi hakea nykyisen hinnan. USA = Finnhub, Korea = Yahoo. Tyhjänä syötät tiedot itse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez d’abord le ticker ou le code (ETF compris) puis quittez le champ : le nom se remplit tout seul, et « Cours automatique » récupère le prix actuel. US = Finnhub, Corée = Yahoo. Laissez vide pour saisir à la main."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan ticker/kode saham (termasuk ETF) dulu lalu keluar dari kolom, nama akan terisi otomatis, dan ‘Harga otomatis’ bisa memuat harga terkini. AS=Finnhub, Korea=Yahoo. Biarkan kosong untuk mengisi sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci prima il ticker o il codice titolo (ETF inclusi): uscendo dal campo il nome si compila da solo e con «Prezzo automatico» puoi scaricare anche il prezzo attuale. USA=Finnhub, Corea=Yahoo. Se lo lasci vuoto, inserisci a mano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ティッカー・銘柄コード（ETFを含む）を先に入れて欄を離れると名前が自動で入り、「自動価格」で現在値も取得できます。米国＝Finnhub、韓国＝Yahoo。空欄なら手入力になります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv først inn ticker eller aksjekode (også ETF). Når du forlater feltet, fylles navnet inn automatisk, og med «Automatisk kurs» kan du hente gjeldende pris. USA = Finnhub, Korea = Yahoo. La feltet stå tomt for å skrive inn manuelt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vul eerst de ticker of code in (ook ETF's) en verlaat het veld: de naam wordt automatisch ingevuld en met ‘Automatische koers’ haal je ook de huidige prijs op. VS = Finnhub, Korea = Yahoo. Laat je het leeg, dan vul je het zelf in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz najpierw ticker lub kod akcji (także ETF) i wyjdź z pola — nazwa uzupełni się sama, a „Cena automatyczna” pobierze bieżący kurs. USA = Finnhub, Korea = Yahoo. Jeśli zostawisz puste, wpiszesz ręcznie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informe primeiro o ticker ou código (inclusive ETFs) e saia do campo: o nome é preenchido sozinho, e com “Preço automático” você também busca o preço atual. EUA = Finnhub, Coreia = Yahoo. Deixe em branco para digitar à mão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите тикер или код акции (включая ETF) и выйдите из поля — название заполнится само, а «Автоцена» подтянет текущую цену. США = Finnhub, Корея = Yahoo. Если оставить пустым, вводите вручную."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ange först ticker eller aktiekod (även ETF). När du lämnar fältet fylls namnet i automatiskt, och med ”Automatisk kurs” kan du hämta aktuellt pris. USA = Finnhub, Korea = Yahoo. Lämna tomt för att ange manuellt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กรอกชื่อย่อหรือรหัสหลักทรัพย์ (รวม ETF) ก่อน แล้วออกจากช่อง ชื่อจะถูกเติมให้อัตโนมัติ และดึงราคาปัจจุบันได้ด้วย “ราคาอัตโนมัติ” สหรัฐฯ = Finnhub, เกาหลี = Yahoo ถ้าเว้นว่างไว้ ให้กรอกเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembolü/hisse kodunu (ETF dahil) girip alandan çıkınca ad otomatik dolar; ‘Otomatik fiyat’ ile güncel fiyatı da çekebilirsiniz. ABD=Finnhub, Kore=Yahoo. Boş bırakırsanız elle girersiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập mã chứng khoán (kể cả ETF) trước rồi rời ô, tên sẽ tự điền và có thể lấy giá hiện tại bằng ‘Giá tự động’. Mỹ = Finnhub, Hàn Quốc = Yahoo. Để trống thì nhập tay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先填入Ticker/股票代码（含ETF），离开输入框后会自动填好名称，还能用“自动行情”获取现价。美股=Finnhub，韩股=Yahoo。留空则手动填写。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先輸入股票代號（含ETF），離開欄位後會自動填入名稱，還能用「自動行情」取得現價。美股=Finnhub，韓股=Yahoo。留空則手動輸入。"
          }
        }
      }
