    "원금균등 — 원금을 매달 같은 만큼 갚아 첫 달 부담이 크지만, 총 이자는 원리금균등보다 적어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equal principal — you repay the same principal each month, so the first month is the heaviest, but total interest is lower than with equal payments."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equal principal — you repay the same principal each month, so the first month is the heaviest, but total interest is lower than with equal payments."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元金均等 — 元本を毎月同じ額ずつ返すので最初の月の負担は大きいですが、利息総額は元利均等より少なくなります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等额本金 — 每月偿还相同的本金，首月压力较大，但总利息比等额本息少。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本金平均攤還 — 每月償還相同的本金，第一個月負擔較重，但總利息比本息平均攤還少。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amortización constante: devuelves la misma parte del principal cada mes. El primer mes cuesta más, pero pagas menos intereses en total que con cuota constante."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gleiche Tilgung – du tilgst jeden Monat den gleichen Kapitalbetrag. Der erste Monat ist am teuersten, aber die Zinsen gesamt sind niedriger als bei der Annuität."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amortissement constant — vous remboursez la même part de capital chaque mois : le premier mois est plus lourd, mais les intérêts totaux sont inférieurs aux mensualités constantes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capitale costante: rimborsi ogni mese la stessa quota di capitale. Il primo mese pesa di più, ma gli interessi totali sono inferiori alla rata costante."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amortização constante (SAC) — você quita a mesma parte do principal todo mês. O começo pesa mais, mas o juro total é menor que nas parcelas iguais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Равные доли долга — основной долг гасится равными частями: первый платёж выше, но процентов всего меньше, чем при аннуитете."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เงินต้นเท่ากันทุกงวด — ผ่อนเงินต้นเท่ากันทุกเดือน เดือนแรกภาระหนัก แต่ดอกเบี้ยรวมน้อยกว่าแบบผ่อนเท่ากันทุกงวด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trả đều gốc — mỗi tháng trả gốc như nhau nên tháng đầu nặng hơn, nhưng tổng lãi ít hơn trả đều gốc và lãi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rovnoměrná jistina — jistinu splácíte každý měsíc stejným dílem, takže první splátka je vyšší, ale úroků zaplatíte méně než u anuity."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serielån – du afdrager lige meget af hovedstolen hver måned, så første måned er tungest, men de samlede renter bliver lavere end ved annuitet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ίσο κεφάλαιο — αποπληρώνετε το ίδιο κεφάλαιο κάθε μήνα, οπότε ο πρώτος μήνας είναι βαρύτερος, αλλά οι συνολικοί τόκοι είναι μικρότεροι από τις ίσες δόσεις."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasalyhennys — pääomaa lyhennetään joka kuukausi sama määrä, joten ensimmäinen kuukausi on raskain, mutta korkoja kertyy vähemmän kuin annuiteetissa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokok tetap — pokok dibayar sama rata tiap bulan, jadi bulan pertama paling berat, tapi total bunganya lebih kecil daripada cicilan tetap."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serielån – du betaler ned like mye av hovedstolen hver måned, så første måned er tyngst, men samlet rente blir lavere enn med annuitetslån."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lineair: je lost elke maand evenveel af, dus de eerste maand is zwaarder, maar de totale rente is lager dan bij annuïteit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raty malejące — kapitał spłacasz co miesiąc w równych częściach, więc pierwsza rata jest wyższa, ale odsetek płacisz mniej niż przy ratach równych."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rak amortering – du betalar av lika mycket av kapitalet varje månad, så första månaden är tyngst, men den totala räntan blir lägre än med annuitet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eşit anapara — anaparayı her ay eşit öder; ilk ay yük ağırdır ama toplam faiz eşit taksitten azdır."
          }
        }
      }
    },
