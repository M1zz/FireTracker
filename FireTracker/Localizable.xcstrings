        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你有一陣子沒看目標了。這段時間有什麼變化？請在計算頁再照一照你的滿足點。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hace tiempo que no miras tu objetivo. ¿Qué ha cambiado desde entonces? Vuelve a mirar tu punto de satisfacción en la pestaña Calcular."
