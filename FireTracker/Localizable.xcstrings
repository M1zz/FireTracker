    "기록을 저장할수록 이번 달 안의 변화가 촘촘하게 그려져요." : {
      "comment" : "A description of the trend view's disclaimer.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The more records you save, the more detail you'll see in this month's changes."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The more records you save, the more detail you'll see in this month's changes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録を保存するほど、今月の中の変化が細かく描かれます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存的记录越多，本月内的变化就画得越细致。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儲存的記錄越多，本月內的變化就畫得越細緻。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuantos más registros guardes, más detallados se dibujan los cambios dentro de este mes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je mehr Einträge du speicherst, desto feiner zeichnen sich die Veränderungen in diesem Monat ab."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus vous enregistrez, plus les variations de ce mois sont dessinées finement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più registrazioni salvi, più i cambiamenti di questo mese vengono disegnati nel dettaglio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto mais registros você salva, mais detalhadas ficam as mudanças deste mês."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чем больше записей, тем подробнее рисуются изменения внутри этого месяца."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยิ่งบันทึกมาก การเปลี่ยนแปลงภายในเดือนนี้ก็ยิ่งละเอียด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Càng lưu nhiều bản ghi, biến động trong tháng này càng được vẽ chi tiết."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čím víc záznamů uložíte, tím podrobněji se vykreslí změny v tomto měsíci."
