    "주 투입시간엔 근무만이 아니라 출퇴근·준비·업무 생각까지 넣어야 정직한 시급이 나와요." : {
      "comment" : "A description of the time-based wage calculation.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For an honest hourly wage, weekly hours should include not just work but commuting, getting ready and thinking about work."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For an honest hourly wage, weekly hours should include not just work but commuting, getting ready and thinking about work."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正直な時給を出すには、週の投入時間に勤務だけでなく通勤・準備・仕事のことを考える時間まで含める必要があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要算出真实的时薪，每周投入时间不能只算上班，还要包括通勤、准备以及想着工作的时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要算出真實的時薪，每週投入時間不能只算上班，還要包括通勤、準備以及想著工作的時間。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para un sueldo por hora honesto, las horas semanales deben incluir no solo el trabajo, sino el trayecto, la preparación y el tiempo pensando en el trabajo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für einen ehrlichen Stundenlohn gehören zur Wochenzeit nicht nur die Arbeit, sondern auch Pendeln, Vorbereitung und Gedanken an die Arbeit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour un salaire horaire honnête, les heures hebdomadaires doivent inclure non seulement le travail, mais aussi le trajet, la préparation et le temps passé à penser au travail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per una paga oraria onesta, le ore settimanali devono includere non solo il lavoro ma anche tragitto, preparazione e pensieri sul lavoro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para um valor-hora honesto, as horas semanais devem incluir não só o trabalho, mas o deslocamento, a preparação e o tempo pensando no trabalho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для честной почасовой ставки в недельные часы нужно включать не только работу, но и дорогу, сборы и мысли о работе."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ค่าแรงต่อชั่วโมงที่ตรงไปตรงมาต้องรวมเวลาต่อสัปดาห์ไม่ใช่แค่ทำงาน แต่รวมเดินทาง เตรียมตัว และคิดเรื่องงานด้วย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muốn có lương giờ trung thực, số giờ mỗi tuần phải gồm không chỉ giờ làm việc mà cả đi lại, chuẩn bị và thời gian nghĩ về công việc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro poctivou hodinovou sazbu musí týdenní čas zahrnovat nejen práci, ale i dojíždění, přípravu a přemýšlení o práci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For en ærlig timeløn skal ugentlig tid ikke kun omfatte arbejdet, men også pendling, forberedelse og at tænke på arbejdet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για ειλικρινές ωρομίσθιο, οι εβδομαδιαίες ώρες πρέπει να περιλαμβάνουν όχι μόνο τη δουλειά αλλά και τη μετακίνηση, την προετοιμασία και τη σκέψη για τη δουλειά."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rehellistä tuntipalkkaa varten viikkotuntien tulee sisältää työn lisäksi työmatka, valmistautuminen ja työasioiden miettiminen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk upah per jam yang jujur, jam mingguan harus mencakup bukan hanya kerja, tetapi juga perjalanan, persiapan, dan memikirkan pekerjaan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For en ærlig timelønn må ukentlig tid ikke bare omfatte arbeidet, men også pendling, forberedelser og tanker om jobben."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor een eerlijk uurloon moeten de uren per week niet alleen werk omvatten, maar ook woon-werkverkeer, voorbereiding en piekeren over werk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dla uczciwej stawki godzinowej godziny tygodniowe muszą obejmować nie tylko pracę, ale też dojazd, przygotowanie i myślenie o pracy."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För en ärlig timlön måste veckotiden inkludera inte bara arbetet utan även pendling, förberedelser och tankar på jobbet."
          }
        }
      }
    },
    "주식·코인·부동산·전세·현금 등\n보유한 자산을 목록으로 만들어 추적합니다." : {
      "comment" : "A description of the purpose of the AssetsView.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Track the assets you hold as a list —\nstocks, crypto, property, jeonse, cash and more."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Track the assets you hold as a list —\nstocks, crypto, property, jeonse, cash and more."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "株式・暗号資産・不動産・全貸・現金など、\n保有する資産を一覧にして追跡します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把你持有的资产做成列表来追踪——\n股票、加密货币、房产、全租、现金等。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把你持有的資產做成列表來追蹤——\n股票、加密貨幣、房產、全租、現金等。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz un seguimiento en lista de los activos que tienes:\nacciones, criptomonedas, inmuebles, jeonse, efectivo y más."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfolge dein Vermögen als Liste –\nAktien, Krypto, Immobilien, Jeonse, Bargeld und mehr."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez vos actifs sous forme de liste :\nactions, cryptos, immobilier, jeonse, liquidités et plus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni traccia delle attività che possiedi in un elenco:\nazioni, cripto, immobili, jeonse, contanti e altro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acompanhe os ativos que você tem em uma lista:\nações, cripto, imóveis, jeonse, dinheiro e mais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ведите список своих активов —\nакции, крипта, недвижимость, чонсе, наличные и другое."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ติดตามสินทรัพย์ที่ถือเป็นรายการ —\nหุ้น คริปโต อสังหาริมทรัพย์ ช็อนเซ เงินสด และอื่นๆ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Theo dõi tài sản bạn đang giữ dưới dạng danh sách —\ncổ phiếu, tiền mã hóa, bất động sản, jeonse, tiền mặt, v.v."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sledujte svůj majetek v seznamu –\nakcie, krypto, nemovitosti, jeonse, hotovost a další."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Følg de aktiver, du har, på en liste –\naktier, krypto, ejendom, jeonse, kontanter og mere."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παρακολουθήστε τα περιουσιακά στοιχεία που κατέχετε σε λίστα —\nμετοχές, κρυπτονομίσματα, ακίνητα, jeonse, μετρητά και άλλα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuraa omistamiasi varoja listana –\nosakkeet, kryptot, kiinteistöt, jeonse, käteinen ja muuta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lacak aset yang Anda miliki sebagai daftar —\nsaham, kripto, properti, jeonse, tunai, dan lainnya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Følg eiendelene du har som en liste –\naksjer, krypto, eiendom, jeonse, kontanter og mer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd de bezittingen die je hebt bij als lijst –\naandelen, crypto, vastgoed, jeonse, contant geld en meer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Śledź posiadane aktywa jako listę –\nakcje, krypto, nieruchomości, jeonse, gotówka i inne."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Följ de tillgångar du har som en lista –\naktier, krypto, fastigheter, jeonse, kontanter och mer."
          }
        }
      }
    },
    "주식·펀드·코인을 열어 ‘팔 원칙’을 정하면 여기에 모여요." : {
      "comment" : "A description of the view that shows when the user has no sell signals.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open a stock, fund or crypto and set a ‘sell rule’ and it gathers here."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open a stock, fund or crypto and set a ‘sell rule’ and it gathers here."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "株式・ファンド・暗号資産を開いて「売るルール」を決めると、ここに集まります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开股票、基金或加密货币设定“卖出原则”，就会汇总到这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟股票、基金或加密貨幣設定「賣出原則」，就會彙總到這裡。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre una acción, fondo o criptomoneda y fija una «regla de venta» y se reunirá aquí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne eine Aktie, einen Fonds oder Krypto und lege eine „Verkaufsregel“ fest, dann sammelt sie sich hier."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
