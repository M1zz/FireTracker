    "%@을 받아 연 %@로 굴리면 %@이 되지만, 그때 시급은 %@이에요. 되사면 %@, 체력 할인까지 넣으면 %@이에요." : {
      "comment" : "A comparison of the value of a given time in the future (when the time is sold) and the value of the time if it is not sold. The first argument is the string “0원” or the string “%arg원”. The second argument is the number of hours the time is worth if not sold. The third argument is the string “0원” or the string “%arg원”. The fourth argument is the string “0원” or the string “%arg원”. The fifth argument is the string “0시간”, the string “%arg시간”, or the string “%arg시간”. The sixth argument is the string “0시간”, the string “%arg시간”, or the string “%arg시간”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když dostanete %@ a zhodnotíte to na %@ ročně, bude z toho %@, ale vaše hodinová sazba bude tehdy %@. Odkoupení stojí %@, se slevou za kondici %@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modtager du %@ og investerer det med %@ om året, bliver det til %@, men din timeløn er da %@. At købe tiden tilbage koster %@, eller %@ med formsrabat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekommst du %@ und legst es mit %@ pro Jahr an, wird daraus %@ – dein Stundenlohn liegt dann aber bei %@. Zurückkaufen kostet %@, mit Fitness-Abschlag %@."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν λάβετε %@ και το επενδύσετε με %@ ετησίως, γίνεται %@, αλλά τότε το ωρομίσθιό σας θα είναι %@. Η επαναγορά κοστίζει %@, ή %@ με την έκπτωση φυσικής κατάστασης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take %@ and grow it at %@ a year and it becomes %@ — but your hourly wage then is %@. Buying the hour back costs %@, or %@ with a stamina discount."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take %@ and grow it at %@ a year and it becomes %@ — but your hourly wage then is %@. Buying the hour back costs %@, or %@ with a stamina discount."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si recibes %@ y lo inviertes al %@ anual, se convierte en %@, pero tu sueldo por hora entonces será %@. Recomprarla cuesta %@, o %@ con el descuento por salud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos saat %@ ja sijoitat sen %@ vuosituotolla, siitä tulee %@, mutta tuntipalkkasi on silloin %@. Takaisinosto maksaa %@, tai %@ kuntoalennuksella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous recevez %@ et le placez à %@ par an, cela devient %@, mais votre salaire horaire sera alors de %@. Le racheter coûte %@, ou %@ avec la décote de forme physique."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika menerima %@ lalu diinvestasikan dengan %@ per tahun, jadi %@, tetapi upah per jam Anda saat itu %@. Membeli kembali butuh %@, atau %@ dengan diskon kebugaran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ricevi %@ e lo investi al %@ annuo diventa %@, ma la tua paga oraria sarà allora %@. Ricomprarlo costa %@, o %@ con lo sconto forma fisica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を受け取って年%@で運用すると%@になりますが、そのときの時給は%@です。買い戻すと%@、体力の割引まで入れると%@です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@을 받아 연 %2$@로 굴리면 %3$@이 되지만, 그때 시급은 %4$@이에요. 되사면 %5$@, 체력 할인까지 넣으면 %6$@이에요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Får du %@ og investerer det med %@ i året, blir det %@, men timelønnen din er da %@. Å kjøpe tiden tilbake koster %@, eller %@ med formsrabatt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontvang je %@ en belegg je dat tegen %@ per jaar, dan wordt het %@, maar je uurloon is dan %@. Terugkopen kost %@, of %@ met de fitheidskorting."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli otrzymasz %@ i zainwestujesz po %@ rocznie, wyniesie to %@, ale twoja stawka godzinowa będzie wtedy %@. Odkupienie kosztuje %@, a ze zniżką za kondycję %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você receber %@ e investir a %@ ao ano, vira %@, mas seu valor-hora nessa época será %@. Recomprar custa %@, ou %@ com o desconto de disposição."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Получив %@ и вложив под %@ годовых, вы получите %@, но ваша почасовая ставка тогда будет %@. Выкупить час стоит %@, а со скидкой на здоровье — %@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Får du %@ och placerar det med %@ per år blir det %@, men din timlön är då %@. Att köpa tillbaka kostar %@, eller %@ med konditionsrabatt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้าได้รับ %@ แล้วนำไปลงทุนปีละ %@ จะกลายเป็น %@ แต่ตอนนั้นค่าแรงต่อชั่วโมงจะเป็น %@ ซื้อเวลาคืนต้องใช้ %@ หรือ %@ เมื่อรวมส่วนลดเรื่องสุขภาพ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ alıp yıllık %@ ile değerlendirirseniz %@ olur, ama o zamanki saatlik ücretiniz %@. Geri satın almak %@, form indirimiyle %@."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu nhận %@ rồi đầu tư với lãi %@ mỗi năm sẽ thành %@, nhưng lương theo giờ khi đó là %@. Mua lại tốn %@, hoặc %@ nếu tính cả chiết khấu thể lực."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拿到%@后按年%@投资会变成%@，但那时的时薪是%@。买回需要%@，再算上体力折扣是%@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拿到%@後按年%@投資會變成%@，但那時的時薪是%@。買回需要%@，再算上體力折扣是%@。"
          }
        }
      }
    },
