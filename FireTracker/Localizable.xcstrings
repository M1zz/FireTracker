    "자산이 버는 시급이 내 한계 시급을 넘었어요. 시간을 팔지 않아도 되는 구간이에요." : {
      "comment" : "A description of the point where your real-world wage (`marginalWage`) is",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What your assets earn per hour has passed your marginal wage. You're in the zone where you don't have to sell your time."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What your assets earn per hour has passed your marginal wage. You're in the zone where you don't have to sell your time."
