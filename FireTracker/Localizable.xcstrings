    "국내·미국 주식, 암호화폐, 환율은 아무것도 넣지 않아도 시세를 자동으로 불러와요. 이 키는 아파트 시세를 자동으로 받고 싶을 때만 필요해요(국토교통부 실거래가, 무료)." : {
      "comment" : "A footer for the API section of the settings view.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korean and US stocks, crypto and exchange rates fetch prices automatically with nothing entered. This key is only needed if you want apartment prices fetched automatically (Ministry of Land transaction prices, free)."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korean and US stocks, crypto and exchange rates fetch prices automatically with nothing entered. This key is only needed if you want flat prices fetched automatically (Ministry of Land transaction prices, free)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "韓国・米国の株式、暗号資産、為替レートは何も入力しなくても自動で価格を取得します。このキーは、マンションの相場を自動で取得したいときだけ必要です（国土交通部の実取引価格、無料）。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "韩国和美国股票、加密货币、汇率无需填写任何内容即可自动获取行情。只有想自动获取公寓行情时才需要这个密钥（国土交通部实际成交价，免费）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "韓國和美國股票、加密貨幣、匯率無需填寫任何內容即可自動獲取行情。只有想自動獲取公寓行情時才需要這個金鑰（國土交通部實際成交價，免費）。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las acciones coreanas y estadounidenses, las criptomonedas y los tipos de cambio obtienen precios automáticamente sin introducir nada. Esta clave solo hace falta si quieres obtener automáticamente los precios de apartamentos (precios de transacción del Ministerio de Territorio, gratis)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koreanische und US-Aktien, Kryptowährungen und Wechselkurse holen ihre Kurse automatisch, ganz ohne Eingabe. Dieser Schlüssel ist nur nötig, wenn du Wohnungspreise automatisch beziehen willst (Transaktionspreise des Bodenministeriums, kostenlos)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les actions coréennes et américaines, les cryptomonnaies et les taux de change récupèrent leurs cours automatiquement, sans rien saisir. Cette clé n’est utile que pour obtenir automatiquement les prix des appartements (prix de transaction du ministère du Territoire, gratuit)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Azioni coreane e statunitensi, criptovalute e tassi di cambio ottengono i prezzi in automatico senza inserire nulla. Questa chiave serve solo se vuoi i prezzi degli appartamenti in automatico (prezzi di compravendita del Ministero del Territorio, gratis)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ações coreanas e americanas, criptomoedas e câmbio buscam preços automaticamente, sem você preencher nada. Esta chave só é necessária se você quiser buscar automaticamente preços de apartamentos (preços de transação do Ministério do Território, grátis)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Корейские и американские акции, криптовалюты и курсы валют загружают цены автоматически, ничего вводить не нужно. Этот ключ нужен только для автоматических цен на квартиры (цены сделок Минземтранса, бесплатно)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หุ้นเกาหลีและสหรัฐฯ คริปโต และอัตราแลกเปลี่ยน ดึงราคาอัตโนมัติโดยไม่ต้องกรอกอะไร คีย์นี้จำเป็นเฉพาะเมื่อต้องการดึงราคาอพาร์ตเมนต์อัตโนมัติ (ราคาซื้อขายจริงของกระทรวงที่ดิน ฟรี)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cổ phiếu Hàn Quốc và Mỹ, tiền mã hóa và tỷ giá tự động lấy giá mà không cần nhập gì. Khóa này chỉ cần khi bạn muốn tự động lấy giá căn hộ (giá giao dịch của Bộ Đất đai, miễn phí)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korejské a americké akcie, kryptoměny a kurzy stahují ceny automaticky, aniž byste cokoli zadávali. Tento klíč je potřeba jen pro automatické ceny bytů (transakční ceny ministerstva půdy, zdarma)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koreanske og amerikanske aktier, kryptovaluta og valutakurser henter kurser automatisk uden at du skriver noget. Denne nøgle er kun nødvendig, hvis du vil hente lejlighedspriser automatisk (handelspriser fra Jordministeriet, gratis)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι κορεατικές και αμερικανικές μετοχές, τα κρυπτονομίσματα και οι ισοτιμίες φέρνουν τιμές αυτόματα χωρίς να βάλετε τίποτα. Αυτό το κλειδί χρειάζεται μόνο αν θέλετε αυτόματες τιμές διαμερισμάτων (τιμές συναλλαγών του Υπουργείου Εδάφους, δωρεάν)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korealaiset ja yhdysvaltalaiset osakkeet, kryptot ja valuuttakurssit hakevat hinnat automaattisesti ilman mitään syöttöä. Tätä avainta tarvitaan vain, jos haluat asuntojen hinnat automaattisesti (Maaministeriön kauppahinnat, ilmainen)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saham Korea dan AS, kripto, dan kurs mengambil harga otomatis tanpa perlu mengisi apa pun. Kunci ini hanya diperlukan jika Anda ingin harga apartemen otomatis (harga transaksi Kementerian Pertanahan, gratis)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koreanske og amerikanske aksjer, kryptovaluta og valutakurser henter kurser automatisk uten at du skriver noe. Denne nøkkelen trengs bare hvis du vil hente leilighetspriser automatisk (handelspriser fra Landministeriet, gratis)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koreaanse en Amerikaanse aandelen, crypto en wisselkoersen halen koersen automatisch op zonder dat je iets invult. Deze sleutel is alleen nodig als je appartementsprijzen automatisch wilt ophalen (transactieprijzen van het ministerie van Grondzaken, gratis)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akcje koreańskie i amerykańskie, kryptowaluty i kursy walut pobierają ceny automatycznie, bez wpisywania czegokolwiek. Ten klucz jest potrzebny tylko, jeśli chcesz automatycznie pobierać ceny mieszkań (ceny transakcyjne Ministerstwa Gruntów, bezpłatne)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koreanska och amerikanska aktier, krypto och valutakurser hämtar kurser automatiskt utan att du anger något. Den här nyckeln behövs bara om du vill hämta lägenhetspriser automatiskt (transaktionspriser från Markministeriet, gratis)."
          }
        }
      }
    },
