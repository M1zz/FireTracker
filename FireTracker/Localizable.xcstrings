    "대략적인 숫자면 충분해요. 나중에 언제든 고칠 수 있어요." : {
      "comment" : "A description of the disclaimer.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rough numbers are fine. You can change them any time."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rough numbers are fine. You can change them any time."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おおよその数字で十分です。あとからいつでも直せます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大概的数字就够了。之后随时可以修改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大概的數字就夠了。之後隨時可以修改。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con cifras aproximadas basta. Podrás corregirlas cuando quieras."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grobe Zahlen reichen. Du kannst sie jederzeit ändern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des chiffres approximatifs suffisent. Vous pourrez les corriger à tout moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bastano numeri approssimativi. Potrai correggerli quando vuoi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Números aproximados bastam. Você pode corrigir quando quiser."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Достаточно приблизительных чисел. Позже их можно исправить."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัวเลขคร่าวๆ ก็พอ แก้ภายหลังได้ทุกเมื่อ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con số gần đúng là đủ. Bạn có thể sửa bất cứ lúc nào."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stačí přibližná čísla. Kdykoli je můžete opravit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ca.-tal er nok. Du kan altid rette dem senere."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αρκούν κατά προσέγγιση αριθμοί. Μπορείτε να τους διορθώσετε οποτεδήποτε."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Likimääräiset luvut riittävät. Voit korjata ne milloin tahansa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angka perkiraan sudah cukup. Anda bisa memperbaikinya kapan saja."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omtrentlige tall holder. Du kan rette dem senere når som helst."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Globale cijfers zijn genoeg. Je kunt ze altijd later corrigeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wystarczą przybliżone liczby. Zawsze możesz je później poprawić."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ungefärliga siffror räcker. Du kan rätta dem när som helst."
          }
        }
      }
    },
    "대비를 높이거나 색을 구별하기 어려워도 내용을 알아볼 수 있어요." : {
      "comment" : "Roadmap item detail: contrast and color",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything stays readable, even with Increase Contrast on or if colors are hard to tell apart."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대비를 높이거나 색을 구별하기 어려워도 내용을 알아볼 수 있어요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything stays readable, even with Increase Contrast on or if colours are hard to tell apart."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントラストを上げたり、色の区別が難しくても、内容を読み取れます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使调高对比度或难以分辨颜色，也能看清内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使調高對比度或難以分辨顏色，也能看清內容。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo sigue siendo legible, incluso con Aumentar contraste activado o si te cuesta distinguir los colores."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles bleibt lesbar, auch mit erhöhtem Kontrast oder wenn Farben schwer zu unterscheiden sind."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout reste lisible, même avec Augmenter le contraste ou si les couleurs sont difficiles à distinguer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto resta leggibile, anche con Aumenta contrasto attivo o se fai fatica a distinguere i colori."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo continua legível, mesmo com Aumentar contraste ligado ou se você tem dificuldade para distinguir cores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё остаётся читаемым, даже при включённой повышенной контрастности или если трудно различать цвета."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังอ่านเนื้อหาได้ แม้เปิดเพิ่มคอนทราสต์หรือแยกสีได้ยาก"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi thứ vẫn đọc được, kể cả khi bật Tăng độ tương phản hoặc khó phân biệt màu."
          }
        },
        "cs" : {
