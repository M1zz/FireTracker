    },
    "구매력 탭에 적어 둔 %lld년 월급 %@을 쓰고 있어요. 근로시간만 넣으면 시급이 나와요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používáme mzdu z roku %lld (%@) z karty kupní síly. Zadejte jen pracovní hodiny a sazba je hotová."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruger lønnen for %lld, %@, fra fanen Købekraft. Angiv bare arbejdstiden, så får du timelønnen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir nutzen dein Gehalt von %lld aus dem Kaufkraft-Tab (%@). Gib nur noch deine Arbeitszeit ein, dann siehst du deinen Stundenlohn."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιείται ο μισθός %lld (%@) από την καρτέλα Αγοραστική δύναμη. Βάλτε μόνο τις ώρες εργασίας για να βγει το ωρομίσθιο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Using your %lld salary of %@ from the Buying Power tab. Just add your working hours to get your hourly wage."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Using your %lld salary of %@ from the Buying Power tab. Just add your working hours to get your hourly wage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa el sueldo de %lld (%@) que anotaste en Poder adquisitivo. Solo añade tus horas de trabajo y verás tu valor por hora."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytössä Ostovoima-välilehdelle kirjaamasi vuoden %lld kuukausipalkka %@. Syötä vain työtunnit, niin saat tuntipalkan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
