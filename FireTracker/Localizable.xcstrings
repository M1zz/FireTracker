          }
        }
      }
    },
    "내 시급으로 돈을 시간으로 바꿔 보고, 저축이 시급을 넘는 시점을 찾아요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přepočtěte peníze na hodiny podle své hodinové sazby a najděte okamžik, kdy úspory předstihnou práci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
