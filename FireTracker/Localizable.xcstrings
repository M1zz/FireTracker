    },
    "알아보기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learn More"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알아보기"
          }
        }
      }
    },
    "약 %@ 뒤": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In about %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약 %@ 뒤"
          }
        }
      }
    },
    "언제 몇 주를 얼마에 샀는지 남기면 평단과 실현 손익이 자동으로 계산돼요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log when you bought how many shares at what price, and your average cost and realized gains are calculated for you."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언제 몇 주를 얼마에 샀는지 남기면 평단과 실현 손익이 자동으로 계산돼요."
          }
        }
      }
    },
    "언제 퇴사할 수 있는지 계산해 볼까요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready to find out when you can quit?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언제 퇴사할 수 있는지 계산해 볼까요?"
          }
        }
      }
    },
    "여정 탭 오른쪽 위 과녁에서 목표 생활비·나이 입력": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter living costs and age from the target icon in the Journey tab"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여정 탭 오른쪽 위 과녁에서 목표 생활비·나이 입력"
          }
        }
      }
    },
    "예금·적금 만기에 얼마를 받는지, 이자에 세금은 얼마인지 계산해요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work out what a deposit or savings plan pays at maturity, and the tax on its interest."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예금·적금 만기에 얼마를 받는지, 이자에 세금은 얼마인지 계산해요."
          }
        }
      }
    },
    "월 %@원 중 %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ of %1$@ won a month"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월 %@원 중 %@"
          }
        }
      }
    },
    "월 저축 %@원 · 기대 수익률 %@ 기준": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on saving %1$@ won a month at a %2$@ expected return"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월 저축 %@원 · 기대 수익률 %@ 기준"
          }
        }
      }
    },
    "월 저축을 늘리거나 목표 생활비를 줄이면 퇴사 시점이 생겨요. 계산 탭의 생애주기에서 바꿔 볼 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save more each month or lower your target living costs to get a quit date. Try it in the Life Cycle calculator."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월 저축을 늘리거나 목표 생활비를 줄이면 퇴사 시점이 생겨요. 계산 탭의 생애주기에서 바꿔 볼 수 있어요."
          }
        }
      }
    },
    "월급 구매력": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Salary Purchasing Power"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월급 구매력"
          }
        }
      }
    },
    "이 계산으로 저장해 둔 것 %lld개": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld saved with this calculator"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계산으로 저장해 둔 것 %lld개"
          }
        }
      }
    },
    "입력값을 바탕으로 계산한 참고용 결과예요. 세금·수수료·시장 변동에 따라 실제와 다를 수 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These results are estimates based on your inputs. Taxes, fees and market moves can make reality differ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력값을 바탕으로 계산한 참고용 결과예요. 세금·수수료·시장 변동에 따라 실제와 다를 수 있습니다."
          }
        }
      }
    },
    "자산 기록, 여정, 대시보드, 생애주기 계산, 백업은 계속 무료예요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asset tracking, Journey, Dashboard, the life-cycle calculator and backups stay free."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자산 기록, 여정, 대시보드, 생애주기 계산, 백업은 계속 무료예요."
          }
        }
      }
    },
    "자산과 목표 생활비를 넣으면\n퇴사할 수 있는 시점을 알려드려요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your assets and target living costs,\nand we'll tell you when you can quit."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자산과 목표 생활비를 넣으면\n퇴사할 수 있는 시점을 알려드려요."
          }
        }
      }
    },
