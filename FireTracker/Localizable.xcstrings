        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catat satu baris setiap kali membeli, dan Anda selalu melihat berapa %@ yang dimiliki, kapan dan dengan harga berapa dibeli."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv en linje hver gang du kjøper, så ser du alltid hvor mange %@ du har, og når og til hvilken pris du kjøpte."
          }
        },
