    "새 아이폰으로 바꿔도 내 자산 기록이 iCloud로 그대로 이어져요." : {
      "comment" : "Roadmap item detail: iCloud sync",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I po výměně iPhonu vám historie majetku zůstane přes iCloud."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv om du skifter til en ny iPhone, følger din formuehistorik med via iCloud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch mit einem neuen iPhone bleibt dein Vermögensverlauf über iCloud erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ακόμα κι αν αλλάξετε iPhone, το ιστορικό της περιουσίας σας συνεχίζεται μέσω iCloud."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switch to a new iPhone and your savings history carries over through iCloud."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switch to a new iPhone and your savings history carries over through iCloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia a un iPhone nuevo y tu historial de ahorro continúa gracias a iCloud."
