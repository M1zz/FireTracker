    "외식·쇼핑처럼 시간이 돌아오지 않는 지출은 여기 넣지 않아요. 밀도와 상관이 없거든요." : {
      "comment" : "A description of the section below the time-spent-on-expenses section.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spending where the time doesn't come back, like dining out or shopping, doesn't go here. It has nothing to do with density."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spending where the time doesn't come back, like dining out or shopping, doesn't go here. It has nothing to do with density."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外食や買い物のように時間が戻ってこない支出はここに入れません。密度とは関係がないからです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像外出就餐、购物这类时间不会回来的支出不放在这里，因为与密度无关。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像外出就餐、購物這類時間不會回來的支出不放在這裡，因為與密度無關。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí no se incluyen gastos cuyo tiempo no vuelve, como salir a comer o ir de compras. No tienen que ver con la densidad."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgaben, bei denen die Zeit nicht zurückkommt, wie Essengehen oder Shoppen, gehören nicht hierher. Sie haben nichts mit der Dichte zu tun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dépenses dont le temps ne revient pas, comme les restaurants ou le shopping, n’entrent pas ici. Elles n’ont rien à voir avec la densité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le spese il cui tempo non torna, come cene fuori o shopping, non vanno qui. Non c’entrano con la densità."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gastos cujo tempo não volta, como comer fora ou fazer compras, não entram aqui. Não têm a ver com densidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Траты, время которых не возвращается, — рестораны, шопинг — сюда не входят. К плотности они отношения не имеют."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รายจ่ายที่เวลาไม่ย้อนกลับ เช่น กินข้าวนอกบ้านหรือช้อปปิ้ง ไม่ใส่ตรงนี้ เพราะไม่เกี่ยวกับความหนาแน่น"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi tiêu mà thời gian không quay lại, như ăn ngoài hay mua sắm, không đặt ở đây. Chúng không liên quan đến mật độ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výdaje, u nichž se čas nevrací, jako jídlo venku nebo nákupy, sem nepatří. S hustotou nesouvisejí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udgifter, hvor tiden ikke kommer tilbage, som restaurantbesøg eller shopping, hører ikke hjemme her. De har intet med tæthed at gøre."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δαπάνες όπου ο χρόνος δεν επιστρέφει, όπως φαγητό έξω ή ψώνια, δεν μπαίνουν εδώ. Δεν έχουν σχέση με την πυκνότητα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menoja, joiden aika ei palaa, kuten ravintolassa syönti tai ostokset, ei lasketa tähän. Ne eivät liity tiheyteen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengeluaran yang waktunya tidak kembali, seperti makan di luar atau belanja, tidak dimasukkan di sini. Tidak ada hubungannya dengan kepadatan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utgifter der tiden ikke kommer tilbake, som restaurantbesøk eller shopping, hører ikke hjemme her. De har ikke noe med tetthet å gjøre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uitgaven waarbij de tijd niet terugkomt, zoals uit eten gaan of winkelen, horen hier niet. Ze hebben niets met dichtheid te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wydatki, przy których czas nie wraca, jak jedzenie na mieście czy zakupy, nie są tu uwzględniane. Nie mają związku z gęstością."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utgifter där tiden inte kommer tillbaka, som restaurangbesök eller shopping, hör inte hemma här. De har inget med täthet att göra."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dışarıda yemek ya da alışveriş gibi zamanı geri gelmeyen harcamalar buraya konmaz. Yoğunlukla ilgisi yoktur."
          }
        }
      }
    },
