          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ở tab Tài sản, nhập tỷ suất cổ tức của cổ phiếu, tiền thuê của bất động sản hoặc lãi suất tiền gửi, thu nhập theo tháng và tuần sẽ hiện ở đây."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na kartě Majetek zadejte dividendový výnos akcie, nájem nemovitosti nebo úrok vkladu a zde se zobrazí měsíční a týdenní příjem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På fanen Aktiver indtaster du en akties udbytteprocent, en ejendoms husleje eller et indskuds rente, så vises månedlig og ugentlig indkomst her."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στην καρτέλα Περιουσιακά στοιχεία, βάλτε τη μερισματική απόδοση μιας μετοχής, το ενοίκιο ενός ακινήτου ή το επιτόκιο μιας κατάθεσης και εδώ εμφανίζεται το μηνιαίο και εβδομαδιαίο εισόδημα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syötä Varat-välilehdellä osakkeen osinkotuotto, kiinteistön vuokra tai talletuksen korko, niin kuukausi- ja viikkotulo näkyy tässä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
