    "파킹·CMA는 매일 이자가 붙어 월 복리로 근사해서 계산해요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parking accounts and CMAs earn interest daily, so we approximate with monthly compounding."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parking accounts and CMAs earn interest daily, so we approximate with monthly compounding."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パーキング口座・CMAは毎日利息がつくため、月複利で近似して計算します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "活期理财和CMA每天计息，所以按月复利近似计算。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "活期理財和CMA每天計息，所以按月複利近似計算。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cuentas de aparcamiento y las CMA devengan intereses a diario, así que lo aproximamos con capitalización mensual."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parkkonten und CMA werfen täglich Zinsen ab, daher rechnen wir näherungsweise mit monatlichem Zinseszins."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les comptes de dépôt et CMA rapportent des intérêts chaque jour ; nous approchons donc par capitalisation mensuelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I conti di parcheggio e i CMA maturano interessi ogni giorno, quindi si approssima con capitalizzazione mensile."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contas de parking e CMA rendem juros diários, então aproximamos com capitalização mensal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Паркинг-счета и CMA начисляют проценты ежедневно, поэтому мы приближаем месячной капитализацией."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บัญชีพักเงินและ CMA ได้ดอกเบี้ยทุกวัน จึงคำนวณโดยประมาณแบบทบต้นรายเดือน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tài khoản gửi tạm và CMA có lãi mỗi ngày nên chúng tôi tính xấp xỉ bằng ghép lãi theo tháng."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parkovací účty a CMA úročí denně, proto počítáme přibližně s měsíčním úročením."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parkeringskonti og CMA giver rente hver dag, så vi tilnærmer med månedlig rentetilskrivning."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι λογαριασμοί parking και τα CMA δίνουν τόκο καθημερινά, οπότε προσεγγίζουμε με μηνιαίο ανατοκισμό."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pysäköintitilit ja CMA:t tuottavat korkoa päivittäin, joten laskemme likimain kuukausittaisella koronkorolla."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rekening parkir dan CMA berbunga harian, jadi kami memperkirakan dengan bunga majemuk bulanan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parkeringskontoer og CMA gir rente hver dag, så vi tilnærmer med månedlig rentetilskriving."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parkeerrekeningen en CMA’s leveren dagelijks rente op, dus we benaderen met maandelijkse samengestelde rente."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konta parkingowe i CMA naliczają odsetki codziennie, więc przybliżamy kapitalizacją miesięczną."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parkeringskonton och CMA ger ränta varje dag, så vi approximerar med månadsvis ränta på ränta."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parking hesapları ve CMA’lar her gün faiz getirir, bu yüzden aylık bileşik faizle yaklaşık hesaplarız."
          }
        }
      }
    },
