        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "填入两个或更多年份的月薪，\n就能看到扣除物价后的购买力变化。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "填入兩個或更多年份的月薪，\n就能看到扣除物價後的購買力變化。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce sueldos de dos o más años\npara ver tu poder adquisitivo descontando la inflación."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trag Gehälter aus zwei oder mehr Jahren ein,\num die inflationsbereinigte Kaufkraft zu sehen."
          }
        },
        "fr" : {
          "stringUnit" : {
