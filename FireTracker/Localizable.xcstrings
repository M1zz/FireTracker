    "예상 국민연금을 넣지 않아 연금 없이 계산했어요. 매달 나가는 돈에서 넣을 수 있어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Národní důchod není zadán, proto se nezapočítává. Přidejte ho do Měsíčních výdajů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "National pension er ikke indtastet, så den er udeladt. Tilføj den under Månedlige udgifter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Nationalrente eingetragen, daher nicht berücksichtigt. Füge sie unter „Monatliche Ausgaben“ hinzu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν έχει δοθεί Εθνική Σύνταξη, οπότε δεν περιλαμβάνεται. Προσθέστε την στα Μηνιαία έξοδα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No National Pension entered, so it's left out. Add it under Monthly outgoings."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No National Pension entered, so it's left out. Add it under Monthly outgoings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No has introducido la Pensión Nacional, así que no se incluye. Añádela en Gastos mensuales."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kansaneläkettä ei ole syötetty, joten sitä ei huomioida. Lisää se Kuukausimenoihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune Pension nationale saisie : elle est donc exclue. Ajoutez-la dans les Dépenses mensuelles."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pensiun Nasional tidak dimasukkan, jadi tidak dihitung. Tambahkan di Pengeluaran bulanan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna Pensione Nazionale inserita, quindi è esclusa. Aggiungila alle Spese mensili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "国民年金が入力されていないため含めていません。毎月出ていくお金に追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예상 국민연금을 넣지 않아 연금 없이 계산했어요. 매달 나가는 돈에서 넣을 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasjonal pensjon er ikke lagt inn, så den er utelatt. Legg den til under Månedlige utgifter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen Nationaal Pensioen ingevoerd, dus het is niet meegerekend. Voeg het toe bij Maandelijkse uitgaven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie wpisano Emerytury Narodowej, więc jest pominięta. Dodaj ją w Wydatkach miesięcznych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma Pensão Nacional informada, então ela ficou de fora. Adicione em Gastos mensais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Национальная пенсия не указана, поэтому не учтена. Добавьте её в «Ежемесячные расходы»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
