    "실거주 부동산·연금·보험처럼 당장 쓸 수 없는 자산입니다. 총자산엔 잡히지만 ‘쓸 수 있는 돈’에서는 빠집니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assets you can't spend right away, like a home you live in, pensions and insurance. They count in total assets but are left out of ‘spendable money’."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assets you can't spend right away, like a home you live in, pensions and insurance. They count in total assets but are left out of ‘spendable money’."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自宅・年金・保険のように、すぐには使えない資産です。総資産には含まれますが、「使えるお金」からは外れます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自住房产、养老金、保险这类暂时用不了的资产。计入总资产，但不计入“可用资金”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自住房產、養老金、保險這類暫時用不了的資產。計入總資產，但不計入「可用資金」。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activos que no puedes gastar de inmediato, como la vivienda habitual, las pensiones y los seguros. Cuentan en el patrimonio total, pero quedan fuera del «dinero disponible»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vermögen, das du nicht sofort ausgeben kannst, wie selbst bewohnte Immobilien, Renten und Versicherungen. Sie zählen zum Gesamtvermögen, aber nicht zum „verfügbaren Geld“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des actifs qu’on ne peut pas dépenser tout de suite, comme la résidence principale, les retraites et les assurances. Ils comptent dans les actifs totaux mais pas dans l’« argent disponible »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attività non spendibili subito, come la casa in cui abiti, le pensioni e le assicurazioni. Contano nel patrimonio totale ma restano fuori dal «denaro spendibile»."
          }
        }
      }
    },
    "실거주 집, 보증금, 차는 살면서 쓰는 자산이라 뺐어요. 빚은 집과 보증금으로 먼저 갚는다고 보고, 그걸 넘는 몫만 뺐어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your home, deposits and car are excluded because you live with them. Debt is assumed repaid from your home and deposits first; only the excess is subtracted."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실거주 집, 보증금, 차는 살면서 쓰는 자산이라 뺐어요. 빚은 집과 보증금으로 먼저 갚는다고 보고, 그걸 넘는 몫만 뺐어요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your home, deposits and car are excluded because you live with them. Debt is assumed repaid from your home and deposits first; only the excess is subtracted."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自宅・保証金・車は暮らしの中で使う資産なので除きました。借金はまず自宅と保証金で返すとみなし、それを超える分だけ差し引きました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自住的房子、押金、汽车是生活中使用的资产，所以已剔除。债务视为先用房子和押金偿还，只扣除超出的部分。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自住的房子、押金、汽車是生活中使用的資產，所以已剔除。債務視為先用房子和押金償還，只扣除超出的部分。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu vivienda, las fianzas y el coche se excluyen porque los usas en tu vida diaria. Se supone que la deuda se paga primero con la vivienda y las fianzas; solo se resta el exceso."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selbst bewohntes Haus, Kautionen und Auto sind ausgenommen, weil du sie im Alltag nutzt. Schulden gelten zuerst durch Haus und Kautionen als getilgt; nur der darüber hinausgehende Teil wird abgezogen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre logement, les cautions et la voiture sont exclus car vous vous en servez au quotidien. La dette est supposée remboursée d’abord par le logement et les cautions ; seul l’excédent est déduit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casa, cauzioni e auto sono escluse perché le usi nella vita di tutti i giorni. Il debito si considera estinto prima con casa e cauzioni; si sottrae solo l’eccedenza."
          }
        }
      }
    },
