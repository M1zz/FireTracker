    "금액은 원화 환산으로 넣으세요. 보유 수량·투자 원금·평단은 이 내역에서 자동으로 계산됩니다(평균단가법)." : {
      "comment" : "A description of how to enter the amount in KRW.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter amounts converted to won. Quantity, cost basis and average cost are calculated automatically from this history (average cost method)."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter amounts converted to won. Quantity, cost basis and average cost are calculated automatically from this history (average cost method)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金額はウォン換算で入力してください。保有数量・投資元本・平均取得単価はこの履歴から自動計算されます（平均単価法）。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请按韩元折算后的金额输入。持有数量、投资本金和均价会根据这些明细自动计算（平均成本法）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請按韓元折算後的金額輸入。持有數量、投資本金和均價會根據這些明細自動計算（平均成本法）。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce los importes convertidos a wones. La cantidad, el capital invertido y el coste medio se calculan automáticamente a partir de este historial (método del coste medio)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib Beträge in Won umgerechnet ein. Stückzahl, eingesetztes Kapital und Durchschnittskurs werden aus diesem Verlauf automatisch berechnet (Durchschnittskostenmethode)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez les montants convertis en wons. La quantité, le capital investi et le prix moyen sont calculés automatiquement à partir de cet historique (méthode du coût moyen)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci gli importi convertiti in won. Quantità, capitale investito e prezzo medio si calcolano in automatico da questa cronologia (metodo del costo medio)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insira os valores convertidos em wons. Quantidade, capital investido e preço médio são calculados automaticamente a partir deste histórico (método do custo médio)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вводите суммы в вонах. Количество, вложенный капитал и средняя цена считаются автоматически по этой истории (метод средней стоимости)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กรอกจำนวนเงินที่แปลงเป็นวอนแล้ว จำนวนที่ถือ เงินลงทุน และต้นทุนเฉลี่ยจะคำนวณอัตโนมัติจากประวัตินี้ (วิธีต้นทุนเฉลี่ย)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập số tiền đã quy đổi ra won. Số lượng, vốn đầu tư và giá vốn bình quân được tự động tính từ lịch sử này (phương pháp giá vốn bình quân)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadávejte částky přepočtené na wony. Množství, investovaný kapitál a průměrná cena se z této historie počítají automaticky (metoda průměrných nákladů)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indtast beløb omregnet til won. Antal, investeret kapital og gennemsnitskurs beregnes automatisk ud fra denne historik (gennemsnitsmetoden)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βάλτε τα ποσά μετατρεμμένα σε γουόν. Η ποσότητα, το επενδυμένο κεφάλαιο και η μέση τιμή υπολογίζονται αυτόματα από αυτό το ιστορικό (μέθοδος μέσου κόστους)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syötä summat wonteina. Määrä, sijoitettu pääoma ja keskihinta lasketaan automaattisesti tästä historiasta (keskihintamenetelmä)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan jumlah yang sudah dikonversi ke won. Jumlah kepemilikan, modal investasi, dan harga rata-rata dihitung otomatis dari riwayat ini (metode biaya rata-rata)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv inn beløp omregnet til won. Antall, investert kapital og gjennomsnittskurs beregnes automatisk fra denne historikken (gjennomsnittsmetoden)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer bedragen in omgerekend naar won. Aantal, belegd kapitaal en gemiddelde koers worden automatisch berekend uit deze geschiedenis (gemiddelde-kostenmethode)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisuj kwoty przeliczone na wony. Ilość, zainwestowany kapitał i średnia cena są liczone automatycznie z tej historii (metoda średniego kosztu)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ange belopp omräknade till won. Antal, investerat kapital och snittkurs beräknas automatiskt från den här historiken (genomsnittsmetoden)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutarları won’a çevrilmiş olarak girin. Adet, yatırılan sermaye ve ortalama fiyat bu geçmişten otomatik hesaplanır (ortalama maliyet yöntemi)."
          }
        }
      }
    },
