    "Siri에게 물으면 퇴사까지 남은 기간을 바로 알려 줘요." : {
      "comment" : "Roadmap item detail: Siri and Shortcuts",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask Siri how long until you can quit, and get the answer instantly."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri에게 물으면 퇴사까지 남은 기간을 바로 알려 줘요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask Siri how long until you can quit, and get the answer instantly."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siriに聞くと、退職までの期間をすぐに教えてくれます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "问问Siri，立刻告诉你离辞职还有多久。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "問問Siri，立刻告訴你離離職還有多久。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregúntale a Siri cuánto falta para poder dejarlo y te lo dirá al instante."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frag Siri, wie lange es noch bis zum Ausstieg dauert – die Antwort kommt sofort."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez à Siri combien de temps il reste avant de pouvoir arrêter, il répond aussitôt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi a Siri quanto manca per poter smettere e ti risponde subito."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pergunte à Siri quanto falta para você poder parar e ela responde na hora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спросите Siri, сколько осталось до ухода, — она ответит сразу."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถาม Siri ว่าอีกนานแค่ไหนจะออกจากงานได้ แล้วจะได้คำตอบทันที"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hỏi Siri xem còn bao lâu nữa bạn có thể nghỉ việc, sẽ có câu trả lời ngay."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeptejte se Siri, za jak dlouho můžete skončit, a hned odpoví."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spørg Siri, hvor længe der er til, du kan stoppe, så får du svaret med det samme."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ρωτήστε τη Siri πόσο ακόμα μένει για να σταματήσετε και θα απαντήσει αμέσως."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kysy Siriltä, kuinka kauan on aikaa lopettamiseen, niin saat vastauksen heti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanya Siri berapa lama lagi Anda bisa berhenti, dan jawabannya langsung muncul."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spør Siri hvor lenge det er til du kan slutte, så får du svaret med en gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraag Siri hoe lang het nog duurt voor je kunt stoppen, dan krijg je meteen antwoord."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapytaj Siri, ile jeszcze zostało do odejścia, a odpowie od razu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fråga Siri hur länge det är kvar tills du kan sluta, så får du svaret direkt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri’ye bırakmaya ne kadar kaldığını sorun, hemen söylesin."
          }
        }
      }
    },
