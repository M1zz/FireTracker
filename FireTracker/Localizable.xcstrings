          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Lo que entonces era «suficiente» lo sigue siendo hoy?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onko silloinen ”riittävä” yhä riittävä tänään?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce « assez » d’alors, l’est-il encore aujourd’hui ?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Cukup” saat itu, apakah sekarang masih sama?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il «abbastanza» di allora, vale ancora oggi?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あのときの「十分」は、今も同じですか？"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjelder «nok» fra den gang fortsatt i dag?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is het ‘genoeg’ van toen nu nog steeds genoeg?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy tamto „wystarczy” obowiązuje też dzisiaj?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O “suficiente” daquela época ainda vale hoje?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хватало ли тогда «достаточно» — и сейчас ли это так?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gäller det ”tillräckliga” från då fortfarande idag?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำว่า “พอ” ของตอนนั้น ตอนนี้ยังเหมือนเดิมไหม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O günkü “yeter”, bugün de geçerli mi?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Đủ” của ngày ấy, bây giờ có còn đúng không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当时的“够用”，现在还是这样吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當時的「夠用」，現在還是這樣嗎？"
          }
        }
      }
    },
