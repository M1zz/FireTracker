          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放大字型後，介面也不會被截斷，而是整齊地重新排布。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al aumentar el tamaño del texto, las pantallas se reorganizan en lugar de cortarse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei größerer Schrift werden Bildschirme ordentlich neu angeordnet, statt abgeschnitten zu werden."
