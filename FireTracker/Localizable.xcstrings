            "state": "translated",
            "value": "Pension first, all at once"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연금부터 한꺼번에"
          }
        }
      }
    },
    "연금저축·IRP 비중": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pension savings / IRP share"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연금저축·IRP 비중"
          }
        }
      }
    },
    "예: 이직으로 연봉이 올라 저축이 늘면 +30%, 지방으로 옮겨 생활비가 줄면 −20%.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "E.g. +30% if a new job raises your savings, −20% if moving cuts living costs."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예: 이직으로 연봉이 올라 저축이 늘면 +30%, 지방으로 옮겨 생활비가 줄면 −20%."
          }
        }
      }
    },
    "예금·적금 만기에 얼마를 받는지, 이자에 세금은 얼마인지 계산해요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work out what a deposit or savings plan pays at maturity, and the tax on its interest."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예금·적금 만기에 얼마를 받는지, 이자에 세금은 얼마인지 계산해요."
          }
        }
      }
    },
    "예상 국민연금 (월, 오늘 돈)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expected National Pension (monthly, today's money)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예상 국민연금 (월, 오늘 돈)"
          }
        }
      }
    },
    "예상 국민연금을 넣지 않아 연금 없이 계산했어요. 매달 나가는 돈에서 넣을 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No National Pension entered, so it's left out. Add it under Monthly outgoings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예상 국민연금을 넣지 않아 연금 없이 계산했어요. 매달 나가는 돈에서 넣을 수 있어요."
          }
        }
      }
    },
    "예상 연금액은 국민연금공단 '내 곁에 국민연금'에서 볼 수 있어요. 임의가입을 하면 가입 기간이 늘어 나중에 받는 돈도 늘어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find your expected pension in the NPS app. Voluntary contributions lengthen your coverage and raise what you receive later."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예상 연금액은 국민연금공단 '내 곁에 국민연금'에서 볼 수 있어요. 임의가입을 하면 가입 기간이 늘어 나중에 받는 돈도 늘어요."
          }
        }
      }
    },
    "오늘 그만두기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit today"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 그만두기"
          }
        }
      }
    },
    "오늘 회사를 그만둔다면": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you quit today"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 회사를 그만둔다면"
          }
        }
      }
    },
