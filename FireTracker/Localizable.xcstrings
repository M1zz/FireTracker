        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het resterende saldo van %@ won en de jaarrente van %@%% worden als ‘Schuld’ op het tabblad Bezittingen gezet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saldo kredytu %@ wonów i oprocentowanie %@%% rocznie zostaną dodane na karcie Aktywa jako „Dług”."
