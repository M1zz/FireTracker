    "만기일시 — 매달 이자만 내고 원금은 마지막에 한 번에 갚아요. 총 이자가 가장 커요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jednorázově na konci — každý měsíc platíte jen úroky a jistinu splatíte najednou na konci. Úroky jsou nejvyšší."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afdragsfrit – du betaler kun renter hver måned og hele hovedstolen til sidst. De samlede renter bliver højest."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endfällig – du zahlst monatlich nur Zinsen und tilgst den ganzen Betrag am Ende. Die Zinsen gesamt sind am höchsten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόνο τόκοι — πληρώνετε μόνο τόκους κάθε μήνα και όλο το κεφάλαιο στο τέλος. Οι συνολικοί τόκοι είναι οι μεγαλύτεροι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interest-only — you pay just interest each month and repay the principal in one go at the end. Total interest is the highest."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interest-only — you pay just interest each month and repay the principal in one go at the end. Total interest is the highest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo intereses: cada mes pagas los intereses y el principal entero al final. Es la opción con más intereses en total."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kertalyhennys — maksat kuukausittain vain korot ja koko pääoman kerralla lopussa. Korkoja kertyy eniten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In fine — vous ne payez que les intérêts chaque mois et remboursez le capital en une fois à la fin. C’est la formule la plus coûteuse en intérêts."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunga saja (bullet) — tiap bulan hanya bayar bunga, pokok dilunasi sekaligus di akhir. Total bunganya paling besar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimborso a scadenza: paghi solo gli interessi ogni mese e restituisci il capitale tutto alla fine. Gli interessi totali sono i più alti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "満期一括 — 毎月利息だけを払い、元本は最後にまとめて返します。利息総額が最も大きくなります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avdragsfritt – du betaler bare renter hver måned og hele hovedstolen til slutt. Samlet rente blir høyest."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aflossingsvrij: je betaalt elke maand alleen rente en lost de hoofdsom aan het eind in één keer af. De totale rente is het hoogst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spłata na koniec — co miesiąc płacisz tylko odsetki, a kapitał oddajesz jednorazowo na końcu. Odsetki są najwyższe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só juros (bullet) — você paga só os juros todo mês e o principal de uma vez no final. É a opção com mais juros no total."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В конце срока — каждый месяц платятся только проценты, а основной долг гасится разом в конце. Процентов всего больше всего."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amorteringsfritt – du betalar bara ränta varje månad och hela kapitalet på slutet. Den totala räntan blir högst."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จ่ายเฉพาะดอกเบี้ย — จ่ายแต่ดอกเบี้ยทุกเดือน แล้วคืนเงินต้นก้อนเดียวตอนครบกำหนด ดอกเบี้ยรวมสูงที่สุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vade sonu ödemeli — her ay yalnızca faiz ödenir, anapara sonda tek seferde ödenir. Toplam faiz en yüksektir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trả gốc cuối kỳ — mỗi tháng chỉ trả lãi, gốc trả một lần vào cuối kỳ. Tổng lãi cao nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到期一次还本 — 每月只付利息，本金在最后一次还清。总利息最多。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到期一次還本 — 每月只繳利息，本金在最後一次還清。總利息最多。"
          }
        }
      }
    },
