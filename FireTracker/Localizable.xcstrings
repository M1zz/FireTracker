    "새 달이 시작됐어요. 목표를 정하면 언제 그만둘 수 있는지 알려 드릴게요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Začal nový měsíc. Nastavte cíl a řekneme vám, kdy můžete skončit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En ny måned er begyndt. Sæt et mål, så fortæller vi dig, hvornår du kan stoppe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein neuer Monat hat begonnen. Leg ein Ziel fest, dann sagen wir dir, wann du aufhören kannst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεκίνησε νέος μήνας. Ορίστε στόχο και θα σας πούμε πότε μπορείτε να σταματήσετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new month has started. Set a goal and we'll tell you when you can quit."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new month has started. Set a goal and we'll tell you when you can quit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza un nuevo mes. Fija un objetivo y te diremos cuándo podrás dejarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uusi kuukausi alkoi. Aseta tavoite, niin kerromme, milloin voit lopettaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nouveau mois commence. Fixez un objectif et nous vous dirons quand vous pourrez arrêter."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bulan baru dimulai. Tetapkan target dan kami akan memberi tahu kapan Anda bisa berhenti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È iniziato un nuovo mese. Fissa un obiettivo e ti diremo quando puoi smettere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい月が始まりました。目標を決めると、いつ辞められるかをお知らせします。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En ny måned har begynt. Sett et mål, så forteller vi deg når du kan slutte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een nieuwe maand is begonnen. Stel een doel in en we laten je weten wanneer je kunt stoppen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaczął się nowy miesiąc. Ustal cel, a powiemy ci, kiedy możesz odejść."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Começou um novo mês. Defina uma meta e mostramos quando você pode parar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начался новый месяц. Задайте цель — и мы скажем, когда можно уйти."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En ny månad har börjat. Sätt ett mål så berättar vi när du kan sluta."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เดือนใหม่เริ่มแล้ว ตั้งเป้าหมายแล้วเราจะบอกว่าคุณลาออกได้เมื่อไร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni bir ay başladı. Bir hedef belirleyin, ne zaman bırakabileceğinizi söyleyelim."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tháng mới đã bắt đầu. Đặt mục tiêu để biết khi nào bạn có thể nghỉ việc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新的一个月开始了。设定目标后，就能告诉你什么时候可以辞职。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新的月份開始了。設定目標後，就能告訴你什麼時候可以離職。"
          }
        }
      }
    },
    "새 달이 시작됐어요. 이번 달 자산을 확인해 보세요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Začal nový měsíc. Zkontrolujte svůj majetek za tento měsíc."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En ny måned er begyndt. Tjek dine aktiver for denne måned."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein neuer Monat hat begonnen. Wirf einen Blick auf dein Vermögen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεκίνησε νέος μήνας. Ελέγξτε την περιουσία σας αυτού του μήνα."
          }
        },
        "en" : {
