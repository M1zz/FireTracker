        }
      }
    },
    "빈 칸을 누르면 그 종류의 자산을 바로 추가할 수 있어요." : {
      "comment" : "A description of the benefits of adding a new asset.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap an empty slot to add that type of asset right away."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap an empty slot to add that type of asset right away."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空欄をタップすると、その種類の資産をすぐ追加できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
