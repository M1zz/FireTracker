    "미래의 1시간은 팔 때 비싸고, 지금의 1시간은 팔지 않을 때 비싸요. 시급과 기회비용이 다르기 때문이에요." : {
      "comment" : "A description of the difference in value of an hour of work depending on whether it is sold or not.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A future hour is expensive to sell, and an hour today is expensive not to sell. That's because hourly wage and opportunity cost are different things."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A future hour is expensive to sell, and an hour today is expensive not to sell. That's because hourly wage and opportunity cost are different things."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将来の1時間は売るときに高く、今の1時間は売らないときに高いのです。時給と機会費用は別物だからです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
