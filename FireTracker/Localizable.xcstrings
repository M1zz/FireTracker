        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reicht bis zum Ende, selbst in den schlechtesten 10 % von 2.000 Marktverläufen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αντέχει ως το τέλος ακόμα και στο χειρότερο 10% από 2.000 πορείες της αγοράς."
