    "회사가 반을 내 주던 보험료를 이제 혼자 내요. 이 돈까지 쳐야 진짜 생활비예요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyní platíte polovinu, kterou dříve hradil zaměstnavatel. Započítejte ji do skutečných životních nákladů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du betaler nu den halvdel, din arbejdsgiver før dækkede. Tag den med i dine reelle leveomkostninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du zahlst jetzt die Hälfte, die früher dein Arbeitgeber getragen hat. Rechne sie in deine echten Lebenskosten ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τώρα πληρώνετε το μισό που κάλυπτε παλιότερα ο εργοδότης σας. Υπολογίστε το στο πραγματικό κόστος ζωής σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You now pay the half your employer used to cover. Count it for your real living costs."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You now pay the half your employer used to cover. Count it for your real living costs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora pagas la mitad que antes cubría tu empresa. Cuéntala en tus gastos de vida reales."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksat nyt sen puolikkaan, jonka työnantajasi ennen kattoi. Laske se mukaan todellisiin elinkustannuksiisi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous payez désormais la moitié que votre employeur prenait en charge. Comptez-la dans vos frais de vie réels."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekarang Anda membayar separuh yang dulu ditanggung perusahaan. Hitung dalam biaya hidup nyata Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora paghi la metà che prima copriva il tuo datore di lavoro. Contala nelle tue spese di vita reali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これまで会社が負担していた半分を自分で払うことになります。実際の生活費として数えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회사가 반을 내 주던 보험료를 이제 혼자 내요. 이 돈까지 쳐야 진짜 생활비예요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du betaler nå den halvdelen arbeidsgiveren din før dekket. Ta den med i de reelle levekostnadene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je betaalt nu de helft die je werkgever vroeger dekte. Reken die mee in je echte leefkosten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teraz płacisz połowę, którą kiedyś pokrywał pracodawca. Wlicz ją w realne koszty życia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agora você paga a metade que antes sua empresa cobria. Conte-a no seu custo de vida real."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Теперь вы платите половину, которую раньше покрывал работодатель. Учтите её в реальных расходах на жизнь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du betalar nu den hälft som din arbetsgivare tidigare täckte. Räkna med den i dina verkliga levnadskostnader."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตอนนี้คุณจ่ายส่วนครึ่งหนึ่งที่นายจ้างเคยจ่ายให้ นับรวมในค่าครองชีพจริงด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artık işvereninizin eskiden karşıladığı yarıyı siz ödüyorsunuz. Gerçek geçim giderinize katın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bây giờ bạn tự trả nửa phần mà công ty từng đóng. Hãy tính vào sinh hoạt phí thực tế."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你现在要自己付公司以前负担的那一半。请把它算进真实的生活费。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你現在要自己付公司以前負擔的那一半。請把它算進真實的生活費。"
          }
        }
      }
    },
