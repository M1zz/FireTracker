          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memakai gaji %lld sebesar %@ dari tab Daya beli. Cukup isi jam kerja untuk melihat upah per jam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sto usando lo stipendio del %lld (%@) dalla scheda Potere d’acquisto. Inserisci solo le ore di lavoro per avere la paga oraria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購買力タブに入力した%lld年の月給%@を使っています。労働時間を入れるだけで時給が出ます。"
          }
        },
        "nb" : {
          "stringUnit" : {
