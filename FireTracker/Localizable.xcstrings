          }
        }
      }
    },
    "홈 화면 위젯": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Screen Widget"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈 화면 위젯"
          }
        }
      }
    },
    "홈 화면에서 퇴사까지 남은 시간을 바로 봐요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See time left until you quit right on your Home Screen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈 화면에서 퇴사까지 남은 시간을 바로 봐요."
          }
        }
      }
    },
    "회사가 반을 내 주던 보험료를 이제 혼자 내요. 이 돈까지 쳐야 진짜 생활비예요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You now pay the half your employer used to cover. Count it for your real living costs."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회사가 반을 내 주던 보험료를 이제 혼자 내요. 이 돈까지 쳐야 진짜 생활비예요."
          }
        }
      }
    },
    "회사를 그만두는 날": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The day you quit"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회사를 그만두는 날"
          }
        }
      }
    }
  },
