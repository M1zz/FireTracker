    "시장 몫은 석 달 뒤면 뒤집힐 수 있지만, 내가 모은 돈은 남아요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The market's share can reverse in three months; what you saved stays."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시장 몫은 석 달 뒤면 뒤집힐 수 있지만, 내가 모은 돈은 남아요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The market's share can reverse in three months; what you saved stays."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "市場の取り分は3か月後に逆転することもありますが、自分で貯めたお金は残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "市场带来的那部分三个月后可能逆转，但你攒下的钱会留下。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "市場帶來的那部分三個月後可能逆轉，但你攢下的錢會留下。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La parte del mercado puede revertirse en tres meses; lo que ahorraste se queda."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Anteil des Marktes kann sich in drei Monaten umkehren; was du gespart hast, bleibt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
