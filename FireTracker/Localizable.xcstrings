        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αγοραία αξία ήταν κρυμμένη, οπότε υπολογίσαμε από το κέρδος/ζημιά και την απόδοση. Ελέγξτε την."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Market value was hidden, so we calculated from gain/loss and return. Please check."
          }
        },
