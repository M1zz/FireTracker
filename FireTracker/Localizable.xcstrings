    "기록이 쌓이면 분기마다 리포트가 만들어져요. 자산을 바꾸면 그날 기록이 자동으로 남아요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S přibývajícími záznamy vzniká každé čtvrtletí zpráva. Když se změní majetek, záznam dne se uloží sám."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efterhånden som registreringer samles, laves der en rapport hvert kvartal. Når dine aktiver ændrer sig, gemmes dagens registrering automatisk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit wachsenden Einträgen entsteht jedes Quartal ein Bericht. Ändern sich deine Vermögen, wird der Eintrag des Tages automatisch gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καθώς συσσωρεύονται καταγραφές, δημιουργείται αναφορά κάθε τρίμηνο. Όταν αλλάζουν τα περιουσιακά σας στοιχεία, η καταγραφή της ημέρας αποθηκεύεται αυτόματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reports appear each quarter as records build up. Records are saved automatically whenever your assets change."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reports appear each quarter as records build up. Records are saved automatically whenever your assets change."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con registros acumulados se genera un informe cada trimestre. Los registros se guardan solos cuando cambian tus activos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merkintöjen kertyessä joka neljännes tehdään raportti. Kun varasi muuttuvat, päivän merkintä tallentuu automaattisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À mesure que les enregistrements s’accumulent, un rapport est créé chaque trimestre. Un enregistrement est ajouté automatiquement dès que vos actifs changent."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seiring catatan menumpuk, laporan dibuat tiap kuartal. Saat aset berubah, catatan hari itu tersimpan otomatis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Man mano che le registrazioni si accumulano, ogni trimestre viene creato un rapporto. Quando il patrimonio cambia, la registrazione del giorno si salva da sola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録が溜まると四半期ごとにレポートが作られます。資産を変えるとその日の記録が自動で残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록이 쌓이면 분기마다 리포트가 만들어져요. 자산을 바꾸면 그날 기록이 자동으로 남아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etter hvert som registreringer samles, lages det en rapport hvert kvartal. Når eiendelene dine endrer seg, lagres dagens registrering automatisk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naarmate registraties zich opstapelen, ontstaat elk kwartaal een rapport. Wijzigen je bezittingen, dan wordt de registratie van die dag automatisch bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W miarę gromadzenia zapisów co kwartał powstaje raport. Gdy aktywa się zmieniają, zapis z tego dnia zapisuje się automatycznie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com os registros acumulados, um relatório é criado a cada trimestre. Quando seus ativos mudam, o registro do dia é salvo automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По мере накопления записей каждый квартал создаётся отчёт. При изменении активов запись за день сохраняется автоматически."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När registreringar samlas skapas en rapport varje kvartal. När dina tillgångar ändras sparas dagens registrering automatiskt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อบันทึกสะสมมากขึ้น จะสร้างรายงานทุกไตรมาส เมื่อสินทรัพย์เปลี่ยน บันทึกของวันนั้นจะถูกเก็บอัตโนมัติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıtlar biriktikçe her çeyrek bir rapor oluşur. Varlıklarınız değiştiğinde o günün kaydı otomatik saklanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bản ghi tích lũy, mỗi quý sẽ có một báo cáo. Khi tài sản thay đổi, bản ghi của ngày đó tự được lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录累积后，每个季度都会生成报告。资产变动时，当天的记录会自动保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記錄累積後，每個季度都會生成報告。資產變動時，當天的記錄會自動儲存。"
          }
        }
      }
