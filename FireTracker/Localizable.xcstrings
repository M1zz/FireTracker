    "가장 최근 백업이 맨 위예요. 복원하면 현재 데이터가 그 시점으로 교체되고, 바로 전 상태는 ‘복원 직전 상태’로 이 목록에 남습니다." : {
      "comment" : "A description of the contents of the backup list.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The most recent backup is at the top. Restoring replaces current data with that point in time, and your state just before is kept in this list as ‘Before restore’."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The most recent backup is at the top. Restoring replaces current data with that point in time, and your state just before is kept in this list as ‘Before restore’."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最新のバックアップが一番上です。復元すると現在のデータがその時点に置き換わり、直前の状態は「復元直前の状態」としてこの一覧に残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近的备份在最上面。恢复后当前数据会被替换为那个时间点，恢复前的状态会以“恢复前状态”保留在此列表中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近的備份在最上面。還原後當前資料會被替換為那個時間點，還原前的狀態會以「還原前狀態」保留在此列表中。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia más reciente aparece arriba. Al restaurar, los datos actuales se sustituyen por los de ese momento y el estado anterior queda en esta lista como «Antes de restaurar»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die neueste Sicherung steht oben. Beim Wiederherstellen werden die aktuellen Daten durch den Stand von damals ersetzt; der Stand davor bleibt in dieser Liste als „Vor Wiederherstellung“ erhalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sauvegarde la plus récente est en haut. La restauration remplace les données actuelles par celles de ce moment ; l’état précédent reste dans cette liste sous « Avant restauration »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il backup più recente è in alto. Il ripristino sostituisce i dati attuali con quelli di quel momento e lo stato precedente resta in questo elenco come «Prima del ripristino»."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O backup mais recente fica no topo. Ao restaurar, os dados atuais são substituídos pelos daquele momento, e o estado anterior permanece nesta lista como “Antes da restauração”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Самая свежая копия — сверху. При восстановлении текущие данные заменяются данными на тот момент, а состояние перед этим остаётся в списке как «Перед восстановлением»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อมูลสำรองล่าสุดอยู่บนสุด เมื่อกู้คืน ข้อมูลปัจจุบันจะถูกแทนที่ด้วยข้อมูล ณ เวลานั้น และสถานะก่อนหน้าจะเหลืออยู่ในรายการนี้ในชื่อ “ก่อนกู้คืน”"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản sao lưu gần nhất nằm trên cùng. Khôi phục sẽ thay dữ liệu hiện tại bằng dữ liệu tại thời điểm đó, còn trạng thái ngay trước đó vẫn nằm trong danh sách này với tên “Trước khi khôi phục”."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejnovější záloha je nahoře. Obnova nahradí aktuální data stavem z té doby a předchozí stav zůstane v tomto seznamu jako „Před obnovou“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den nyeste kopi står øverst. Gendannelse erstatter de nuværende data med dem fra det tidspunkt, og tilstanden lige før bliver på listen som „Før gendannelse“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το πιο πρόσφατο αντίγραφο είναι στην κορυφή. Η επαναφορά αντικαθιστά τα τρέχοντα δεδομένα με εκείνης της στιγμής και η κατάσταση ακριβώς πριν μένει σε αυτή τη λίστα ως «Πριν την επαναφορά»."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uusin kopio on ylimpänä. Palautus korvaa nykyiset tiedot kyseisen hetken tiedoilla, ja tilanne juuri ennen palautusta jää tälle listalle nimellä ”Ennen palautusta”."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadangan terbaru ada di paling atas. Memulihkan mengganti data saat ini dengan data pada saat itu, dan kondisi tepat sebelumnya tetap ada di daftar ini sebagai “Sebelum pemulihan”."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den nyeste kopien står øverst. Gjenoppretting erstatter dagens data med dataene fra det tidspunktet, og tilstanden rett før blir i denne listen som «Før gjenoppretting»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De nieuwste back-up staat bovenaan. Herstellen vervangt de huidige gegevens door die van dat moment, en de toestand daarvoor blijft in deze lijst staan als ‘Vóór herstel’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najnowsza kopia jest na górze. Przywrócenie zastępuje bieżące dane danymi z tamtej chwili, a stan tuż przed pozostaje na liście jako „Przed przywróceniem”."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den senaste kopian ligger överst. Återställning ersätter nuvarande data med data från den tidpunkten, och läget strax före ligger kvar i listan som ”Före återställning”."
          }
        }
      }
    },
