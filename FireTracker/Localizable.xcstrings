          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara pagar deuda con invertir el mismo dinero y mira cuál adelanta más tu salida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertaa velan maksamista ja samojen rahojen sijoittamista ja katso, kumpi tuo lopetuspäivää lähemmäs."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparez le remboursement d’une dette et l’investissement de la même somme, et voyez ce qui rapproche le plus votre départ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bandingkan melunasi utang dengan menginvestasikan uang yang sama, dan lihat mana yang mendekatkan tanggal berhenti Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confronta estinguere il debito e investire gli stessi soldi, e vedi cosa avvicina di più la tua uscita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じお金で借金を返すか投資するか、どちらが退職を早めるかを比べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 돈으로 빚을 갚을지 투자할지, 어느 쪽이 퇴사를 앞당기는지 비교해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammenlign å betale ned gjeld med å investere de samme pengene, og se hva som flytter sluttdatoen din nærmere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergelijk schuld aflossen met hetzelfde geld beleggen, en kijk wat je stopdatum dichterbij brengt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porównaj spłatę długu z zainwestowaniem tych samych pieniędzy i zobacz, co bardziej przybliża datę odejścia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare quitar a dívida com investir o mesmo dinheiro e veja o que antecipa mais a sua saída."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сравните погашение долга и вложение тех же денег и посмотрите, что сильнее приближает уход."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jämför att betala skuld med att investera samma pengar och se vad som för ditt slutdatum närmare."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปรียบเทียบการใช้หนี้กับการลงทุนด้วยเงินก้อนเดียวกัน แล้วดูว่าแบบไหนทำให้วันออกจากงานมาเร็วกว่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynı parayla borç ödemeyi ve yatırım yapmayı karşılaştırın; hangisinin bırakma tarihinizi daha çok yaklaştırdığını görün."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So sánh trả nợ với đầu tư cùng số tiền, xem cách nào đưa ngày nghỉ việc đến gần hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比较用同样的钱还债或投资，看哪一个更能提前辞职。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比較用同樣的錢還債或投資，看哪一個更能提前離職。"
          }
        }
      }
    },
