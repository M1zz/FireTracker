            "value" : "Desactivado abrevia los importes grandes en unidades coreanas (eok = 100 M, man = 10 mil); activado muestra cifras completas como «600.000.000 wones». Se aplica a toda la app."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pois päältä lyhentää suuret summat korealaisiksi yksiköiksi (eok = 100 milj., man = 10 000); päällä näyttää kokonaisluvut kuten ”600 000 000 wonia”. Koskee koko appia."
          }
        },
        "fr" : {
