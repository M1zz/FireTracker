    "아직 내 목표가 없어요. 은퇴 후 생활비와 매달 모으는 돈만 알려 주면 바로 계산해 드려요." : {
      "comment" : "A description of the benefits of using the retirement calculator.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You don't have a goal yet. Tell us your living costs after retirement and your monthly savings and we'll calculate right away."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You don't have a goal yet. Tell us your living costs after retirement and your monthly savings and we'll calculate right away."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだマイ目標がありません。退職後の生活費と毎月貯めるお金を教えてもらえれば、すぐ計算します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没有我的目标。只要告诉我们退休后的生活费和每月攒的钱，马上为你计算。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "還沒有我的目標。只要告訴我們退休後的生活費和每月攢的錢，馬上為你計算。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no tienes un objetivo. Dinos tus gastos de vida tras el retiro y lo que ahorras al mes y lo calculamos al momento."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast noch kein Ziel. Nenne uns deine Lebenskosten im Ruhestand und deine monatliche Sparrate, dann rechnen wir sofort."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’avez pas encore d’objectif. Indiquez vos frais de vie après le départ et votre épargne mensuelle, nous calculons aussitôt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non hai ancora un obiettivo. Dicci le spese di vita dopo l’uscita e quanto risparmi al mese e calcoliamo subito."
          }
        }
      }
    },
    "아직 닿지 않아요" : {
