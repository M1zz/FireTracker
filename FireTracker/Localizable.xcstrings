        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da última vez não foi possível conectar ao iCloud, então o app abriu com o armazenamento do aparelho. Verifique o login do iCloud."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В прошлый раз не удалось подключиться к iCloud, поэтому приложение открылось с хранилищем устройства. Проверьте вход в iCloud."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ครั้งก่อนเชื่อมต่อ iCloud ไม่ได้ แอปจึงเปิดด้วยที่เก็บในเครื่อง โปรดตรวจสอบการลงชื่อเข้าใช้ iCloud"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lần trước không kết nối được iCloud nên ứng dụng mở bằng bộ nhớ trên thiết bị. Hãy kiểm tra đăng nhập iCloud."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minule se nepodařilo připojit k iCloudu, takže se aplikace otevřela s úložištěm v zařízení. Zkontrolujte přihlášení k iCloudu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidste gang kunne der ikke oprettes forbindelse til iCloud, så appen åbnede med lagring på enheden. Tjek din iCloud-login."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Την προηγούμενη φορά δεν ήταν δυνατή η σύνδεση με το iCloud, οπότε η εφαρμογή άνοιξε με αποθήκευση στη συσκευή. Ελέγξτε τη σύνδεσή σας στο iCloud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viime kerralla iCloudiin ei saatu yhteyttä, joten appi avattiin laitteen tallennustilalla. Tarkista iCloud-kirjautumisesi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terakhir kali tidak dapat terhubung ke iCloud, sehingga app dibuka dengan penyimpanan di perangkat. Periksa login iCloud Anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forrige gang kunne ikke iCloud kobles til, så appen åpnet med lagring på enheten. Sjekk iCloud-påloggingen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De vorige keer kon er geen verbinding met iCloud worden gemaakt, dus de app opende met opslag op het toestel. Controleer je iCloud-aanmelding."
          }
        },
        "pl" : {
          "stringUnit" : {
