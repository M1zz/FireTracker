        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ålder"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อายุ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaş"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuổi"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "年龄"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "年齡"
          }
        }
      }
    },
    "나이·은퇴 나이·연 수익률, 은퇴 후 월 지출(희망 월수령액), 월 생활비, 세후 월급이 내 목표(여정 탭)에 저장되고 대시보드 퇴사각에 바로 반영됩니다. (현재 패시브 인컴은 보유 자산에서 자동 계산되므로 바꾸지 않아요.)" : {
      "comment" : "A description of how the user's life expectancy, retirement age, annual return, retirement savings, living expenses, and post-tax income will be reflected in the user's goals and retirement timeline.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Věk, věk odchodu, roční výnos, měsíční výdaje po odchodu (požadovaný měsíční příjem), měsíční životní náklady a čistá mzda se uloží do Mých cílů (karta Cesta) a okamžitě se promítnou do data odchodu na přehledu. (Aktuální pasivní příjem se počítá automaticky z vašeho majetku, takže se nemění.)"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alder, pensionsalder, årligt afkast, månedligt forbrug efter stoppet (ønsket månedsindkomst), månedlige leveomkostninger og løn efter skat gemmes i Mine mål (fanen Rejse) og afspejles straks i stopdatoen på oversigten. (Den nuværende passive indkomst beregnes automatisk ud fra dine aktiver og ændres derfor ikke.)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alter, Rentenalter, Jahresrendite, monatliche Ausgaben im Ruhestand (gewünschte Monatsrente), monatliche Lebenskosten und Nettogehalt werden unter „Meine Ziele“ (Weg-Tab) gespeichert und fließen sofort in das Ausstiegsdatum im Dashboard ein. (Das aktuelle passive Einkommen wird automatisch aus deinem Vermögen berechnet und nicht verändert.)"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ηλικία, η ηλικία αποχώρησης, η ετήσια απόδοση, τα μηνιαία έξοδα μετά την αποχώρηση (επιθυμητό μηνιαίο εισόδημα), το μηνιαίο κόστος ζωής και ο καθαρός μισθός αποθηκεύονται στους Στόχους μου (καρτέλα Πορεία) και αντικατοπτρίζονται άμεσα στην ημερομηνία αποχώρησης του Πίνακα. (Το τρέχον παθητικό εισόδημα υπολογίζεται αυτόματα από τα περιουσιακά σας στοιχεία, οπότε δεν αλλάζει.)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Age, retirement age, annual return, monthly spending after retirement (desired monthly income), monthly living costs and after-tax salary are saved to My Goals (Journey tab) and reflected right away in the Dashboard quit date. (Current passive income is calculated automatically from your assets, so it isn't changed.)"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Age, retirement age, annual return, monthly spending after retirement (desired monthly income), monthly living costs and after-tax salary are saved to My Goals (Journey tab) and reflected right away in the Dashboard quit date. (Current passive income is calculated automatically from your assets, so it isn't changed.)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La edad, la edad de retiro, la rentabilidad anual, el gasto mensual tras el retiro (ingreso mensual deseado), el coste de vida mensual y el sueldo neto se guardan en Mis objetivos (pestaña Trayecto) y se reflejan al instante en la fecha de salida del Panel. (El ingreso pasivo actual se calcula solo a partir de tus activos, así que no se modifica.)"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikä, eläkeikä, vuosituotto, kuukausimenot eläkkeellä (toivottu kuukausitulo), kuukauden elinkustannukset ja verotettu palkka tallentuvat Omiin tavoitteisiin (Matka-välilehti) ja näkyvät heti Yleiskatsauksen lopetuspäivässä. (Nykyinen passiivinen tulo lasketaan automaattisesti varoistasi, joten se ei muutu.)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’âge, l’âge de départ, le rendement annuel, les dépenses mensuelles après le départ (revenu mensuel souhaité), les frais de vie mensuels et le salaire net sont enregistrés dans Mes objectifs (onglet Parcours) et répercutés aussitôt sur la date de départ du tableau de bord. (Le revenu passif actuel est calculé automatiquement à partir de vos actifs, il ne change donc pas.)"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usia, usia pensiun, imbal hasil tahunan, pengeluaran bulanan setelah pensiun (pendapatan bulanan yang diinginkan), biaya hidup bulanan, dan gaji bersih disimpan ke Target Saya (tab Perjalanan) dan langsung tercermin di tanggal berhenti pada Dasbor. (Pendapatan pasif saat ini dihitung otomatis dari aset Anda, jadi tidak berubah.)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Età, età di uscita, rendimento annuo, spesa mensile dopo l’uscita (reddito mensile desiderato), spese mensili e stipendio netto vengono salvati in I miei obiettivi (scheda Percorso) e si riflettono subito nella data di uscita della Dashboard. (Il reddito passivo attuale si calcola in automatico dal tuo patrimonio, quindi non cambia.)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "年齢・退職年齢・年間リターン、退職後の月間支出（希望の月額受給額）、月の生活費、税引後の給料がマイ目標（ジャーニータブ）に保存され、ダッシュボードの退職日にすぐ反映されます。（現在のパッシブインカムは保有資産から自動計算されるので変わりません。）"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alder, pensjonsalder, årlig avkastning, månedlig forbruk etter at du har sluttet (ønsket månedsinntekt), månedlige levekostnader og lønn etter skatt lagres i Mine mål (Reise-fanen) og vises straks i sluttdatoen på oversikten. (Dagens passive inntekt beregnes automatisk fra eiendelene dine og endres derfor ikke.)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leeftijd, pensioenleeftijd, jaarrendement, maandelijkse uitgaven na stoppen (gewenst maandinkomen), maandelijkse leefkosten en netto salaris worden bewaard in Mijn doelen (tabblad Reis) en direct weerspiegeld in de stopdatum op het overzicht. (Het huidige passieve inkomen wordt automatisch uit je bezittingen berekend en verandert dus niet.)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiek, wiek odejścia, roczny zwrot, miesięczne wydatki po odejściu (pożądany dochód miesięczny), miesięczne koszty życia i pensja netto są zapisywane w Moich celach (karta Droga) i od razu uwzględniane w dacie odejścia na pulpicie. (Obecny dochód pasywny jest liczony automatycznie z twoich aktywów, więc się nie zmienia.)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idade, idade de saída, retorno anual, gasto mensal após a saída (renda mensal desejada), custo de vida mensal e salário líquido são salvos em Minhas metas (aba Jornada) e refletem na hora na data de saída do Painel. (A renda passiva atual é calculada automaticamente a partir dos seus ativos, então não muda.)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возраст, возраст ухода, годовая доходность, месячные расходы после ухода (желаемый месячный доход), месячные расходы на жизнь и зарплата после налогов сохраняются в «Моих целях» (вкладка «Путь») и сразу отражаются в дате ухода на панели. (Текущий пассивный доход считается автоматически по вашим активам и не меняется.)"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ålder, pensionsålder, årlig avkastning, månatliga utgifter efter att du slutat (önskad månadsinkomst), månatliga levnadskostnader och lön efter skatt sparas i Mina mål (fliken Resa) och syns direkt i slutdatumet på översikten. (Nuvarande passiv inkomst beräknas automatiskt från dina tillgångar och ändras därför inte.)"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อายุ อายุเกษียณ ผลตอบแทนต่อปี รายจ่ายรายเดือนหลังเกษียณ (รายได้รายเดือนที่ต้องการ) ค่าใช้จ่ายรายเดือน และเงินเดือนหลังหักภาษี จะถูกบันทึกใน เป้าหมายของฉัน (แท็บเส้นทาง) และสะท้อนไปที่วันออกจากงานบนแดชบอร์ดทันที (รายได้ passive ปัจจุบันคำนวณอัตโนมัติจากสินทรัพย์ที่ถือ จึงไม่เปลี่ยน)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaş, emeklilik yaşı, yıllık getiri, emeklilik sonrası aylık harcama (istenen aylık gelir), aylık geçim gideri ve vergi sonrası maaş Hedeflerim’e (Yolculuk sekmesi) kaydedilir ve Panodaki bırakma tarihine hemen yansır. (Mevcut pasif gelir varlıklarınızdan otomatik hesaplandığı için değişmez.)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuổi, tuổi nghỉ hưu, lợi suất hằng năm, chi tiêu hằng tháng sau nghỉ hưu (thu nhập tháng mong muốn), sinh hoạt phí hằng tháng và lương sau thuế được lưu vào Mục tiêu của tôi (tab Hành trình) và phản ánh ngay vào ngày nghỉ việc trên Bảng điều khiển. (Thu nhập thụ động hiện tại tự tính từ tài sản đang giữ nên không thay đổi.)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "年龄、退休年龄、年收益率、退休后月支出（期望月领取额）、月生活费、税后月薪会保存到我的目标（旅程页），并立即反映到看板的辞职日。（当前被动收入由持有资产自动计算，不会改动。）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "年齡、退休年齡、年報酬率、退休後月支出（期望月領取額）、月生活費、稅後月薪會儲存到我的目標（旅程頁），並立即反映到儀表板的離職日。（當前被動收入由持有資產自動計算，不會改動。）"
          }
        }
      }
    },
    "나이가 들수록 같은 1시간을 실제로 쓸 수 있는 몫이 줄어요. 그만큼 미래 시간을 깎아서 봐요." : {
      "comment" : "A description of how the value of an hour of work diminishes as you age.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čím jste starší, tím méně z téže hodiny skutečně využijete. Budoucí čas se o tolik snižuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jo ældre du bliver, desto mindre af den samme time kan du reelt bruge. Fremtidig tid nedskrives tilsvarende."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je älter du wirst, desto weniger von derselben Stunde kannst du tatsächlich nutzen. Künftige Zeit wird entsprechend abgewertet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όσο μεγαλώνετε, τόσο λιγότερο από την ίδια ώρα μπορείτε να αξιοποιήσετε. Ο μελλοντικός χρόνος προεξοφλείται κατά το αντίστοιχο ποσοστό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The older you get, the less of the same hour you can actually use. Future time is discounted by that much."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The older you get, the less of the same hour you can actually use. Future time is discounted by that much."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuanto mayor eres, menos de esa misma hora puedes aprovechar realmente. El tiempo futuro se descuenta en esa medida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitä vanhemmaksi tulet, sitä pienempi osa samasta tunnista on oikeasti käytettävissä. Tulevaa aikaa diskontataan sen verran."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus on vieillit, moins on peut réellement utiliser la même heure. Le temps futur est décoté d’autant."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makin tua Anda, makin sedikit bagian dari jam yang sama yang benar-benar bisa dipakai. Waktu masa depan didiskon sebesar itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più invecchi, meno di quella stessa ora puoi usare davvero. Il tempo futuro viene scontato di conseguenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "年を重ねるほど、同じ1時間を実際に使える割合は減ります。その分、将来の時間を割り引いて見ます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jo eldre du blir, desto mindre av den samme timen kan du faktisk bruke. Fremtidig tid nedskrives tilsvarende."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe ouder je wordt, hoe minder van hetzelfde uur je echt kunt gebruiken. Toekomstige tijd wordt met dat deel verdisconteerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im jesteś starszy, tym mniej z tej samej godziny możesz naprawdę wykorzystać. Przyszły czas jest o tyle dyskontowany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto mais velho você fica, menos dessa mesma hora você realmente consegue aproveitar. O tempo futuro é descontado nessa medida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чем старше вы становитесь, тем меньше такого же часа можно реально использовать. Будущее время дисконтируется на эту долю."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ju äldre du blir, desto mindre av samma timme kan du faktiskt använda. Framtida tid diskonteras i motsvarande grad."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยิ่งอายุมาก ส่วนของชั่วโมงเดียวกันที่ใช้ได้จริงก็ยิ่งน้อยลง จึงหักลดเวลาในอนาคตตามนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaşlandıkça aynı saatin gerçekten kullanabildiğiniz payı azalır. Gelecekteki zaman o kadar iskonto edilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Càng lớn tuổi, phần của cùng một giờ mà bạn thực sự dùng được càng ít. Thời gian tương lai được chiết khấu theo mức đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "年纪越大，同样的1小时实际能用的部分就越少。未来的时间要按这个比例打折来看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "年紀越大，同樣的1小時實際能用的部分就越少。未來的時間要按這個比例打折來看。"
          }
        }
      }
    },
    "나이를 알아야 퇴사하는 날의 내 모습을 그릴 수 있어요. 내 목표에서 넣을 수 있어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K zobrazení dne odchodu potřebujeme váš věk. Zadejte ho v Mých cílech."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi skal bruge din alder for at tegne dagen, hvor du stopper. Tilføj den i Mine mål."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir brauchen dein Alter, um den Tag deines Ausstiegs zu zeichnen. Trag es unter „Meine Ziele“ ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρειαζόμαστε την ηλικία σας για να σχεδιάσουμε την ημέρα της αποχώρησης. Προσθέστε την στους Στόχους μου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We need your age to picture the day you quit. Add it in My Goals."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We need your age to picture the day you quit. Add it in My Goals."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesitamos tu edad para imaginar el día en que lo dejes. Añádela en Mis objetivos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarvitsemme ikäsi piirtääksemme lopetuspäiväsi. Lisää se Omiin tavoitteisiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous avons besoin de votre âge pour dessiner le jour où vous arrêtez. Ajoutez-le dans Mes objectifs."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami perlu usia Anda untuk menggambarkan hari Anda berhenti. Tambahkan di Target Saya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ci serve la tua età per disegnare il giorno in cui smetti. Inseriscila in I miei obiettivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退職する日の自分を描くには年齢が必要です。マイ目標で入力できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나이를 알아야 퇴사하는 날의 내 모습을 그릴 수 있어요. 내 목표에서 넣을 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi trenger alderen din for å tegne dagen du slutter. Legg den til i Mine mål."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We hebben je leeftijd nodig om de dag van je stoppen te tekenen. Voeg hem toe in Mijn doelen."
