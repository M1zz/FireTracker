          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доля рынка за три месяца может развернуться, а накопленное вами остаётся."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่วนของตลาดอาจพลิกกลับได้ภายในสามเดือน แต่เงินที่คุณออมไว้ยังอยู่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phần của thị trường có thể đảo chiều sau ba tháng, còn số tiền bạn đã tiết kiệm vẫn còn."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
