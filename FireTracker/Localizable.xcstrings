    "파란 선은 모으는 시기, 주황 선은 쓰는 시기예요. 값을 바꾸면 바꾸기 전 곡선이 회색 점선으로 남아요." : {
      "comment" : "Text describing the blue line (saving) and orange line (spending) in the graph.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The blue line is your saving years; the orange line is your spending years. When you change a value, the previous curve stays as a gray dotted line."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The blue line is your saving years; the orange line is your spending years. When you change a value, the previous curve stays as a grey dotted line."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "青い線は貯める時期、オレンジの線は使う時期です。値を変えると、変える前の曲線が灰色の点線で残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "蓝线是积累期，橙线是支出期。修改数值后，修改前的曲线会以灰色虚线保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "藍線是積累期，橙線是支出期。修改數值後，修改前的曲線會以灰色虛線保留。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La línea azul son tus años de ahorro; la naranja, tus años de gasto. Al cambiar un valor, la curva anterior queda como línea discontinua gris."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die blaue Linie sind deine Sparjahre, die orange deine Ausgabenjahre. Änderst du einen Wert, bleibt die vorherige Kurve als graue gestrichelte Linie stehen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ligne bleue représente vos années d’épargne, la orange vos années de dépense. Quand vous changez une valeur, l’ancienne courbe reste en pointillés gris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La linea blu sono i tuoi anni di risparmio, quella arancione i tuoi anni di spesa. Quando cambi un valore, la curva precedente resta come linea tratteggiata grigia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A linha azul são seus anos de poupança; a laranja, seus anos de gasto. Ao mudar um valor, a curva anterior permanece como linha cinza tracejada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синяя линия — годы накоплений, оранжевая — годы трат. Когда вы меняете значение, прежняя кривая остаётся серым пунктиром."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เส้นสีน้ำเงินคือช่วงออม เส้นสีส้มคือช่วงใช้ เมื่อเปลี่ยนค่า เส้นโค้งก่อนหน้าจะเหลือเป็นเส้นประสีเทา"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đường xanh là giai đoạn tích lũy, đường cam là giai đoạn chi tiêu. Khi đổi một giá trị, đường cong trước đó còn lại là nét đứt màu xám."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modrá čára jsou roky spoření, oranžová roky utrácení. Když změníte hodnotu, předchozí křivka zůstane jako šedá čárkovaná čára."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den blå linje er dine opsparingsår, den orange dine forbrugsår. Når du ændrer en værdi, bliver den forrige kurve stående som grå stiplet linje."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η μπλε γραμμή είναι τα χρόνια αποταμίευσης, η πορτοκαλί τα χρόνια δαπανών. Όταν αλλάξετε μια τιμή, η προηγούμενη καμπύλη μένει ως γκρι διακεκομμένη γραμμή."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sininen viiva on säästövuotesi, oranssi kulutusvuotesi. Kun muutat arvoa, edellinen käyrä jää harmaaksi katkoviivaksi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garis biru adalah tahun menabung, garis oranye tahun membelanjakan. Saat nilai diubah, kurva sebelumnya tetap sebagai garis putus-putus abu-abu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den blå linjen er sparteårene dine, den oransje forbruksårene. Når du endrer en verdi, blir den forrige kurven stående som en grå stiplet linje."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De blauwe lijn zijn je spaarjaren, de oranje je bestedingsjaren. Als je een waarde wijzigt, blijft de vorige curve als grijze stippellijn staan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niebieska linia to lata oszczędzania, pomarańczowa to lata wydawania. Gdy zmienisz wartość, poprzednia krzywa zostaje jako szara linia przerywana."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den blå linjen är dina sparår, den orange dina utgiftsår. När du ändrar ett värde ligger den tidigare kurvan kvar som grå streckad linje."
          }
        }
      }
    },
    "파킹·CMA는 매일 이자가 붙어 월 복리로 근사해서 계산해요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
