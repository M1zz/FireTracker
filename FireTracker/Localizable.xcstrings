          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На вкладке «Активы» укажите дивидендную доходность акции, аренду недвижимости или ставку вклада — и здесь появится месячный и недельный доход."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ในแท็บสินทรัพย์ กรอกอัตราปันผลของหุ้น ค่าเช่าอสังหาริมทรัพย์ หรืออัตราดอกเบี้ยเงินฝาก แล้วรายได้รายเดือนและรายสัปดาห์จะแสดงที่นี่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ở tab Tài sản, nhập tỷ suất cổ tức của cổ phiếu, tiền thuê của bất động sản hoặc lãi suất tiền gửi, thu nhập theo tháng và tuần sẽ hiện ở đây."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na kartě Majetek zadejte dividendový výnos akcie, nájem nemovitosti nebo úrok vkladu a zde se zobrazí měsíční a týdenní příjem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
