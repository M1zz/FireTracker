    "고르면 바로 그 카테고리의 종목 입력으로 이어져요. 종목을 저장하면 목록에 카테고리가 생깁니다." : {
      "comment" : "A description of the functionality of the category picker sheet.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po výběru přejdete rovnou na zadání pozice v dané kategorii. Po uložení se kategorie objeví v seznamu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du vælger, går du direkte til indtastning af en position i den kategori. Når du gemmer, dukker kategorien op på listen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du eine Kategorie wählst, geht es direkt zur Eingabe einer Position dort. Beim Speichern erscheint die Kategorie in der Liste."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν επιλέξετε, πηγαίνετε κατευθείαν στην καταχώριση θέσης αυτής της κατηγορίας. Μόλις αποθηκεύσετε, η κατηγορία εμφανίζεται στη λίστα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick one to go straight to entering a holding in that category. Saving it adds the category to your list."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick one to go straight to entering a holding in that category. Saving it adds the category to your list."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al elegir uno pasas directo a introducir un valor de esa categoría. Al guardarlo, la categoría aparece en la lista."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valinta vie suoraan kyseisen luokan position syöttöön. Kun tallennat position, luokka ilmestyy listaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En choisissant, vous passez directement à la saisie d’une position de cette catégorie. L’enregistrer crée la catégorie dans la liste."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memilih akan langsung membawa ke input posisi kategori itu. Setelah disimpan, kategori muncul di daftar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegliendo, passi subito all’inserimento di un titolo di quella categoria. Salvandolo, la categoria compare nell’elenco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選ぶとそのまま、そのカテゴリの銘柄入力に進みます。銘柄を保存すると一覧にカテゴリが作られます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du velger, går du rett til innskriving av en posisjon i den kategorien. Når du lagrer, dukker kategorien opp i listen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je kiest, ga je direct naar het invoeren van een positie in die categorie. Na het bewaren verschijnt de categorie in de lijst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po wybraniu przejdziesz od razu do wpisania pozycji w tej kategorii. Po zapisaniu kategoria pojawi się na liście."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao escolher, você vai direto para a entrada de um ativo dessa categoria. Ao salvar, a categoria aparece na lista."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбрав категорию, вы сразу перейдёте к вводу позиции в ней. После сохранения категория появится в списке."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du väljer hamnar du direkt i inmatning av en position i den kategorin. När du sparar dyker kategorin upp i listan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเลือกแล้วจะไปที่หน้ากรอกรายการของหมวดนั้นทันที เมื่อบันทึกรายการ หมวดจะปรากฏในรายการ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçince doğrudan o kategorideki pozisyon girişine geçersiniz. Kaydedince kategori listede görünür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn một mục sẽ đi thẳng đến nhập mã của danh mục đó. Khi lưu, danh mục sẽ xuất hiện trong danh sách."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择后会直接进入该类别的持仓输入。保存持仓后，列表中会出现该类别。"
          }
        },
