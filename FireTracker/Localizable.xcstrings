          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver leser opp hver knapp og hvert tall i riktig rekkefølge."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver leest elke knop en elk getal voor, in de juiste volgorde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
