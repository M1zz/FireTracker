    "월 저축을 늘리거나 목표 생활비를 줄이면 퇴사 시점이 생겨요. 계산 탭의 생애주기에서 바꿔 볼 수 있어요." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spořte víc každý měsíc nebo snižte cílové životní náklady a objeví se datum odchodu. Vyzkoušejte to v Životním cyklu na kartě Počítat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spar mere op hver måned, eller sænk målet for leveomkostninger, så får du en stopdato. Prøv det i Livscyklus under fanen Beregn."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spar mehr pro Monat oder senke deine Ziel-Lebenskosten, dann ergibt sich ein Ausstiegsdatum. Probier es im Lebenszyklus-Rechner im Tab „Berechnen“ aus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποταμιεύστε περισσότερα κάθε μήνα ή μειώστε το κόστος ζωής-στόχο για να προκύψει ημερομηνία αποχώρησης. Δοκιμάστε το στον Κύκλο ζωής, στην καρτέλα Υπολογισμός."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save more each month or lower your target living costs to get a quit date. Try it in the Life Cycle calculator."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save more each month or lower your target living costs to get a quit date. Try it in Life Cycle on the Calculate tab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahorra más cada mes o baja tus gastos de vida objetivo para obtener una fecha. Pruébalo en Ciclo de vida, en la pestaña Calcular."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säästä enemmän kuukaudessa tai laske tavoiteltuja elinkustannuksia, niin saat lopetuspäivän. Kokeile Laske-välilehden Elinkaari-laskurissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Épargnez plus chaque mois ou réduisez vos frais de vie cibles pour obtenir une date. Essayez dans Cycle de vie, onglet Calculer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambah tabungan bulanan atau turunkan target biaya hidup agar muncul waktu berhenti. Coba di Siklus hidup pada tab Hitung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Risparmia di più ogni mese o riduci le spese di vita obiettivo per ottenere una data. Prova in Ciclo di vita, nella scheda Calcola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎月の貯蓄を増やすか目標生活費を減らすと、退職時期が出てきます。計算タブのライフサイクルで試せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "월 저축을 늘리거나 목표 생활비를 줄이면 퇴사 시점이 생겨요. 계산 탭의 생애주기에서 바꿔 볼 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spar mer hver måned eller senk målet for levekostnader, så får du en sluttdato. Prøv i Livssyklus i Beregn-fanen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaar meer per maand of verlaag je doel voor leefkosten om een stopdatum te krijgen. Probeer het in Levenscyclus op het tabblad Berekenen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oszczędzaj więcej co miesiąc albo obniż docelowe koszty życia, a pojawi się data odejścia. Wypróbuj to w Cyklu życia na karcie Oblicz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poupe mais por mês ou reduza o custo de vida desejado para ter uma data. Experimente em Ciclo de vida, na aba Calcular."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откладывайте больше каждый месяц или снизьте целевые расходы — и появится дата ухода. Попробуйте в «Жизненном цикле» на вкладке «Рассчитать»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spara mer varje månad eller sänk målet för levnadskostnader så får du ett slutdatum. Testa i Livscykel på fliken Beräkna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ออมเพิ่มต่อเดือนหรือลดค่าครองชีพเป้าหมาย แล้วจะมีวันออกจากงาน ลองปรับได้ที่วงจรชีวิตในแท็บคำนวณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aylık birikimi artırırsanız ya da hedef geçim giderini düşürürseniz bir bırakma tarihi oluşur. Hesapla sekmesindeki Yaşam döngüsü’nde deneyebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tăng tiết kiệm hằng tháng hoặc giảm sinh hoạt phí mục tiêu để có thời điểm nghỉ việc. Hãy thử ở Vòng đời trong tab Tính."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "增加每月储蓄或降低目标生活费，就会出现辞职时间。可以在计算标签的生命周期中试试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "增加每月儲蓄或降低目標生活費，就會出現離職時間。可以在計算分頁的生命週期中試試看。"
          }
        }
      }
    },
