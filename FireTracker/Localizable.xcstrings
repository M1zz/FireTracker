    "지난 월급을 물가로 나눠 내 실질 구매력이 늘었는지 알려줘요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjust past salaries for inflation to see whether your real purchasing power grew."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지난 월급을 물가로 나눠 내 실질 구매력이 늘었는지 알려줘요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjust past salaries for inflation to see whether your real purchasing power grew."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "過去の給料を物価で調整して、実質の購買力が伸びたかを確かめます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按物价调整过去的月薪，看实际购买力有没有增长。"
