        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στην καρτέλα Περιουσιακά στοιχεία, βάλτε τη μερισματική απόδοση μιας μετοχής, το ενοίκιο ενός ακινήτου ή το επιτόκιο μιας κατάθεσης και εδώ εμφανίζεται το μηνιαίο και εβδομαδιαίο εισόδημα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syötä Varat-välilehdellä osakkeen osinkotuotto, kiinteistön vuokra tai talletuksen korko, niin kuukausi- ja viikkotulo näkyy tässä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
