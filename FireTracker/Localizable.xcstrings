            "value" : "เงินต้นเท่ากันทุกงวด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trả đều gốc"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rovnoměrná jistina"
          }
        },
        "da" : {
