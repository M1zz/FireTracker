          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para ve zaman"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiền và thời gian"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "钱与时间"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
