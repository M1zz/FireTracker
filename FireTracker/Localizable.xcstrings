    "화면 읽기 기능이 단추와 숫자를 빠짐없이, 알맞은 순서로 읽어 줘요." : {
      "comment" : "Roadmap item detail: better VoiceOver support",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver čte každé tlačítko i číslo ve správném pořadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver læser hver knap og hvert tal op i den rigtige rækkefølge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver liest jede Schaltfläche und Zahl in der richtigen Reihenfolge vor."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το VoiceOver διαβάζει κάθε κουμπί και αριθμό με τη σωστή σειρά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver reads every button and number, in the right order."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver reads every button and number, in the right order."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver lee cada botón y número, en el orden correcto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver lukee jokaisen painikkeen ja luvun oikeassa järjestyksessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver lit chaque bouton et chaque chiffre, dans le bon ordre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver membacakan setiap tombol dan angka dalam urutan yang benar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver legge ogni pulsante e numero, nell’ordine giusto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOverがすべてのボタンと数字を、正しい順番で読み上げます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
