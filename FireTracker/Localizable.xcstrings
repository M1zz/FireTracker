        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trag Vermögen im Vermögen-Tab ein,\nund wir schätzen, wie es weitergeht."
          }
        },
        "fr" : {
          "stringUnit" : {
