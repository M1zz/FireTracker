        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld세"
          }
        }
      }
    },
    "%lld세 퇴사": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit at %lld"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld세 퇴사"
          }
        }
      }
    },
    "%lld세 퇴사 · 그때 %@원": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit at %1$lld · %2$@ won then"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld세 퇴사 · 그때 %@원"
          }
        }
      }
    },
    "%lld세까지": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "to age %lld"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld세까지"
          }
        }
      }
    },
    "%lld세까지 버틸 확률": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chance it lasts to age %lld"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld세까지 버틸 확률"
          }
        }
      }
    },
    "%lld세부터: 국민연금이 들어와 꺼낼 돈이 줄어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From %lld: the National Pension starts and you withdraw less"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld세부터: 국민연금이 들어와 꺼낼 돈이 줄어요"
          }
        }
      }
    },
    "%lld세부터: 연금계좌에서 해마다 1,500만원까지 먼저": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From %lld: take up to 15M won a year from pension accounts first"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld세부터: 연금계좌에서 해마다 1,500만원까지 먼저"
          }
        }
      }
    },
    "%lld세부터: 연금계좌에서 해마다 1,500만원까지 먼저, 모자란 몫은 일반계좌에서": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From %lld: up to 15M won a year from pension accounts first, the rest from your taxable account"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld세부터: 연금계좌에서 해마다 1,500만원까지 먼저, 모자란 몫은 일반계좌에서"
          }
        }
      }
    },
    "%lld세에 돈이 바닥나요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money runs out at %lld"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld세에 돈이 바닥나요"
          }
        }
      }
    },
    "1·4·7·10월 1일 아침 9시": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jan, Apr, Jul and Oct 1 at 9 AM"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1·4·7·10월 1일 아침 9시"
          }
        }
      }
    },
    "2,000가지 시장 흐름 중 나쁜 쪽 10%에서도 끝까지 버텨요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It lasts to the end even in the worst 10% of 2,000 market paths."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2,000가지 시장 흐름 중 나쁜 쪽 10%에서도 끝까지 버텨요."
          }
        }
      }
    },
    "2026년 제도(건강보험료율 7.19%, 재산 점수당 211.5원, 국민연금 9.5%에서 해마다 0.5%p 인상, 사적연금 연 1,500만원 저율과세)와 입력한 가정으로 계산한 추정이에요. 금액은 모두 오늘 돈 기준이고, 실제 보험료와 세금은 공단과 국세청에서 확인하세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimates based on 2026 Korean rules (health insurance 7.19%, 211.5 won per property point, National Pension 9.5% rising 0.5%p a year, low tax on private pensions up to 15M won a year) and your assumptions. All amounts are in today's money. Check actual premiums and taxes with NHIS and the National Tax Service."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2026년 제도(건강보험료율 7.19%, 재산 점수당 211.5원, 국민연금 9.5%에서 해마다 0.5%p 인상, 사적연금 연 1,500만원 저율과세)와 입력한 가정으로 계산한 추정이에요. 금액은 모두 오늘 돈 기준이고, 실제 보험료와 세금은 공단과 국세청에서 확인하세요."
          }
        }
      }
    },
    "2년 더 다니기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work 2 more years"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2년 더 다니기"
          }
        }
      }
    },
    "55세 전에는 일반계좌·ISA로 버티고, 55세부터는 연금계좌에서 해마다 1,500만원(저율 3.3~5.5%) 안쪽만 꺼낸 뒤 모자란 몫을 일반계좌에서 채우는 순서예요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before 55, live on your taxable account and ISA. From 55, take up to 15M won a year from pension accounts (low 3.3–5.5% tax) and fill the gap from your taxable account."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "55세 전에는 일반계좌·ISA로 버티고, 55세부터는 연금계좌에서 해마다 1,500만원(저율 3.3~5.5%) 안쪽만 꺼낸 뒤 모자란 몫을 일반계좌에서 채우는 순서예요."
          }
        }
      }
    },
    "60세까지 국민연금 임의가입": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voluntary National Pension until 60"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "60세까지 국민연금 임의가입"
          }
        }
      }
    },
    "ISA 비과세 한도": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ISA tax-free allowance"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ISA 비과세 한도"
          }
        }
      }
    },
    "ISA 비중": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ISA share"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ISA 비중"
          }
        }
      }
    },
    "ISA 중 수익 비율": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gains share of ISA"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ISA 중 수익 비율"
          }
        }
      }
    },
    "iCloud 동기화": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Sync"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 동기화"
          }
        }
      }
    },
    "iCloud 동기화 중에는 데모 데이터를 켤 수 없어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo data is unavailable while iCloud Sync is on."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 동기화 중에는 데모 데이터를 켤 수 없어요."
          }
        }
      }
    },
    "iCloud 상태를 확인하지 못했어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't check iCloud status"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 상태를 확인하지 못했어요"
          }
        }
      }
    },
    "iCloud를 잠시 쓸 수 없어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is temporarily unavailable"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud를 잠시 쓸 수 없어요"
          }
        }
      }
    },
    "iCloud에 연결돼 있어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected to iCloud"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud에 연결돼 있어요"
          }
        }
      }
    },
    "가운데 선은 보통의 경우, 색칠한 띠는 좋을 때(상위 10%)와 나쁠 때(하위 10%) 사이예요. 점선이 퇴사하는 해예요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The line is the typical case; the band runs from good (top 10%) to bad (bottom 10%) markets. The dashed line is the year you quit."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가운데 선은 보통의 경우, 색칠한 띠는 좋을 때(상위 10%)와 나쁠 때(하위 10%) 사이예요. 점선이 퇴사하는 해예요."
          }
        }
      }
    },
    "가장 많이 움직인 자산": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Biggest movers"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 많이 움직인 자산"
          }
        }
      }
    },
    "가장 적음": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lowest"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 적음"
          }
        }
      }
    },
    "가정 바꾸기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change assumptions"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가정 바꾸기"
          }
        }
      }
    },
    "가족의 피부양자": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Family dependent"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가족의 피부양자"
          }
        }
      }
    },
    "가족의 피부양자로 올라갈 수 있어 보여요. 보험료 0원.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You look eligible as a family dependent. Premium: 0 won."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가족의 피부양자로 올라갈 수 있어 보여요. 보험료 0원."
          }
        }
      }
    },
    "같은 Apple 계정의 아이폰·아이패드에서 자산과 기록을 함께 봐요. 처음 켤 때는 데이터가 있는 기기에서 먼저 켜고, 다른 기기는 비어 있는 상태에서 켜야 자산이 두 벌로 생기지 않아요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See your assets and records on every iPhone and iPad with the same Apple Account. Turn it on first on the device with your data, and on other devices only while they're empty, so assets don't get duplicated."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 Apple 계정의 아이폰·아이패드에서 자산과 기록을 함께 봐요. 처음 켤 때는 데이터가 있는 기기에서 먼저 켜고, 다른 기기는 비어 있는 상태에서 켜야 자산이 두 벌로 생기지 않아요."
          }
        }
      }
    },
    "같은 돈으로 빚을 갚을까, 투자할까. 어느 쪽이 퇴사를 앞당기는지 비교해요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay off debt or invest the same money? Compare which brings your quit date closer."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 돈으로 빚을 갚을까, 투자할까. 어느 쪽이 퇴사를 앞당기는지 비교해요."
          }
        }
      }
    },
    "같은 돈으로 빚을 갚을지 투자할지, 어느 쪽이 퇴사를 앞당기는지 비교해요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare paying off debt with investing the same money, and see which brings your quit date closer."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
