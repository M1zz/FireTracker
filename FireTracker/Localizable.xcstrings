    "외식·쇼핑처럼 시간이 돌아오지 않는 지출은 여기 넣지 않아요. 밀도와 상관이 없거든요." : {
      "comment" : "A description of the section below the time-spent-on-expenses section.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spending where the time doesn't come back, like dining out or shopping, doesn't go here. It has nothing to do with density."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spending where the time doesn't come back, like dining out or shopping, doesn't go here. It has nothing to do with density."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外食や買い物のように時間が戻ってこない支出はここに入れません。密度とは関係がないからです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像外出就餐、购物这类时间不会回来的支出不放在这里，因为与密度无关。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像外出就餐、購物這類時間不會回來的支出不放在這裡，因為與密度無關。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí no se incluyen gastos cuyo tiempo no vuelve, como salir a comer o ir de compras. No tienen que ver con la densidad."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgaben, bei denen die Zeit nicht zurückkommt, wie Essengehen oder Shoppen, gehören nicht hierher. Sie haben nichts mit der Dichte zu tun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dépenses dont le temps ne revient pas, comme les restaurants ou le shopping, n’entrent pas ici. Elles n’ont rien à voir avec la densité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le spese il cui tempo non torna, come cene fuori o shopping, non vanno qui. Non c’entrano con la densità."
          }
        }
      }
    },
