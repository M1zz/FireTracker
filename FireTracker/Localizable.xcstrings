    "코인 심볼을 넣고 칸을 벗어나면 이름이 자동으로 채워지고, 업비트 시세로 현재가를 자동 계산해요(키 불필요). 비워두면 직접 입력합니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadejte symbol mince a opusťte pole — název se doplní sám a aktuální cena se spočítá z Upbit (bez klíče). Když pole necháte prázdné, zadáte vše ručně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angiv kryptosymbolet. Når du forlader feltet, udfyldes navnet automatisk, og den aktuelle pris beregnes med kurser fra Upbit (ingen nøgle nødvendig). Lad feltet være tomt for at indtaste manuelt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib ein Krypto-Symbol ein. Wenn du das Feld verlässt, wird der Name automatisch ergänzt und der aktuelle Kurs über Upbit berechnet (kein Schlüssel nötig). Leer lassen, um manuell einzugeben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βάλτε σύμβολο κρυπτονομίσματος και βγείτε από το πεδίο: το όνομα συμπληρώνεται αυτόματα και η τρέχουσα τιμή υπολογίζεται με τιμές Upbit (χωρίς κλειδί). Αν το αφήσετε κενό, τα βάζετε χειροκίνητα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter a coin symbol and leave the field to fill in the name automatically; the current price is calculated from Upbit (no key needed). Leave it blank to enter values yourself."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter a coin symbol and leave the field to fill in the name automatically; the current price is calculated from Upbit (no key needed). Leave it blank to enter values yourself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe el símbolo de la cripto y, al salir del campo, el nombre se rellena solo y el precio actual se calcula con Upbit (sin clave). Si lo dejas vacío, lo introduces a mano."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syötä kryptosymboli ja siirry pois kentästä, niin nimi täyttyy automaattisesti ja nykyinen hinta lasketaan Upbitin hinnoista (avainta ei tarvita). Tyhjänä syötät tiedot itse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez le symbole crypto puis quittez le champ : le nom se remplit tout seul et le prix actuel est calculé avec le cours Upbit (aucune clé requise). Laissez vide pour saisir à la main."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan simbol kripto lalu keluar dari kolom, nama akan terisi otomatis dan harga terkini dihitung dengan harga Upbit (tanpa kunci). Biarkan kosong untuk mengisi sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci il simbolo della cripto: uscendo dal campo il nome si compila da solo e il prezzo attuale si calcola con i prezzi di Upbit (nessuna chiave richiesta). Se lo lasci vuoto, inserisci a mano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗号資産のシンボルを入れて欄を離れると名前が自動で入り、Upbitの価格で現在値を自動計算します（キー不要）。空欄なら手入力になります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv inn kryptosymbolet. Når du forlater feltet, fylles navnet inn automatisk, og gjeldende pris beregnes med kurser fra Upbit (ingen nøkkel trengs). La feltet stå tomt for å skrive inn manuelt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vul een cryptosymbool in en verlaat het veld: de naam wordt automatisch ingevuld en de huidige prijs berekend met koersen van Upbit (geen sleutel nodig). Laat je het leeg, dan vul je het zelf in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz symbol monety i wyjdź z pola — nazwa uzupełni się sama, a bieżąca cena policzy się z Upbit (bez klucza). Jeśli zostawisz puste, wpiszesz ręcznie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informe o símbolo da moeda e saia do campo: o nome é preenchido sozinho e o preço atual é calculado com a Upbit (sem chave). Deixe em branco para digitar à mão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите символ монеты и выйдите из поля — название заполнится само, а текущая цена посчитается по Upbit (ключ не нужен). Если оставить пустым, вводите вручную."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ange kryptosymbolen. När du lämnar fältet fylls namnet i automatiskt och aktuellt pris beräknas med kurser från Upbit (ingen nyckel krävs). Lämna tomt för att ange manuellt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กรอกสัญลักษณ์คริปโตแล้วออกจากช่อง ชื่อจะถูกเติมให้อัตโนมัติ และคำนวณราคาปัจจุบันจากราคา Upbit ให้ (ไม่ต้องใช้คีย์) ถ้าเว้นว่างไว้ ให้กรอกเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kripto sembolünü girip alandan çıkınca ad otomatik dolar ve güncel fiyat Upbit’ten otomatik hesaplanır (anahtar gerekmez). Boş bırakırsanız elle girersiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập ký hiệu tiền mã hóa rồi rời ô, tên sẽ tự điền và giá hiện tại được tính tự động theo giá Upbit (không cần khóa). Để trống thì nhập tay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "填入加密货币代号，离开输入框后会自动填好名称，并按Upbit行情自动计算现价（无需密钥）。留空则手动填写。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輸入加密貨幣代號，離開欄位後會自動填入名稱，並依Upbit行情自動計算現價（不需金鑰）。留空則手動輸入。"
          }
        }
      }
    },
