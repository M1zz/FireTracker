    "글자 크기를 키워도 잘리지 않고 보기 좋게 다시 배치돼요." : {
      "comment" : "Roadmap item detail: Dynamic Type layouts",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při zvětšení písma se obrazovky přeskládají přehledně a nejsou oříznuté."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
