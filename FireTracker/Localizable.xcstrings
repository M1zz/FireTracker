        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usando o salário de %2$@ de %1$lld da aba Poder de compra. Informe só as horas trabalhadas para ver o valor da hora."
          }
        },
        "ru" : {
          "stringUnit" : {
