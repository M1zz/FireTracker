        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필요할 때 연금부터 한꺼번에 꺼내는 것보다 세금이 %@원 줄어요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
