    "아직 내 목표가 없어요. 은퇴 후 생활비와 매달 모으는 돈만 알려 주면 바로 계산해 드려요." : {
      "comment" : "A description of the benefits of using the retirement calculator.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You don't have a goal yet. Tell us your living costs after retirement and your monthly savings and we'll calculate right away."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You don't have a goal yet. Tell us your living costs after retirement and your monthly savings and we'll calculate right away."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだマイ目標がありません。退職後の生活費と毎月貯めるお金を教えてもらえれば、すぐ計算します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没有我的目标。只要告诉我们退休后的生活费和每月攒的钱，马上为你计算。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "還沒有我的目標。只要告訴我們退休後的生活費和每月攢的錢，馬上為你計算。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no tienes un objetivo. Dinos tus gastos de vida tras el retiro y lo que ahorras al mes y lo calculamos al momento."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast noch kein Ziel. Nenne uns deine Lebenskosten im Ruhestand und deine monatliche Sparrate, dann rechnen wir sofort."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’avez pas encore d’objectif. Indiquez vos frais de vie après le départ et votre épargne mensuelle, nous calculons aussitôt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non hai ancora un obiettivo. Dicci le spese di vita dopo l’uscita e quanto risparmi al mese e calcoliamo subito."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você ainda não tem uma meta. Diga o custo de vida depois da saída e quanto poupa por mês e calculamos na hora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У вас пока нет цели. Укажите расходы на жизнь после ухода и месячные накопления — и мы сразу посчитаем."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่มีเป้าหมาย บอกค่าครองชีพหลังเกษียณกับเงินออมรายเดือน เราจะคำนวณให้ทันที"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn chưa có mục tiêu. Hãy cho biết sinh hoạt phí sau nghỉ hưu và số tiền tiết kiệm mỗi tháng, chúng tôi tính ngay."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatím nemáte cíl. Řekněte nám životní náklady po odchodu a měsíční spoření a hned to spočítáme."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har endnu ikke et mål. Fortæl os dine leveomkostninger efter stoppet og din månedlige opsparing, så regner vi det ud med det samme."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν έχετε ακόμα στόχο. Πείτε μας το κόστος ζωής μετά την αποχώρηση και τη μηνιαία αποταμίευσή σας και θα υπολογίσουμε αμέσως."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinulla ei ole vielä tavoitetta. Kerro elinkustannuksesi eläkkeellä ja kuukausisäästösi, niin laskemme heti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda belum punya target. Beri tahu biaya hidup setelah pensiun dan tabungan bulanan, dan kami langsung menghitung."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har ikke et mål ennå. Fortell oss levekostnadene dine etter at du har sluttet og den månedlige sparingen, så regner vi det ut med en gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt nog geen doel. Vertel ons je leefkosten na het stoppen en je maandelijkse spaargeld, dan rekenen we meteen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie masz jeszcze celu. Podaj koszty życia po odejściu i miesięczne oszczędności, a od razu policzymy."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har inget mål ännu. Berätta dina levnadskostnader efter att du slutat och ditt månadssparande, så räknar vi direkt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz hedefiniz yok. Emeklilik sonrası geçim giderinizi ve aylık birikiminizi söyleyin, hemen hesaplayalım."
          }
        }
      }
    },
