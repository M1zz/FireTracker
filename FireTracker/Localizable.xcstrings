    "생활비·나이·순자산·저축만 대략 넣으면 돼요" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just rough numbers for spending, age, net worth and savings"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just rough numbers for spending, age, net worth and savings"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生活費・年齢・純資産・貯蓄をざっくり入れるだけです"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大致填入生活费、年龄、净资产和储蓄即可"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大致填入生活費、年齡、淨資產和儲蓄就好"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo pon a grandes rasgos gastos, edad, patrimonio neto y ahorro"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib nur grob Lebenshaltungskosten, Alter, Nettovermögen und Sparrate ein"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une estimation des dépenses, de l’âge, du patrimoine net et de l’épargne suffit"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basta inserire a grandi linee spese, età, patrimonio netto e risparmi"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basta informar por alto gastos, idade, patrimônio líquido e poupança"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Достаточно примерно указать расходы, возраст, чистый капитал и сбережения"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แค่กรอกค่าครองชีพ อายุ ความมั่งคั่งสุทธิ และเงินออมคร่าวๆ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
