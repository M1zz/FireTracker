    "법정동코드를 넣으면 국토부 최근 실거래가를 불러올 수 있어요. 비워두면 금액만 직접 입력합니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter a legal district code to fetch recent sale prices from Korea's Ministry of Land (MOLIT). Leave it blank to enter just the amount yourself."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter a legal district code to fetch recent sale prices from Korea's Ministry of Land (MOLIT). Leave it blank to enter just the amount yourself."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "法定洞コードを入れると、韓国国土交通部の最新の実取引価格を取得できます。空欄なら金額だけを手入力します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "填入法定洞代码，就能获取韩国国土交通部的最新实际成交价。留空则只需手动填写金额。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輸入法定洞代碼，就能取得韓國國土交通部的最新實價登錄。留空則只需手動輸入金額。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con el código de distrito legal puedes cargar los últimos precios de venta reales del Ministerio de Tierras de Corea (MOLIT). Si lo dejas vacío, solo introduces el importe a mano."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem Bezirkscode lassen sich die neuesten Verkaufspreise des koreanischen Bauministeriums (MOLIT) abrufen. Leer lassen, um nur den Betrag einzugeben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec le code de district légal, vous pouvez récupérer le dernier prix de vente du ministère coréen du Territoire (MOLIT). Laissez vide pour saisir seulement le montant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con il codice distretto legale puoi scaricare le ultime compravendite del MOLIT. Se lo lasci vuoto, inserisci solo l’importo a mano."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com o código do distrito legal, buscamos as vendas recentes no Ministério de Terras da Coreia (MOLIT). Deixe em branco para digitar só o valor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Укажите код юридического района, чтобы загрузить недавние сделки Korea's Ministry of Land (MOLIT). Если оставить пустым, введите только сумму."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กรอกรหัสเขตตามกฎหมายเพื่อดึงราคาซื้อขายจริงล่าสุดจากกระทรวงที่ดินเกาหลี (MOLIT) ถ้าเว้นว่างไว้ ให้กรอกจำนวนเงินเอง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập mã khu vực hành chính để lấy giá giao dịch thực tế gần đây của Bộ Đất đai Hàn Quốc (MOLIT). Để trống thì chỉ nhập số tiền."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadejte kód právního obvodu a načtete nedávné transakční ceny z Korea's Ministry of Land (MOLIT). Když pole necháte prázdné, zadáte jen částku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angiv koden for juridisk distrikt for at hente seneste faktiske salgspriser fra MOLIT. Lad feltet være tomt for kun at indtaste beløbet manuelt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με τον κωδικό νομικής περιφέρειας φορτώνετε τις πρόσφατες τιμές συναλλαγών του MOLIT. Αν το αφήσετε κενό, βάζετε μόνο το ποσό χειροκίνητα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oikeudellisen piirin koodilla voit hakea viimeisimmät toteutuneet kauppahinnat Korean maaministeriöstä (MOLIT). Tyhjänä syötät vain summan itse."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan kode distrik hukum untuk memuat harga transaksi terbaru dari MOLIT. Biarkan kosong untuk mengisi jumlahnya sendiri."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv inn koden for juridisk distrikt for å hente siste faktiske salgspriser fra MOLIT. La feltet stå tomt for bare å skrive inn beløpet manuelt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met een code juridisch district halen we recente verkoopprijzen op bij Korea's Ministry of Land (MOLIT). Laat je het leeg, dan vul je alleen het bedrag zelf in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz kod okręgu prawnego, aby pobrać najnowsze ceny transakcyjne z Korea's Ministry of Land (MOLIT). Jeśli zostawisz puste, wpiszesz tylko kwotę."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ange koden för juridiskt distrikt för att hämta senaste faktiska försäljningspriser från MOLIT. Lämna tomt för att bara ange beloppet manuellt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yasal bölge kodunu girerseniz MOLIT’in son gerçek işlem fiyatını çekebilirsiniz. Boş bırakırsanız yalnızca tutarı elle girersiniz."
          }
        }
      }
    },
