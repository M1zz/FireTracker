    "내 시급보다 비싼 시간을 샀어요. 밀도는 올라 보여도 실제로는 %@을 잃었어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koupili jste čas dráž, než je vaše sazba. Hustota sice vypadá vyšší, ale ve skutečnosti jste ztratili %@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du købte tid dyrere end din timeløn. Tætheden ser måske højere ud, men du mistede faktisk %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast Zeit gekauft, die teurer ist als dein Stundenlohn. Die Dichte wirkt höher, aber tatsächlich hast du %@ verloren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αγοράσατε χρόνο ακριβότερο από το ωρομίσθιό σας. Η πυκνότητα φαίνεται να ανεβαίνει, αλλά στην πραγματικότητα χάσατε %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You bought time pricier than your own wage. Density may look higher, but you actually lost %@."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You bought time pricier than your own wage. Density may look higher, but you actually lost %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compraste tiempo más caro que tu valor por hora. Aunque la densidad parezca subir, en realidad perdiste %@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostit aikaa omaa tuntipalkkaasi kalliimmalla. Tiheys näyttää kasvaneen, mutta todellisuudessa menetit %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez acheté du temps plus cher que votre taux horaire. La densité semble augmenter, mais vous avez en réalité perdu %@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda membeli waktu yang lebih mahal dari upah per jam Anda. Kepadatan tampak naik, tapi sebenarnya Anda kehilangan %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai comprato tempo più caro della tua paga oraria. La densità sembra salita, ma in realtà hai perso %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分の時給より高い時間を買いました。密度は上がって見えても、実際には%@を失いました。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kjøpte tid dyrere enn timelønnen din. Tettheten kan se høyere ut, men du tapte faktisk %@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kocht tijd die duurder is dan je eigen uurloon. De dichtheid lijkt hoger, maar eigenlijk verloor je %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kupiłeś czas drożej niż twoja stawka. Gęstość niby wzrosła, ale faktycznie straciłeś %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você comprou tempo mais caro que a sua hora. A densidade parece maior, mas na prática você perdeu %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы купили время дороже своей ставки. Плотность вроде выросла, но на деле вы потеряли %@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du köpte tid dyrare än din timlön. Tätheten kan se högre ut, men du förlorade faktiskt %@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณซื้อเวลาที่แพงกว่าค่าแรงของตัวเอง ความหนาแน่นดูเหมือนสูงขึ้น แต่ที่จริงเสีย %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kendi saatlik ücretinizden pahalı zaman aldınız. Yoğunluk artmış görünse de aslında %@ kaybettiniz."
