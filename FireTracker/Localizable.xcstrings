    "시급 성장이 자산 수익보다 느려요. 지금부터는 번 시간을 저장해서 자산이 대신 벌게 하는 쪽이 유리해요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše sazba roste pomaleji než výnos majetku. Odteď je výhodnější vydělané spořit, aby za vás vydělával majetek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din timeløn vokser langsommere end afkastet af dine aktiver. Fra nu af betaler det sig at spare den tid, du tjener, og lade aktiverne tjene for dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Lohn wächst langsamer als deine Anlageerträge. Ab jetzt lohnt es sich, verdiente Zeit zu sparen und dein Vermögen für dich verdienen zu lassen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ωρομίσθιο μεγαλώνει πιο αργά από την απόδοση της περιουσίας. Από εδώ και πέρα συμφέρει να αποταμιεύετε τον χρόνο που κερδίζετε και να αφήνετε την περιουσία να κερδίζει για εσάς."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your wage is growing slower than your asset returns. From now on, it's better to save the time you earn and let your assets earn for you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your wage is growing slower than your asset returns. From now on, it's better to save the time you earn and let your assets earn for you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu valor por hora crece más despacio que el rendimiento de tus activos. A partir de ahora conviene ahorrar el tiempo ganado y dejar que tus activos ganen por ti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuntipalkkasi kasvaa hitaammin kuin varojen tuotto. Tästä eteenpäin kannattaa säästää ansaittu aika ja antaa varojen tienata puolestasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre taux horaire progresse moins vite que le rendement de vos actifs. Désormais, mieux vaut épargner le temps gagné et laisser vos actifs travailler à votre place."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pertumbuhan upah per jam lebih lambat dari imbal hasil aset. Mulai sekarang, lebih untung menabung hasil kerja agar aset yang bekerja untuk Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La paga oraria cresce più lentamente del rendimento del patrimonio. Da ora conviene risparmiare il tempo guadagnato e lasciare che sia il patrimonio a guadagnare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時給の伸びが資産の収益より遅くなっています。ここからは稼いだ時間を貯めて、資産に代わりに稼いでもらうほうが有利です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timelønnen vokser saktere enn avkastningen på eiendelene. Fra nå av lønner det seg å spare tiden du tjener, og la eiendelene tjene for deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je uurloon groeit trager dan het rendement op je bezittingen. Vanaf nu kun je verdiende tijd beter opsparen en je bezittingen voor je laten verdienen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja stawka rośnie wolniej niż zwrot z aktywów. Od teraz lepiej odkładać zarobione, by aktywa pracowały za ciebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu valor por hora cresce mais devagar que o retorno dos ativos. A partir de agora, vale mais poupar o que ganha e deixar os ativos trabalharem por você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша ставка растёт медленнее доходности активов. Теперь выгоднее откладывать заработанное, чтобы деньги работали за вас."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timlönen växer långsammare än tillgångarnas avkastning. Från och med nu lönar det sig att spara tiden du tjänar och låta tillgångarna tjäna åt dig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ค่าแรงโตช้ากว่าผลตอบแทนสินทรัพย์ ต่อจากนี้การเก็บเวลาที่หาได้ไว้แล้วให้สินทรัพย์ทำเงินแทนจะได้เปรียบกว่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saatlik ücret büyümesi varlık getirisinden yavaş. Artık kazandığınız zamanı biriktirip varlıklarınızın sizin yerinize kazanmasını sağlamak daha avantajlı."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lương giờ tăng chậm hơn lợi suất tài sản. Từ giờ, tích lũy thời gian đã kiếm để tài sản kiếm thay bạn sẽ có lợi hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "时薪增长已慢于资产收益。从现在起，把赚来的时间存起来，让资产替你赚钱更划算。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時薪成長已慢於資產收益。從現在起，把賺來的時間存起來，讓資產替你賺錢比較划算。"
          }
        }
      }
    },
