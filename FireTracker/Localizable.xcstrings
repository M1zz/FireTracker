        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พื้นที่แรเงาคือช่วงที่ครอบคลุมผลลัพธ์ 8 ใน 10 ระยะเวลายิ่งนานยิ่งกว้าง"
