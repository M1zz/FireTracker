    "예정된 수입만 더한 값입니다. 주식·부동산 등 자산 가치가 오를 거라는 가정은 넣지 않았어요." : {
      "comment" : "The footer text for the `ProjectionDetailView`.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sčítají se jen plánované příjmy. Nepředpokládá se růst hodnoty akcií, nemovitostí ani jiného majetku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det lægger kun planlagt indkomst sammen. Der antages ikke stigende værdi af aktier, ejendomme eller andre aktiver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier werden nur geplante Einnahmen addiert. Es wird nicht angenommen, dass Aktien, Immobilien oder andere Vermögen im Wert steigen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προστίθενται μόνο τα προγραμματισμένα έσοδα. Δεν υποθέτει ότι οι μετοχές, τα ακίνητα ή άλλα περιουσιακά στοιχεία θα αυξηθούν σε αξία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This only adds scheduled income. It doesn't assume stocks, property or other assets will rise in value."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This only adds scheduled income. It doesn't assume stocks, property or other assets will rise in value."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto solo suma ingresos previstos. No supone que suban de valor las acciones, los inmuebles u otros activos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä laskee vain suunnitellut tulot yhteen. Se ei oleta osakkeiden, kiinteistöjen tai muiden varojen arvon nousevan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela n’additionne que les revenus prévus. Cela ne suppose pas que les actions, l’immobilier ou d’autres actifs prendront de la valeur."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini hanya menjumlahkan pendapatan terjadwal. Tidak mengasumsikan saham, properti, atau aset lain naik nilainya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somma solo le entrate programmate. Non ipotizza che azioni, immobili o altre attività salgano di valore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予定された収入だけを足した値です。株式や不動産などの資産価値が上がるという仮定は入れていません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette legger bare sammen planlagt inntekt. Det antar ikke at aksjer, eiendom eller andre eiendeler stiger i verdi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit telt alleen geplande inkomsten op. Het neemt niet aan dat aandelen, vastgoed of andere bezittingen in waarde stijgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To sumuje tylko planowane przychody. Nie zakłada wzrostu wartości akcji, nieruchomości ani innych aktywów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soma apenas a receita prevista. Não supõe que ações, imóveis ou outros ativos vão se valorizar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь суммируется только запланированный доход. Рост стоимости акций, недвижимости и других активов не предполагается."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta summerar bara planerade inkomster. Det antar inte att aktier, fastigheter eller andra tillgångar stiger i värde."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เป็นค่าที่บวกเฉพาะรายได้ที่กำหนดไว้ ไม่ได้สมมติว่าหุ้น อสังหาริมทรัพย์ หรือสินทรัพย์อื่นจะมีมูลค่าเพิ่มขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu yalnızca planlı gelirleri toplar. Hisse, gayrimenkul veya diğer varlıkların değer kazanacağını varsaymaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đây chỉ là tổng thu nhập đã dự kiến. Không giả định cổ phiếu, bất động sản hay tài sản khác sẽ tăng giá trị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这只是加上预定收入后的值。没有假设股票、房产等资产价值会上涨。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
