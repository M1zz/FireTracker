    "번 시급과 산 시급이 같아요. 밀도는 올랐지만 시간이 자리만 옮겼을 뿐, 늘지는 않았어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your earned and bought rates are the same. Density went up, but time only moved around; it didn't grow."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your earned and bought rates are the same. Density went up, but time only moved around; it didn't grow."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "稼ぐ時給と買う時給が同じです。密度は上がりましたが、時間が場所を移しただけで増えてはいません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "赚的时薪和买的时薪一样。密度提高了，但时间只是换了位置，并没有变多。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "賺的時薪和買的時薪一樣。密度提高了，但時間只是換了位置，並沒有變多。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu valor por hora ganado y el comprado son iguales. La densidad sube, pero el tiempo solo cambia de sitio; no aumenta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verdienter und gekaufter Stundenlohn sind gleich. Die Dichte ist gestiegen, aber die Zeit hat nur den Platz getauscht, nicht zugenommen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taux gagné et taux acheté sont égaux. La densité augmente, mais le temps n’a fait que changer de place, sans s’allonger."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paga guadagnata e comprata coincidono. La densità è salita, ma il tempo si è solo spostato, non è aumentato."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua hora e a hora comprada valem o mesmo. A densidade subiu, mas o tempo só mudou de lugar, sem aumentar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша ставка равна ставке купленного времени. Плотность выросла, но время лишь переместилось, а не прибавилось."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ค่าแรงที่หาได้เท่ากับค่าแรงที่ซื้อ ความหนาแน่นสูงขึ้นก็จริง แต่เวลาแค่ย้ายที่ ไม่ได้เพิ่มขึ้น"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lương giờ kiếm được bằng lương giờ mua. Mật độ tăng nhưng thời gian chỉ dời chỗ, không nhiều thêm."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše sazba je stejná jako sazba koupeného času. Hustota vzrostla, ale čas se jen přesunul, nepřibyl."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optjent og købt timeløn er ens. Tætheden steg, men tiden blev bare flyttet – der kom ikke mere af den."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ωρομίσθιό σας και το αγορασμένο είναι ίδια. Η πυκνότητα ανέβηκε, αλλά ο χρόνος απλώς άλλαξε θέση, δεν αυξήθηκε."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ansaittu ja ostettu tuntihinta ovat samat. Tiheys kasvoi, mutta aika vain vaihtoi paikkaa eikä lisääntynyt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upah per jam yang didapat dan yang dibeli sama. Kepadatan naik, tapi waktu hanya berpindah tempat, tidak bertambah."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opptjent og kjøpt timelønn er like. Tettheten økte, men tiden ble bare flyttet – det ble ikke mer av den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verdiend en gekocht uurloon zijn gelijk. De dichtheid steeg, maar je tijd is alleen verschoven, er kwam niets bij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja stawka równa się stawce kupionego czasu. Gęstość wzrosła, ale czas tylko się przesunął, a nie przybył."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intjänad och köpt timlön är lika. Tätheten ökade, men tiden bara flyttades – den blev inte mer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kazanılan ve alınan saatlik ücret aynı. Yoğunluk arttı ama zaman yalnızca yer değiştirdi, artmadı."
          }
        }
      }
    },
    "번 시급이 산 시급보다 비싸요. 두께가 진짜로 %@만큼 늘었어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your earned rate is higher than your bought rate. Your day really got thicker by %@."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your earned rate is higher than your bought rate. Your day really got thicker by %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "稼ぐ時給が買う時給より高いです。1日の厚みが本当に%@分増えました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "赚的时薪比买的时薪高。一天真的变厚了%@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "賺的時薪比買的時薪高。一天真的變厚了%@。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu valor por hora ganado supera al comprado. Tu día se ha alargado de verdad %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein verdienter Stundenlohn ist höher als der gekaufte. Dein Tag ist wirklich um %@ dicker geworden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre taux horaire gagné dépasse le taux horaire acheté. Votre journée s’est vraiment épaissie de %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La paga oraria guadagnata supera quella comprata. Lo spessore è davvero aumentato di %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua hora vale mais do que a hora que comprou. O dia ficou de fato %@ mais espesso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша ставка выше ставки купленного времени. День действительно стал толще на %@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ค่าแรงที่หาได้สูงกว่าค่าแรงที่ซื้อ ความหนาของวันเพิ่มขึ้นจริง %@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lương giờ kiếm được cao hơn lương giờ mua. Độ dày thực sự tăng thêm %@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše sazba je vyšší než sazba koupeného času. Den opravdu ztloustl o %@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din optjente timeløn er højere end den købte. Dagen blev faktisk %@ tykkere."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ωρομίσθιό σας είναι ακριβότερο από το ωρομίσθιο που αγοράσατε. Η ημέρα σας πραγματικά πάχυνε κατά %@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ansaittu tuntihinta on suurempi kuin ostettu. Päivä todella paksuuntui %@ verran."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upah per jam yang didapat lebih mahal dari upah per jam yang dibeli. Ketebalan hari benar-benar bertambah %@."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den opptjente timelønnen er høyere enn den kjøpte. Dagen ble faktisk %@ tykkere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je verdiende uurloon is hoger dan het gekochte. Je dag is echt %@ dikker geworden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja stawka jest wyższa niż stawka kupionego czasu. Dzień naprawdę pogrubiał o %@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
