    "증권사 앱 화면을 캡처하면 종목과 평가액을 한 번에 불러와요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pořiďte snímek obrazovky aplikace brokera a naimportujte pozice i hodnoty najednou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag et skærmbillede af din mægler-app for at importere positioner og værdier på én gang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach einen Screenshot deiner Broker-App, um Positionen und Werte auf einmal zu importieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τραβήξτε στιγμιότυπο της εφαρμογής του χρηματιστή σας για να εισαγάγετε θέσεις και αξίες μονομιάς."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take a screenshot of your brokerage app to import holdings and values in one go."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take a screenshot of your brokerage app to import holdings and values in one go."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz una captura de la app de tu bróker para importar valores y saldos de una vez."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota kuvakaappaus välittäjäsi apista tuodaksesi positiot ja arvot kerralla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenez une capture de l’app de votre courtier pour importer positions et valeurs d’un coup."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambil tangkapan layar app broker Anda untuk mengimpor posisi dan nilai sekaligus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai uno screenshot dell’app del tuo broker per importare titoli e valori in un colpo solo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "証券会社アプリのスクリーンショットを撮ると、保有銘柄と評価額をまとめて取り込めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "증권사 앱 화면을 캡처하면 종목과 평가액을 한 번에 불러와요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta et skjermbilde av meglerappen din for å importere posisjoner og verdier på én gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak een schermafbeelding van de app van je broker om posities en waarden in één keer te importeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zrób zrzut aplikacji brokera, aby zaimportować pozycje i wartości za jednym razem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tire uma captura do app da sua corretora para importar ativos e valores de uma vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сделайте скриншот приложения брокера, чтобы сразу импортировать позиции и стоимость."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta en skärmbild av din mäklares app för att importera positioner och värden på en gång."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แคปหน้าจอแอปโบรกเกอร์เพื่อนำเข้ารายการและมูลค่าในครั้งเดียว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozisyonları ve değerleri tek seferde almak için aracı kurum uygulamanızın ekran görüntüsünü alın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chụp màn hình ứng dụng công ty chứng khoán để nhập mã và giá trị một lần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "截一张券商App的屏幕，就能一次性导入持仓和估值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "截一張券商App的螢幕，就能一次性匯入持倉和估值。"
          }
        }
      }
    },
    "증권사 앱에서 지금 가격을 다시 보고 파세요. 판 다음엔 ‘팔았으면 기록하기’로 수량을 고쳐 두세요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Před prodejem zkontrolujte aktuální cenu v aplikaci brokera. Po prodeji upravte množství přes „Zapsat prodej“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjek den aktuelle kurs i din mæglerapp, før du sælger. Opdater derefter antallet med ‘Registrér salget’."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe vor dem Verkauf den aktuellen Kurs in deiner Broker-App. Danach die Stückzahl mit „Verkauf erfassen“ anpassen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ελέγξτε την τρέχουσα τιμή στην εφαρμογή του χρηματιστή πριν πουλήσετε. Μετά, ενημερώστε την ποσότητα με «Καταγραφή πώλησης»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the live price in your brokerage app before selling. After you sell, update the quantity with ‘Record the sale’."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the live price in your brokerage app before selling. After you sell, update the quantity with ‘Record the sale’."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta el precio actual en tu app de bróker antes de vender. Después, actualiza la cantidad con «Registrar la venta»."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkista nykyinen hinta välittäjäsovelluksesta ennen myyntiä. Päivitä sen jälkeen määrä kohdasta ”Kirjaa myynti”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez le prix actuel dans votre app de courtage avant de vendre. Ensuite, mettez à jour la quantité avec « Enregistrer la vente »."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cek harga terkini di aplikasi sekuritas sebelum menjual. Setelah menjual, perbarui jumlahnya lewat ‘Catat penjualan’."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla il prezzo attuale nell’app del broker prima di vendere. Dopo, aggiorna la quantità con «Registra la vendita»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "証券アプリで今の価格を確認してから売ってください。売ったら「売ったら記録」で数量を直しておきましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "증권사 앱에서 지금 가격을 다시 보고 파세요. 판 다음엔 ‘팔았으면 기록하기’로 수량을 고쳐 두세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjekk dagens kurs i meglerappen før du selger. Oppdater deretter antallet med ‘Registrer salget’."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleer de actuele koers in je broker-app voordat je verkoopt. Werk daarna het aantal bij met ‘Verkoop vastleggen’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przed sprzedażą sprawdź aktualną cenę w aplikacji brokera. Po sprzedaży zaktualizuj ilość przez „Zapisz sprzedaż”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confira o preço atual no app da corretora antes de vender. Depois, atualize a quantidade em “Registrar a venda”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед продажей проверьте текущую цену в приложении брокера. После продажи обновите количество через «Записать продажу»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolla aktuellt pris i din mäklarapp innan du säljer. Uppdatera sedan antalet med ”Registrera försäljningen”."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจราคาล่าสุดในแอปโบรกเกอร์ก่อนขาย ขายแล้วให้แก้จำนวนด้วย ‘บันทึกการขาย’"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satmadan önce aracı kurum uygulamanızda güncel fiyatı kontrol edin. Sattıktan sonra adedi “Satışı kaydet” ile güncelleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy xem giá hiện tại trong ứng dụng chứng khoán trước khi bán. Bán xong, cập nhật số lượng bằng ‘Ghi lại giao dịch bán’."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先在券商App中确认当前价格再卖出。卖出后，用“卖出后记录”更新数量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請先在券商App中確認當前價格再賣出。賣出後，用「賣出後記錄」更新數量。"
          }
        }
      }
    },
