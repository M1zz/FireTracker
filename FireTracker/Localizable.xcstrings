    "막대는 카테고리별 자산, 라인은 부채를 뺀 순자산이에요." : {
      "comment" : "A description of the chart.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sloupce jsou majetek podle kategorií, čára je čisté jmění po odečtení dluhu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søjlerne er aktiver pr. kategori, linjen er nettoformuen efter gæld."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Balken zeigen das Vermögen nach Kategorie, die Linie das Nettovermögen nach Schulden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι μπάρες είναι τα περιουσιακά στοιχεία ανά κατηγορία, η γραμμή η καθαρή περιουσία μετά το χρέος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bars show assets by category; the line is net worth after debt."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bars show assets by category; the line is net worth after debt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las barras son activos por categoría; la línea es el patrimonio neto tras restar la deuda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palkit ovat varat luokittain, viiva on nettovarallisuus velan jälkeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les barres montrent les actifs par catégorie ; la ligne, le patrimoine net après dette."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batang adalah aset per kategori, garis adalah kekayaan bersih setelah utang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le barre sono le attività per categoria; la linea è il patrimonio netto dopo i debiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "棒はカテゴリ別の資産、線は負債を引いた純資産です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søylene er eiendeler per kategori, linjen er nettoformuen etter gjeld."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De balken zijn bezittingen per categorie, de lijn is het nettovermogen na schuld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Słupki to aktywa według kategorii, linia to wartość netto po odjęciu długu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
