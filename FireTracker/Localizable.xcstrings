    "각 기록 시점에 ‘내 목표’에 적어 둔 월급·지출로 계산했어요. 실제와 다르면 기록을 눌러 수입·지출을 고쳐 주세요." : {
      "comment" : "A description of how the savings rate is calculated.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculated from the income and spending set in ‘My Goals’ at each record's time. If that's off, tap a record and fix the income and spending."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculated from the income and spending set in ‘My Goals’ at each record's time. If that's off, tap a record and fix the income and spending."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各記録の時点で「マイ目標」に入れた給料・支出で計算しています。実際と違う場合は記録をタップして収入・支出を直してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按每条记录当时在“我的目标”里填的月薪和支出计算。如与实际不符，请点开记录修改收入和支出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按每條記錄當時在「我的目標」裡填的月薪和支出計算。如與實際不符，請點開記錄修改收入和支出。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculado con el sueldo y los gastos de «Mis objetivos» en el momento de cada registro. Si no coinciden con la realidad, toca el registro y corrige ingresos y gastos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berechnet mit dem Gehalt und den Ausgaben, die du bei jedem Eintrag unter „Meine Ziele“ hinterlegt hattest. Stimmt das nicht, tippe auf den Eintrag und korrigiere Einnahmen und Ausgaben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculé avec le salaire et les dépenses saisis dans « Mes objectifs » à chaque enregistrement. Si ce n’est pas exact, touchez l’enregistrement et corrigez revenus et dépenses."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calcolato con stipendio e spese inseriti in «I miei obiettivi» al momento di ogni registrazione. Se non corrisponde, tocca la registrazione e correggi entrate e spese."
          }
        }
      }
    },
    "값" : {
      "comment" : "A line that represents the actual trend of a metric over time.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Value"
          }
        },
