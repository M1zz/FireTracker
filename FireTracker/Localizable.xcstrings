          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stačí zhruba zadat výdaje, věk, čisté jmění a spoření"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angiv bare cirka leveomkostninger, alder, nettoformue og opsparing"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αρκεί μια πρόχειρη εκτίμηση για κόστος ζωής, ηλικία, καθαρή περιουσία και αποταμίευση"
          }
        },
        "fi" : {
          "stringUnit" : {
