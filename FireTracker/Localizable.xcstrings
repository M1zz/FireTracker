    "목표까지 %@원 부족해요. 기간·납입액·이자율을 올려보세요." : {
      "comment" : "Displays a warning when the user hasn't saved enough to reach their goal.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K cíli chybí %@ wonů. Zkuste zvýšit dobu, vklad nebo úrok."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du mangler %@ won til målet. Prøv at hæve perioden, indbetalingen eller renten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dir fehlen %@ Won bis zum Ziel. Erhöhe Laufzeit, Einzahlung oder Zins."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λείπουν %@ γουόν για τον στόχο. Δοκιμάστε να αυξήσετε τη διάρκεια, την καταβολή ή το επιτόκιο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're %@ won short of the goal. Try raising the period, contributions or interest rate."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're %@ won short of the goal. Try raising the period, contributions or interest rate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te faltan %@ wones para el objetivo. Prueba a subir el plazo, la aportación o el interés."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tavoitteeseen puuttuu %@ wonia. Kokeile pidentää aikaa tai nostaa talletusta tai korkoa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il manque %@ wons pour atteindre l’objectif. Essayez d’allonger la durée ou d’augmenter les versements ou le taux."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurang %@ won dari target. Coba naikkan jangka waktu, setoran, atau suku bunga."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mancano %@ won all’obiettivo. Prova ad aumentare durata, versamento o tasso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標まで%@ウォン足りません。期間・積立額・利率を上げてみましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du mangler %@ won til målet. Prøv å øke perioden, innbetalingen eller renten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je komt %@ won tekort voor het doel. Probeer de looptijd, storting of rente te verhogen."
