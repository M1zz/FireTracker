    "고르면 바로 그 카테고리의 종목 입력으로 이어져요. 종목을 저장하면 목록에 카테고리가 생깁니다." : {
      "comment" : "A description of the functionality of the category picker sheet.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick one to go straight to entering a holding in that category. Saving it adds the category to your list."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick one to go straight to entering a holding in that category. Saving it adds the category to your list."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選ぶとそのまま、そのカテゴリの銘柄入力に進みます。銘柄を保存すると一覧にカテゴリが作られます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择后会直接进入该类别的持仓输入。保存持仓后，列表中会出现该类别。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇後會直接進入該類別的持倉輸入。儲存持倉後，列表中會出現該類別。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al elegir uno pasas directo a introducir un valor de esa categoría. Al guardarlo, la categoría aparece en la lista."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du eine Kategorie wählst, geht es direkt zur Eingabe einer Position dort. Beim Speichern erscheint die Kategorie in der Liste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En choisissant, vous passez directement à la saisie d’une position de cette catégorie. L’enregistrer crée la catégorie dans la liste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegliendo, passi subito all’inserimento di un titolo di quella categoria. Salvandolo, la categoria compare nell’elenco."
          }
        }
      }
    },
