    "지금 월급 %@은 %@년 월급을 오늘 물가로 옮긴 %@보다 %@ 많아요." : {
      "comment" : "A text that compares the real wage (what you can buy with your salary) from a past year to the current year. If the result is positive, it means that your salary has increased. If the result is negative, it means that your salary has decreased.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "지금 월급 %1$@은 %2$@년 월급을 오늘 물가로 옮긴 %3$@보다 %4$@ 많아요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your salary now, %1$@, is %4$@ more than your %2$@ salary in today's prices (%3$@)."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your salary now, %1$@, is %4$@ more than your %2$@ salary in today's prices (%3$@)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の月給%1$@は、%2$@年の月給を今の物価に換算した%3$@より%4$@多いです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在的月薪%1$@，比把%2$@年的月薪折算成今天物价后的%3$@多%4$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在的月薪%1$@，比把%2$@年的月薪折算成今天物價後的%3$@多%4$@。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu sueldo actual, %1$@, es un %4$@ superior al de %2$@ a precios de hoy (%3$@)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein jetziges Gehalt %1$@ liegt %4$@ über dem Gehalt von %2$@ in heutigen Preisen (%3$@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre salaire actuel, %1$@, est supérieur de %4$@ à celui de %2$@ aux prix d’aujourd’hui (%3$@)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo stipendio attuale %1$@ è superiore del %4$@ a quello del %2$@ ai prezzi di oggi (%3$@)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu salário atual, %1$@, é %4$@ maior que o de %2$@ a preços de hoje (%3$@)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша нынешняя зарплата %1$@ на %4$@ больше зарплаты %2$@ г. в сегодняшних ценах (%3$@)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เงินเดือนตอนนี้ %1$@ มากกว่าเงินเดือนปี %2$@ ที่แปลงเป็นราคาวันนี้ (%3$@) อยู่ %4$@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lương hiện tại %1$@ nhiều hơn %4$@ so với lương năm %2$@ quy đổi theo giá hôm nay (%3$@)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše současná mzda %1$@ je o %4$@ vyšší než mzda z roku %2$@ přepočtená na dnešní ceny (%3$@)."
