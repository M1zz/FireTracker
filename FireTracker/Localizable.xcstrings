    "각 기록 시점에 ‘내 목표’에 적어 둔 월급·지출로 계산했어요. 실제와 다르면 기록을 눌러 수입·지출을 고쳐 주세요." : {
      "comment" : "A description of how the savings rate is calculated.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypočteno z mzdy a výdajů nastavených v „Mých cílech“ v době každého záznamu. Pokud to nesedí, klepněte na záznam a opravte příjmy a výdaje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beregnet ud fra løn og udgifter i „Mine mål“ på tidspunktet for hver registrering. Passer det ikke, så tryk på registreringen og ret indtægter og udgifter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berechnet mit dem Gehalt und den Ausgaben, die du bei jedem Eintrag unter „Meine Ziele“ hinterlegt hattest. Stimmt das nicht, tippe auf den Eintrag und korrigiere Einnahmen und Ausgaben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Υπολογίστηκε με τον μισθό και τα έξοδα που είχατε ορίσει στους «Στόχους μου» τη στιγμή κάθε καταγραφής. Αν δεν ταιριάζει με την πραγματικότητα, πατήστε στην καταγραφή και διορθώστε έσοδα και έξοδα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculated from the income and spending set in ‘My Goals’ at each record's time. If that's off, tap a record and fix the income and spending."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculated from the income and spending set in ‘My Goals’ at each record's time. If that's off, tap a record and fix the income and spending."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculado con el sueldo y los gastos de «Mis objetivos» en el momento de cada registro. Si no coinciden con la realidad, toca el registro y corrige ingresos y gastos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laskettu merkinnän ajankohdan ”Omat tavoitteet” -kohtaan asetetulla palkalla ja menoilla. Jos ne eivät pidä paikkaansa, napauta merkintää ja korjaa tulot ja menot."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculé avec le salaire et les dépenses saisis dans « Mes objectifs » à chaque enregistrement. Si ce n’est pas exact, touchez l’enregistrement et corrigez revenus et dépenses."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dihitung dari gaji dan pengeluaran di “Target Saya” pada saat tiap catatan. Jika tidak sesuai, ketuk catatan dan perbaiki pemasukan dan pengeluaran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calcolato con stipendio e spese inseriti in «I miei obiettivi» al momento di ogni registrazione. Se non corrisponde, tocca la registrazione e correggi entrate e spese."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各記録の時点で「マイ目標」に入れた給料・支出で計算しています。実際と違う場合は記録をタップして収入・支出を直してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beregnet ut fra lønn og utgifter satt i «Mine mål» på tidspunktet for hver registrering. Stemmer det ikke, trykk på registreringen og rett inntekter og utgifter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berekend met het salaris en de uitgaven die je bij elke registratie in ‘Mijn doelen’ had gezet. Klopt dat niet, tik dan op de registratie en corrigeer inkomsten en uitgaven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obliczone z pensji i wydatków ustawionych w „Moich celach” w chwili każdego zapisu. Jeśli się nie zgadza, stuknij zapis i popraw przychody i wydatki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculado com o salário e os gastos definidos em “Minhas metas” na data de cada registro. Se não bater com a realidade, toque no registro e corrija receitas e gastos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рассчитано по зарплате и расходам, указанным в «Моих целях» на момент каждой записи. Если это не так, нажмите на запись и исправьте доходы и расходы."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beräknat med lönen och utgifterna som angetts i ”Mina mål” vid tidpunkten för varje registrering. Stämmer det inte, tryck på registreringen och rätta inkomster och utgifter."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำนวณจากเงินเดือนและรายจ่ายที่ตั้งไว้ใน “เป้าหมายของฉัน” ณ เวลาของแต่ละบันทึก ถ้าไม่ตรงกับความจริง แตะบันทึกแล้วแก้รายรับ-รายจ่าย"
