    "하나만 골라 바꿔 보고, 다음 기록에서 확인하세요." : {
      "comment" : "A description of the benefits of changing the amount saved each month.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick just one to change, and check it on your next record."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick just one to change, and check it on your next record."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1つだけ選んで変え、次の記録で確かめてみましょう。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只选一项来改，下次记录时再确认。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只選一項來改，下次記錄時再確認。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige solo uno para cambiarlo y compruébalo en tu próximo registro."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle nur eines zum Ändern und prüfe es beim nächsten Eintrag."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez-en un seul à modifier et vérifiez-le à votre prochain enregistrement."
