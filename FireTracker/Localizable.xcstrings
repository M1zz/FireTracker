          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "年金・車・生活防衛資金・暗号資産・保険・全貸保証金など、抜けている資産があれば追加してみてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
