        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Même en dépensant %2$@ wons par mois après votre départ (%1$lld ans), il vous reste %4$@ wons à %3$lld ans."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah pensiun (usia %1$lld), meski memakai %2$@ won per bulan, masih tersisa %4$@ won di usia %3$lld."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andando in pensione a %1$lld anni e spendendo %2$@ won al mese, a %3$lld anni ti restano %4$@ won."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退職（%lld歳）後に月%@ウォン使っても、%lld歳で%@ウォン残ります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etter pensjonering som %lld kan du bruke %@ won i måneden og fortsatt ha igjen som %lld: %@ won."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ook als je na het stoppen (op je %lld) %@ won per maand uitgeeft, heb je op je %lld nog %@ won over."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po odejściu w wieku %lld lat możesz wydawać %@ wonów miesięcznie, a w wieku %lld lat zostanie ci jeszcze %@ wonów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parando aos %1$lld e gastando %2$@ wons por mês, ainda sobram %4$@ wons aos %3$lld anos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После ухода в %lld можно тратить %@ вон в месяц — и к %lld ещё останется %@ вон."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efter pensionen vid %lld kan du göra av med %@ won i månaden och ändå ha kvar vid %lld års ålder: %@ won."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หลังเกษียณ (อายุ %1$lld ปี) ใช้เดือนละ %2$@ วอน ก็ยังเหลือ %4$@ วอนตอนอายุ %3$lld ปี"
          }
        },
        "tr" : {
          "stringUnit" : {
