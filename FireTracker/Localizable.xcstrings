    "가운데 선은 보통의 경우, 색칠한 띠는 좋을 때(상위 10%)와 나쁠 때(하위 10%) 사이예요. 점선이 퇴사하는 해예요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The line is the typical case; the band runs from good (top 10%) to bad (bottom 10%) markets. The dashed line is the year you quit."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가운데 선은 보통의 경우, 색칠한 띠는 좋을 때(상위 10%)와 나쁠 때(하위 10%) 사이예요. 점선이 퇴사하는 해예요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The line is the typical case; the band runs from good (top 10%) to bad (bottom 10%) markets. The dashed line is the year you quit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中央の線は標準的なケース、色付きの帯は好調な相場（上位10%）と不調な相場（下位10%）の間です。点線が退職する年です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中间的线是一般情况，色带是行情好（前10%）与行情差（后10%）之间。虚线是你辞职的那一年。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中間的線是一般情況，色帶是行情好（前10%）與行情差（後10%）之間。虛線是你離職的那一年。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La línea es el caso típico; la banda va de los mercados buenos (10 % superior) a los malos (10 % inferior). La línea discontinua es el año en que lo dejas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Linie zeigt den typischen Fall, das Band reicht von guten (obere 10 %) bis schlechten Märkten (untere 10 %). Die gestrichelte Linie ist das Jahr deines Ausstiegs."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ligne est le cas typique ; la bande va des bons marchés (10 % supérieurs) aux mauvais (10 % inférieurs). La ligne pointillée est l’année de votre départ."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La linea è il caso tipico; la fascia va dai mercati buoni (10% superiore) ai cattivi (10% inferiore). La linea tratteggiata è l’anno in cui smetti."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A linha é o caso típico; a faixa vai dos mercados bons (10% superiores) aos ruins (10% inferiores). A linha tracejada é o ano em que você para."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Линия — типичный случай, полоса — от хорошего рынка (верхние 10 %) до плохого (нижние 10 %). Пунктир — год ухода."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เส้นกลางคือกรณีทั่วไป แถบสีคือช่วงระหว่างตลาดดี (10% บน) กับตลาดแย่ (10% ล่าง) เส้นประคือปีที่ออกจากงาน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đường giữa là trường hợp thông thường, dải màu nằm giữa thị trường tốt (10% trên) và xấu (10% dưới). Đường đứt nét là năm bạn nghỉ việc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čára je typický případ, pás sahá od dobrých trhů (horních 10 %) po špatné (dolních 10 %). Čárkovaná čára je rok vašeho odchodu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linjen er det typiske forløb, båndet går fra gode (øverste 10 %) til dårlige (nederste 10 %) markeder. Den stiplede linje er det år, du stopper."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η γραμμή είναι η τυπική περίπτωση· η ζώνη εκτείνεται από καλές (άνω 10%) έως κακές (κάτω 10%) αγορές. Η διακεκομμένη γραμμή είναι το έτος αποχώρησής σας."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viiva on tyypillinen tapaus, alue ulottuu hyvistä (ylin 10 %) huonoihin (alin 10 %) markkinoihin. Katkoviiva on lopetusvuotesi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garis adalah kasus umum; pita membentang dari pasar bagus (10% teratas) hingga buruk (10% terbawah). Garis putus-putus adalah tahun Anda berhenti."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linjen er det typiske forløpet, båndet går fra gode (øverste 10 %) til dårlige (nederste 10 %) markeder. Den stiplede linjen er året du slutter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De lijn is het typische geval; de band loopt van goede (bovenste 10%) tot slechte (onderste 10%) markten. De stippellijn is het jaar waarin je stopt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linia to typowy przypadek, pas rozciąga się od dobrych (górne 10%) do złych (dolne 10%) rynków. Linia przerywana to rok twojego odejścia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linjen är det typiska fallet, bandet går från bra (översta 10 %) till dåliga (understa 10 %) marknader. Den streckade linjen är året du slutar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çizgi tipik durumdur; bant iyi (üst %10) ile kötü (alt %10) piyasalar arasındadır. Kesikli çizgi bıraktığınız yıldır."
          }
        }
      }
