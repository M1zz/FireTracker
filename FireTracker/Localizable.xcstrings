    "투자 원금 (산 가격, 원)" : {
      "comment" : "A label for the user to enter the original price of the asset.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
