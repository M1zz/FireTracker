    "목표까지 %@원 부족해요. 기간·납입액·이자율을 올려보세요." : {
      "comment" : "Displays a warning when the user hasn't saved enough to reach their goal.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're %@ won short of the goal. Try raising the period, contributions or interest rate."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're %@ won short of the goal. Try raising the period, contributions or interest rate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標まで%@ウォン足りません。期間・積立額・利率を上げてみましょう。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "距目标还差%@韩元。试试提高期限、缴存额或利率。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "距目標還差%@韓元。試試提高期限、繳存額或利率。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te faltan %@ wones para el objetivo. Prueba a subir el plazo, la aportación o el interés."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dir fehlen %@ Won bis zum Ziel. Erhöhe Laufzeit, Einzahlung oder Zins."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il manque %@ wons pour atteindre l’objectif. Essayez d’allonger la durée ou d’augmenter les versements ou le taux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mancano %@ won all’obiettivo. Prova ad aumentare durata, versamento o tasso."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faltam %@ wons para a meta. Tente aumentar o prazo, o aporte ou a taxa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "До цели не хватает %@ вон. Увеличьте срок, взносы или ставку."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขาดอีก %@ วอนถึงเป้าหมาย ลองเพิ่มระยะเวลา เงินฝาก หรืออัตราดอกเบี้ย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Còn thiếu %@ won để đạt mục tiêu. Hãy thử tăng thời hạn, khoản nộp hoặc lãi suất."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K cíli chybí %@ wonů. Zkuste zvýšit dobu, vklad nebo úrok."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du mangler %@ won til målet. Prøv at hæve perioden, indbetalingen eller renten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λείπουν %@ γουόν για τον στόχο. Δοκιμάστε να αυξήσετε τη διάρκεια, την καταβολή ή το επιτόκιο."
