    "자산 탭에 자산을 등록하면\n앞으로의 흐름을 예측해드려요." : {
      "comment" : "Text below the image in the '자산 예측' section.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Register assets on the Assets tab\nand we'll project what's ahead."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Register assets on the Assets tab\nand we'll project what's ahead."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資産タブに資産を登録すると、\nこれからの流れを予測します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在资产页登记资产，\n就能预测接下来的走势。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在資產頁登記資產，\n就能預測接下來的走勢。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra activos en la pestaña Activos\ny proyectaremos lo que viene."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trag Vermögen im Vermögen-Tab ein,\nund wir schätzen, wie es weitergeht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez des actifs dans l’onglet Actifs\net nous projetons la suite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra le attività nella scheda Patrimonio\ne prevediamo cosa ti aspetta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadastre ativos na aba Patrimônio\ne projetamos o que vem pela frente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте активы на вкладке «Активы»,\nи мы спрогнозируем, что дальше."
          }
        },
        "th" : {
          "stringUnit" : {
