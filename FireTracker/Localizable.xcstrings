          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Theo dõi tài sản bạn đang giữ dưới dạng danh sách —\ncổ phiếu, tiền mã hóa, bất động sản, jeonse, tiền mặt, v.v."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
