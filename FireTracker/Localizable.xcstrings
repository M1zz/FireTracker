    "살 때마다 한 줄씩 남겨두면 지금 몇 %@인지, 언제 얼마에 샀는지 그대로 남아요." : {
      "comment" : "A description of how to enter trade data in the asset editor. The argument is the string “개” or the string “주”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a line each time you buy and you'll always see how many %@ you hold and when and at what price you bought."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a line each time you buy and you'll always see how many %@ you hold and when and at what price you bought."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "買うたびに1行ずつ残しておくと、今何%@持っているか、いつ・いくらで買ったかがそのまま残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次买入记一行，就能一直保留现在有多少%@，以及何时、以多少价格买的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次買入記一行，就能一直保留現在有多少%@，以及何時、以多少價格買的。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anota una línea cada vez que compres y siempre verás cuántos %@ tienes y cuándo y a qué precio compraste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte bei jedem Kauf eine Zeile fest, dann siehst du stets, wie viele %@ du hast und wann und zu welchem Preis du gekauft hast."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez une ligne à chaque achat et vous verrez toujours combien de %@ vous détenez, quand et à quel prix vous avez acheté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi una riga a ogni acquisto e vedrai sempre quanti %@ hai e quando e a che prezzo hai comprato."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anote uma linha a cada compra e você sempre verá quantos %@ tem e quando e a que preço comprou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывайте строку при каждой покупке — и всегда будет видно, сколько у вас %@, когда и по какой цене вы покупали."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จดไว้บรรทัดหนึ่งทุกครั้งที่ซื้อ แล้วจะเห็นเสมอว่าตอนนี้ถือ %@ เท่าไร และซื้อเมื่อไรด้วยราคาเท่าไร"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi một dòng mỗi lần mua, bạn sẽ luôn thấy đang giữ bao nhiêu %@, mua khi nào và giá bao nhiêu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při každém nákupu přidejte řádek a vždy uvidíte, kolik %@ držíte a kdy a za kolik jste nakoupili."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv en linje hver gang du køber, så kan du altid se, hvor mange %@ du har, og hvornår og til hvilken pris du købte."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σημειώνετε μια γραμμή σε κάθε αγορά και βλέπετε πάντα πόσα %@ έχετε και πότε και σε ποια τιμή αγοράσατε."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjaa rivi jokaisesta ostosta, niin näet aina, montako %@ omistat ja milloin ja millä hinnalla ostit."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catat satu baris setiap kali membeli, dan Anda selalu melihat berapa %@ yang dimiliki, kapan dan dengan harga berapa dibeli."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv en linje hver gang du kjøper, så ser du alltid hvor mange %@ du har, og når og til hvilken pris du kjøpte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noteer bij elke aankoop een regel en je ziet altijd hoeveel %@ je hebt en wanneer en tegen welke prijs je kocht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisuj wiersz przy każdym zakupie, a zawsze zobaczysz, ile masz %@ oraz kiedy i za ile kupiłeś."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv en rad varje gång du köper, så ser du alltid hur många %@ du har och när och till vilket pris du köpte."
          }
        }
      }
    },
