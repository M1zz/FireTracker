        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 속도로는 닿지 않아요"
          }
        }
      }
    },
    "지금 자산이 앞으로 어디까지 갈지 좋을 때와 나쁠 때의 범위로 보여줘요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See where your assets could go, as a range between good and bad markets."
