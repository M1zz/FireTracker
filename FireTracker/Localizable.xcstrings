    "예: 이직으로 연봉이 올라 저축이 늘면 +30%, 지방으로 옮겨 생활비가 줄면 −20%." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Např. +30 %, pokud nová práce zvýší spoření, −20 %, pokud stěhování sníží životní náklady."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fx +30 %, hvis et nyt job øger din opsparing, −20 %, hvis en flytning sænker leveomkostningerne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z. B. +30 %, wenn ein neuer Job deine Sparrate erhöht, −20 %, wenn ein Umzug die Lebenskosten senkt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Π.χ. +30% αν μια νέα δουλειά αυξήσει την αποταμίευσή σας, −20% αν μια μετακόμιση μειώσει το κόστος ζωής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E.g. +30% if a new job raises your savings, −20% if moving cuts living costs."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E.g. +30% if a new job raises your savings, −20% if moving cuts living costs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "P. ej., +30 % si un nuevo empleo aumenta tu ahorro, −20 % si mudarte reduce tus gastos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esim. +30 %, jos uusi työ kasvattaa säästöjäsi, −20 %, jos muutto pienentää elinkustannuksia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ex. +30 % si un nouvel emploi augmente votre épargne, −20 % si un déménagement réduit vos frais de vie."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mis. +30% jika pekerjaan baru menaikkan tabungan, −20% jika pindah rumah menurunkan biaya hidup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es. +30% se un nuovo lavoro aumenta i risparmi, −20% se un trasloco riduce le spese di vita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "例：転職で貯蓄が増えるなら+30%、引っ越しで生活費が減るなら−20%。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예: 이직으로 연봉이 올라 저축이 늘면 +30%, 지방으로 옮겨 생활비가 줄면 −20%."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "F.eks. +30 % hvis en ny jobb øker sparingen, −20 % hvis flytting senker levekostnadene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bijv. +30% als een nieuwe baan je spaargeld verhoogt, −20% als verhuizen je leefkosten verlaagt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Np. +30%, jeśli nowa praca zwiększy oszczędności, −20%, jeśli przeprowadzka obniży koszty życia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ex.: +30% se um novo emprego aumenta a poupança, −20% se uma mudança reduz o custo de vida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напр. +30 %, если новая работа увеличит сбережения, −20 %, если переезд снизит расходы на жизнь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "T.ex. +30 % om ett nytt jobb ökar ditt sparande, −20 % om en flytt sänker levnadskostnaderna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เช่น +30% ถ้างานใหม่ทำให้เงินออมเพิ่ม −20% ถ้าย้ายบ้านแล้วค่าครองชีพลด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Örn. yeni bir iş birikiminizi artırırsa +%30, taşınmak geçim giderini düşürürse −%20."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ví dụ: +30% nếu việc mới làm tiền tiết kiệm tăng, −20% nếu chuyển nhà làm sinh hoạt phí giảm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "例：换工作让储蓄增加就填+30%，搬家使生活费减少就填−20%。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "例：換工作讓儲蓄增加就填+30%，搬家使生活費減少就填−20%。"
          }
        }
      }
    },
