        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat ukuran teks diperbesar, layar tertata ulang dengan rapi alih-alih terpotong."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
