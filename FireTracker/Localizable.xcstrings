    "자산·저축·패시브 인컴을 넣으면 여기서 점검해 드려요" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadejte majetek, spoření a pasivní příjem a tady je zkontrolujeme"
