    "기록을 저장할수록 이번 달 안의 변화가 촘촘하게 그려져요." : {
      "comment" : "A description of the trend view's disclaimer.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The more records you save, the more detail you'll see in this month's changes."
