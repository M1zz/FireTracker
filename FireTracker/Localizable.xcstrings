          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La última vez no se pudo conectar con iCloud, así que la app se abrió con el almacenamiento del dispositivo. Revisa tu inicio de sesión en iCloud."
