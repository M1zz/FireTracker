        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ค่าแรงที่หาได้เท่ากับค่าแรงที่ซื้อ ความหนาแน่นสูงขึ้นก็จริง แต่เวลาแค่ย้ายที่ ไม่ได้เพิ่มขึ้น"
