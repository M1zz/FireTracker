          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguanta hasta el final incluso en el peor 10 % de 2.000 trayectorias de mercado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riittää loppuun asti vielä 2 000 markkinakehityksen huonoimmassa 10 %:ssakin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tient jusqu’au bout, même dans les 10 % les pires de 2 000 trajectoires de marché."
