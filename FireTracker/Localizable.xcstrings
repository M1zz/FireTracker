        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これまで会社が負担していた半分を自分で払うことになります。実際の生活費として数えてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
