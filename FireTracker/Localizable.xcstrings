    },
    "지역가입자": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regional subscriber"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지역가입자"
          }
        }
      }
    },
    "지역가입자 = 소득 %@원 × 7.19%% + 재산 %lld점 × 211.5원. 임의계속가입은 퇴사 후 첫 지역 고지서 납부기한에서 2개월 안에 신청해야 해요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regional = income %1$@ won × 7.19%% + property %2$lld points × 211.5 won. Apply for continued coverage within 2 months of your first regional bill's due date."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지역가입자 = 소득 %@원 × 7.19%% + 재산 %lld점 × 211.5원. 임의계속가입은 퇴사 후 첫 지역 고지서 납부기한에서 2개월 안에 신청해야 해요."
          }
        }
      }
    },
