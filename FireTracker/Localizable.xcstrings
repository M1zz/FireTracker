    "‘%@’을(를) 지울까요?" : {
      "comment" : "A confirmation dialog asking the user to confirm the deletion of a single asset. The text is a localized string that includes the name of the asset.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete ‘%@’?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete ‘%@’?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」を削除しますか？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要删除“%@”吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
