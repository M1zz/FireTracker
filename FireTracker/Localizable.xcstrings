        }
      }
    },
    "주식과 채권을 섞은 포트폴리오는 보통 실질 수익률 3~5%, 변동성 8~15% 정도로 봐요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mix akcií a dluhopisů obvykle počítá s reálným výnosem 3–5 % a volatilitou 8–15 %."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En blanding af aktier og obligationer forudsætter typisk 3–5 % reelt afkast og 8–15 % udsving."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Mischung aus Aktien und Anleihen geht meist von 3–5 % realer Rendite und 8–15 % Schwankung aus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα μείγμα μετοχών και ομολόγων συνήθως υποθέτει πραγματική απόδοση 3–5% και μεταβλητότητα 8–15%."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A stock-and-bond mix typically assumes a 3–5% real return and 8–15% volatility."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A stock-and-bond mix typically assumes a 3–5% real return and 8–15% volatility."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una mezcla de acciones y bonos suele suponer una rentabilidad real del 3–5 % y una volatilidad del 8–15 %."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osake- ja joukkovelkakirjayhdistelmässä oletetaan tyypillisesti 3–5 % reaalituotto ja 8–15 % vaihtelu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mélange actions-obligations suppose généralement un rendement réel de 3 à 5 % et une volatilité de 8 à 15 %."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Campuran saham dan obligasi biasanya mengasumsikan imbal hasil riil 3–5% dan volatilitas 8–15%."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mix di azioni e obbligazioni di solito ipotizza un rendimento reale del 3–5% e una volatilità dell’8–15%."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "株式と債券の組み合わせでは、実質リターン3〜5%、変動率8〜15%を前提にするのが一般的です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주식과 채권을 섞은 포트폴리오는 보통 실질 수익률 3~5%, 변동성 8~15% 정도로 봐요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En blanding av aksjer og obligasjoner forutsetter vanligvis 3–5 % reell avkastning og 8–15 % svingning."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een mix van aandelen en obligaties gaat meestal uit van 3–5% reëel rendement en 8–15% volatiliteit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mieszanka akcji i obligacji zwykle zakłada realny zwrot 3–5% i zmienność 8–15%."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
