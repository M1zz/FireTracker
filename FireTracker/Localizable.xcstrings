    "배당·월세·이자를 넣으면 들어오는 돈이 보여요" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add dividends, rent or interest to see money coming in"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add dividends, rent or interest to see money coming in"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配当・家賃・利息を入れると、入ってくるお金が見えます"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "填入分红、房租、利息后，就能看到进账的钱"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "填入分紅、房租、利息後，就能看到入帳的錢"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade dividendos, alquileres e intereses para ver lo que entra"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trag Dividenden, Mieten und Zinsen ein, um dein Einkommen zu sehen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez dividendes, loyers et intérêts pour voir ce qui rentre"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi dividendi, affitti e interessi per vedere le entrate"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione dividendos, aluguéis e juros para ver o que entra"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте дивиденды, аренду и проценты — и увидите, сколько поступает"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใส่เงินปันผล ค่าเช่า ดอกเบี้ย เพื่อดูเงินที่เข้ามา"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm cổ tức, tiền thuê, lãi để thấy tiền chảy vào"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte dividendy, nájem a úroky a uvidíte, kolik přichází"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj udbytte, husleje og renter, så kan du se, hvad der kommer ind"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βάλτε μερίσματα, ενοίκια και τόκους για να δείτε τι μπαίνει"
