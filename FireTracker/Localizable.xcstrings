        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada tres meses, mira cuánto se adelantó tu fecha de salida y qué la movió."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolmen kuukauden välein näet, kuinka paljon lähemmäs lopetuspäiväsi tuli ja mikä sitä liikutti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les trois mois, voyez de combien votre départ s’est rapproché et ce qui a bougé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiap tiga bulan, lihat seberapa dekat tanggal berhenti Anda dan apa yang menggesernya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni tre mesi vedi di quanto si è avvicinata la tua uscita e cosa l’ha mossa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3か月ごとに、退職日がどれだけ早まったか、何が動いたかをまとめてお知らせします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "석 달마다 퇴사 날짜가 얼마나 당겨졌는지, 무엇이 움직였는지 정리해 알려줘요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver tredje måned kan du se hvor mye nærmere sluttdatoen din kom og hva som flyttet den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke drie maanden zie je hoeveel dichterbij je stopdatum kwam en wat het liet bewegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co trzy miesiące zobaczysz, o ile przybliżyła się data odejścia i co ją ruszyło."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cada três meses, veja quanto sua saída se aproximou e o que mexeu nela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Раз в три месяца смотрите, насколько приблизился уход и что на него повлияло."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Var tredje månad ser du hur mycket närmare ditt slutdatum kom och vad som rörde det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทุกสามเดือน สรุปว่าวันออกจากงานใกล้เข้ามาเท่าไรและอะไรทำให้ขยับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her üç ayda bırakma tarihinizin ne kadar yaklaştığını ve neyin kıpırdattığını görün."
