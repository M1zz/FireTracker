    "산 시간이 없어요. 24시간을 어떻게 쓰든 하루의 두께는 그대로 1이에요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádný koupený čas. Ať 24 hodin využijete jakkoli, tloušťka dne zůstává 1."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen købt tid. Uanset hvordan du bruger dine 24 timer, er dagens tykkelse stadig 1."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine gekaufte Zeit. Wie du deine 24 Stunden auch nutzt, die Dicke des Tages bleibt 1."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν αγοράσατε χρόνο. Όπως κι αν περάσετε τις 24 ώρες, το πάχος της ημέρας μένει 1."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No time bought. However you spend 24 hours, the day's thickness stays at 1."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No time bought. However you spend 24 hours, the day's thickness stays at 1."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No has comprado tiempo. Uses como uses tus 24 horas, el grosor del día sigue siendo 1."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei ostettua aikaa. Käytitpä 24 tuntia miten tahansa, päivän paksuus on edelleen 1."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun temps acheté. Quoi que vous fassiez de vos 24 heures, l’épaisseur de la journée reste 1."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada waktu yang dibeli. Bagaimanapun Anda memakai 24 jam, ketebalan hari tetap 1."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun tempo comprato. Comunque usi le 24 ore, lo spessore della giornata resta 1."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "買った時間はありません。24時間をどう使っても、1日の厚みは1のままです。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen kjøpt tid. Uansett hvordan du bruker de 24 timene, er dagens tykkelse fortsatt 1."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen tijd gekocht. Hoe je je 24 uur ook besteedt, de dikte van je dag blijft 1."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie kupiono czasu. Jakkolwiek wykorzystasz 24 godziny, grubość dnia wciąż wynosi 1."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum tempo comprado. Use as 24 horas como quiser: a espessura do dia continua 1."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Купленного времени нет. Как ни распределяй 24 часа, толщина дня остаётся 1."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen köpt tid. Hur du än använder dina 24 timmar är dagens tjocklek fortfarande 1."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีเวลาที่ซื้อ ไม่ว่าจะใช้ 24 ชั่วโมงอย่างไร ความหนาของวันก็ยังเท่ากับ 1"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alınan zaman yok. 24 saati nasıl kullanırsanız kullanın günün kalınlığı yine 1."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có thời gian mua. Dù dùng 24 giờ thế nào, độ dày của ngày vẫn là 1."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
