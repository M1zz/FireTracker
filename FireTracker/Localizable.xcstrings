            "value": "Average savings rate"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평균 저축률"
          }
        }
      }
    },
    "평생 내는 세금": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lifetime tax"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평생 내는 세금"
          }
        }
      }
    },
    "프로": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로"
          }
        }
      }
    },
    "피부양자 기준(연소득 2,000만원, 재산 과표 5.4억원)을 넘어 피부양자는 어려워요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over the dependent limits (20M won income, 540M won property tax base), so dependent status is unlikely."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피부양자 기준(연소득 2,000만원, 재산 과표 5.4억원)을 넘어 피부양자는 어려워요."
          }
        }
      }
    },
    "필요할 때 연금부터 한꺼번에 꺼내는 것보다 세금이 %@원 줄어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves %@ won in tax versus drawing your pension all at once."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요할 때 연금부터 한꺼번에 꺼내는 것보다 세금이 %@원 줄어요."
          }
        }
      }
    },
    "하루 %@원 × %lld일 = %@원": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ won a day × %2$lld days = %3$@ won"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 %@원 × %lld일 = %@원"
          }
        }
      }
    },
    "하루 %@원 × %lld일. 비자발적 퇴사일 때만 받을 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ won a day × %2$lld days. Only for involuntary exits."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 %@원 × %lld일. 비자발적 퇴사일 때만 받을 수 있어요."
          }
        }
      }
    },
    "한 달 %@원 (%@년 보험료율 기준)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ won a month (%2$@ rate)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 달 %@원 (%@년 보험료율 기준)"
          }
        }
      }
    },
    "한 달에 얼마면 살 수 있는지 넣으면 퇴사 시점을 계산해 드려요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell us what you need to live on each month and we'll work out when you can quit"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 달에 얼마면 살 수 있는지 넣으면 퇴사 시점을 계산해 드려요"
          }
        }
      }
    },
    "한 번 결제로 평생 쓰는 상품이에요. 자산 기록과 퇴사 계산의 핵심 기능은 계속 무료예요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A one-time purchase you keep forever. Asset tracking and the core quit-date features stay free."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 결제로 평생 쓰는 상품이에요. 자산 기록과 퇴사 계산의 핵심 기능은 계속 무료예요."
          }
        }
      }
    },
    "한 해 출렁임(변동성)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yearly volatility"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 해 출렁임(변동성)"
          }
        }
      }
    },
    "해마다 어디서 꺼내나 (절세 순서)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where each year's money comes from (tax-smart)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해마다 어디서 꺼내나 (절세 순서)"
          }
        }
      }
    },
    "해제": {
      "localizations": {
