    "지금 모으는 속도로는 80년 안에 목표에 닿지 않아요. 매달 모으는 돈을 늘리거나 생활비 목표를 줄여 보세요." : {
      "comment" : "A description of the user's savings and retirement timeline.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při současném tempu spoření cíle do 80 let nedosáhnete. Zkuste měsíčně spořit víc nebo snížit cíl životních nákladů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med din nuværende opsparingstakt når du ikke målet på 80 år. Prøv at spare mere op hver måned eller sænk målet for leveomkostninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei deinem jetzigen Spartempo erreichst du das Ziel in 80 Jahren nicht. Spare mehr pro Monat oder senke dein Lebenskostenziel."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με τον τρέχοντα ρυθμό αποταμίευσης δεν θα φτάσετε στον στόχο σε 80 χρόνια. Δοκιμάστε να αποταμιεύετε περισσότερο κάθε μήνα ή να μειώσετε τον στόχο κόστους ζωής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At your current saving pace, you won't reach the goal within 80 years. Try saving more each month or lowering your living-cost target."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At your current saving pace, you won't reach the goal within 80 years. Try saving more each month or lowering your living-cost target."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al ritmo de ahorro actual no llegarás al objetivo en 80 años. Prueba a ahorrar más cada mes o a bajar tu objetivo de gastos de vida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nykyisellä säästövauhdilla et saavuta tavoitetta 80 vuodessa. Kokeile säästää enemmän kuukaudessa tai pienentää elinkustannustavoitetta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au rythme d’épargne actuel, vous n’atteindrez pas l’objectif en 80 ans. Essayez d’épargner plus chaque mois ou de réduire votre objectif de frais de vie."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan laju menabung sekarang, Anda tidak mencapai target dalam 80 tahun. Coba menabung lebih banyak tiap bulan atau turunkan target biaya hidup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al ritmo di risparmio attuale non raggiungerai l’obiettivo in 80 anni. Prova a risparmiare di più ogni mese o ad abbassare l’obiettivo di spese di vita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今のペースで貯めても、80年以内に目標に届きません。毎月貯めるお金を増やすか、生活費の目標を下げてみてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med dagens sparetempo når du ikke målet på 80 år. Prøv å spare mer hver måned eller senk målet for levekostnader."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met je huidige spaartempo bereik je het doel niet binnen 80 jaar. Probeer per maand meer te sparen of je leefkostendoel te verlagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W obecnym tempie oszczędzania nie osiągniesz celu w 80 lat. Spróbuj odkładać więcej co miesiąc lub obniżyć cel kosztów życia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No ritmo de poupança atual, você não chega à meta em 80 anos. Tente poupar mais por mês ou reduzir a meta de custo de vida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При текущем темпе накоплений цель не будет достигнута за 80 лет. Попробуйте откладывать больше в месяц или снизить цель по расходам на жизнь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med nuvarande sparandetakt når du inte målet på 80 år. Prova att spara mer varje månad eller sänk målet för levnadskostnader."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ด้วยจังหวะการออมตอนนี้ คุณจะไม่ถึงเป้าหมายภายใน 80 ปี ลองออมเพิ่มทุกเดือนหรือลดเป้าค่าครองชีพ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şu anki birikim hızıyla hedefe 80 yılda ulaşamazsınız. Her ay daha çok biriktirmeyi veya geçim gideri hedefini düşürmeyi deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Với tốc độ tiết kiệm hiện tại, bạn sẽ không đạt mục tiêu trong 80 năm. Hãy thử tiết kiệm thêm mỗi tháng hoặc giảm mục tiêu sinh hoạt phí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按现在的储蓄速度，80年内也达不到目标。请增加每月攒的钱，或降低生活费目标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按現在的儲蓄速度，80年內也達不到目標。請增加每月攢的錢，或降低生活費目標。"
          }
        }
      }
    },
    "지금 모으는 속도로는 80년 안에 목표에 닿지 않아요. 월 저축을 늘리거나 생활비 목표를 줄여 보세요." : {
      "comment" : "A description of the user's current savings and how to improve it.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
