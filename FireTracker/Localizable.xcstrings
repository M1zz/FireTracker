        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syötä koodi ja ota automaattinen hinta käyttöön, niin hälytämme sääntösi mukaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez le code et activez le cours automatique, et nous vous alertons selon votre règle."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
