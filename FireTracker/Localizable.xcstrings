    "현금화해서 바로 쓸 수 있는 자산입니다. ‘쓸 수 있는 돈’에 포함됩니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assets you can turn into cash and spend right away. They count in ‘spendable money’."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assets you can turn into cash and spend right away. They count in ‘spendable money’."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現金化してすぐ使える資産です。「使えるお金」に含まれます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以变现后直接使用的资产，计入“可用资金”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以變現後直接使用的資產，計入「可用資金」。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activos que puedes convertir en efectivo y gastar enseguida. Cuentan en el «dinero disponible»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vermögen, das du zu Geld machen und sofort ausgeben kannst. Es zählt zum „verfügbaren Geld“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actifs convertibles en liquidités et dépensables tout de suite. Ils comptent dans l’« argent disponible »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attività che puoi convertire in contanti e spendere subito. Rientrano nel «denaro spendibile»."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativos que você pode converter em dinheiro e gastar na hora. Entram no “dinheiro disponível”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Активы, которые можно обратить в наличные и сразу потратить. Входят в «тратимые деньги»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สินทรัพย์ที่เปลี่ยนเป็นเงินสดแล้วใช้ได้ทันที นับรวมใน “เงินที่ใช้ได้”"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tài sản có thể đổi thành tiền mặt và chi ngay. Tính vào “tiền dùng được”."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Majetek, který můžete proměnit v hotovost a hned utratit. Počítá se do „utratitelných peněz“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiver, du kan omsætte til kontanter og bruge med det samme. De tæller med i „brugbare penge“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Περιουσιακά στοιχεία που μπορείτε να μετατρέψετε σε μετρητά και να ξοδέψετε αμέσως. Μετρούν στα «χρήματα προς χρήση»."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varat, jotka voit muuttaa käteiseksi ja käyttää heti. Ne lasketaan ”käytettävään rahaan”."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aset yang bisa diuangkan dan langsung dibelanjakan. Dihitung dalam “uang yang bisa dipakai”."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eiendeler du kan gjøre om til kontanter og bruke med en gang. De teller med i «brukbare penger»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezittingen die je kunt verzilveren en meteen kunt uitgeven. Ze tellen mee in ‘besteedbaar geld’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktywa, które możesz zamienić na gotówkę i od razu wydać. Wliczają się do „pieniędzy do wydania”."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillgångar du kan göra om till kontanter och spendera direkt. De räknas med i ”användbara pengar”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakde çevirip hemen harcayabileceğiniz varlıklar. “Harcanabilir para”ya dahildir."
          }
        }
      }
    },
