    "자산은 자동으로 기록돼요. 한 주가 지나면 지난주 대비 변화가 여기 표시됩니다." : {
      "comment" : "A description of how the user's net worth changes.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Majetek se zaznamenává automaticky. Po týdnu se zde zobrazí změna oproti minulému týdnu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiver registreres automatisk. Efter en uge vises ændringen siden sidste uge her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vermögen wird automatisch erfasst. Nach einer Woche erscheint hier die Veränderung zur Vorwoche."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα περιουσιακά στοιχεία καταγράφονται αυτόματα. Μετά από μία εβδομάδα, εδώ εμφανίζεται η αλλαγή σε σχέση με την προηγούμενη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assets are recorded automatically. After a week passes, the change from last week shows here."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assets are recorded automatically. After a week passes, the change from last week shows here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los activos se registran automáticamente. Pasada una semana, aquí aparece el cambio respecto a la semana anterior."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varat kirjataan automaattisesti. Viikon kuluttua tähän ilmestyy muutos viime viikkoon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
