    "옅은 점은 그 시점에 저장된 기록이에요. 점 근처를 탭하면 날짜와 값이 보여요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faint dots are records saved at that time. Tap near a dot to see its date and value."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faint dots are records saved at that time. Tap near a dot to see its date and value."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "薄い点は、その時点で保存された記録です。点の近くをタップすると日付と値が見られます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浅色的点是当时保存的记录。点按点附近可看到日期和数值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "淺色的點是當時儲存的記錄。點一下點附近可看到日期和數值。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los puntos tenues son registros guardados en ese momento. Toca cerca de un punto para ver su fecha y valor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blasse Punkte sind zu dem Zeitpunkt gespeicherte Einträge. Tippe in die Nähe eines Punkts, um Datum und Wert zu sehen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
