    "자산 탭에서 주식의 배당률, 부동산의 월세, 예금의 이자율을 넣으면 여기에 월·주 수입이 표시됩니다." : {
      "comment" : "A description of how the user can see their monthly and weekly income on the \"Dashboard\" screen.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na kartě Majetek zadejte dividendový výnos akcie, nájem nemovitosti nebo úrok vkladu a zde se zobrazí měsíční a týdenní příjem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På fanen Aktiver indtaster du en akties udbytteprocent, en ejendoms husleje eller et indskuds rente, så vises månedlig og ugentlig indkomst her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trag im Vermögen-Tab die Dividendenrendite einer Aktie, die Miete einer Immobilie oder den Zins eines Guthabens ein, dann erscheinen hier Monats- und Wocheneinnahmen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στην καρτέλα Περιουσιακά στοιχεία, βάλτε τη μερισματική απόδοση μιας μετοχής, το ενοίκιο ενός ακινήτου ή το επιτόκιο μιας κατάθεσης και εδώ εμφανίζεται το μηνιαίο και εβδομαδιαίο εισόδημα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the Assets tab, enter a stock's dividend yield, a property's rent or a deposit's interest rate and monthly and weekly income appear here."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the Assets tab, enter a stock's dividend yield, a property's rent or a deposit's interest rate and monthly and weekly income appear here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la pestaña Activos, introduce el dividendo de una acción, el alquiler de un inmueble o el interés de un depósito y aquí aparecerán los ingresos mensuales y semanales."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syötä Varat-välilehdellä osakkeen osinkotuotto, kiinteistön vuokra tai talletuksen korko, niin kuukausi- ja viikkotulo näkyy tässä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans l’onglet Actifs, saisissez le rendement d’une action, le loyer d’un bien ou le taux d’un dépôt et les revenus mensuels et hebdomadaires s’affichent ici."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di tab Aset, masukkan imbal hasil dividen saham, sewa properti, atau suku bunga deposito, lalu pendapatan bulanan dan mingguan tampil di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nella scheda Patrimonio inserisci il rendimento da dividendo di un’azione, l’affitto di un immobile o il tasso di un deposito e qui compaiono i redditi mensili e settimanali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資産タブで株式の配当率、不動産の家賃、預金の利率を入れると、ここに月・週の収入が表示されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På Eiendeler-fanen skriver du inn en akties utbytteprosent, en eiendoms leie eller et innskudds rente, så vises månedlig og ukentlig inntekt her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer op het tabblad Bezittingen het dividendrendement van een aandeel, de huur van een pand of de rente van een deposito in, dan verschijnen hier maand- en weekinkomsten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na karcie Aktywa wpisz stopę dywidendy akcji, czynsz nieruchomości lub oprocentowanie lokaty, a tu pojawi się dochód miesięczny i tygodniowy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na aba Patrimônio, informe a taxa de dividendos de uma ação, o aluguel de um imóvel ou a taxa de juros de um depósito e a renda mensal e semanal aparece aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На вкладке «Активы» укажите дивидендную доходность акции, аренду недвижимости или ставку вклада — и здесь появится месячный и недельный доход."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På fliken Tillgångar anger du en akties direktavkastning, en fastighets hyra eller en insättnings ränta, så visas månads- och veckoinkomst här."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ในแท็บสินทรัพย์ กรอกอัตราปันผลของหุ้น ค่าเช่าอสังหาริมทรัพย์ หรืออัตราดอกเบี้ยเงินฝาก แล้วรายได้รายเดือนและรายสัปดาห์จะแสดงที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varlıklar sekmesinde bir hissenin temettü oranını, bir gayrimenkulün kirasını veya mevduat faizini girin; aylık ve haftalık gelir burada görünür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ở tab Tài sản, nhập tỷ suất cổ tức của cổ phiếu, tiền thuê của bất động sản hoặc lãi suất tiền gửi, thu nhập theo tháng và tuần sẽ hiện ở đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在资产页填入股票的股息率、房产的租金或存款的利率，这里就会显示月收入和周收入。"
          }
