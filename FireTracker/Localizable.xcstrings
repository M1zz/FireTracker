    },
    "유동성·소득·시세 자동 등은 종류에 맞게 자동 설정돼요. 바꾸고 싶을 때만 펼치면 됩니다. 저장 후 자산을 눌러도 수정할 수 있어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquidity, income and auto price are set automatically for each type. Expand only if you want to change them. You can also edit by tapping the asset after saving."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquidity, income and auto price are set automatically for each type. Expand only if you want to change them. You can also edit by tapping the asset after saving."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "流動性・収入・自動価格などは種類に合わせて自動設定されます。変えたいときだけ開いてください。保存後に資産をタップしても修正できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "流动性、收入、自动行情等会按类型自动设置。只在想修改时展开即可。保存后点按资产也能修改。"
          }
        },
        "zh-Hant" : {
