        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν αποχωρήσετε στα %lld και ξοδεύετε %@ γουόν τον μήνα, στα %lld σας μένουν %@ γουόν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retire at %1$lld and spend %2$@ won a month, and you'll still have %4$@ won at %3$lld."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retire at %1$lld and spend %2$@ won a month, and you'll still have %4$@ won at %3$lld."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aunque gastes %2$@ wones al mes tras jubilarte (a los %1$lld), a los %3$lld te quedarán %4$@ wones."
