    "옅은 점은 그 시점에 저장된 기록이에요. 점 근처를 탭하면 날짜와 값이 보여요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Světlé body jsou záznamy uložené v daném okamžiku. Klepněte poblíž bodu a uvidíte datum a hodnotu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svage prikker er registreringer gemt på det tidspunkt. Tryk nær en prik for at se dato og værdi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blasse Punkte sind zu dem Zeitpunkt gespeicherte Einträge. Tippe in die Nähe eines Punkts, um Datum und Wert zu sehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι αχνές κουκκίδες είναι καταγραφές που αποθηκεύτηκαν εκείνη τη στιγμή. Πατήστε κοντά σε μια κουκκίδα για να δείτε ημερομηνία και τιμή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faint dots are records saved at that time. Tap near a dot to see its date and value."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faint dots are records saved at that time. Tap near a dot to see its date and value."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los puntos tenues son registros guardados en ese momento. Toca cerca de un punto para ver su fecha y valor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haaleat pisteet ovat kyseisellä hetkellä tallennettuja merkintöjä. Napauta pisteen läheltä nähdäksesi päivämäärän ja arvon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les points pâles sont des enregistrements faits à ce moment-là. Touchez près d’un point pour voir sa date et sa valeur."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titik pudar adalah catatan yang disimpan pada saat itu. Ketuk dekat titik untuk melihat tanggal dan nilainya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I punti tenui sono registrazioni salvate in quel momento. Tocca vicino a un punto per vedere data e valore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "薄い点は、その時点で保存された記録です。点の近くをタップすると日付と値が見られます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svake prikker er registreringer lagret på det tidspunktet. Trykk nær en prikk for å se dato og verdi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vage stippen zijn registraties die op dat moment zijn bewaard. Tik in de buurt van een stip om datum en waarde te zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blade punkty to zapisy zapisane w danym momencie. Stuknij obok punktu, aby zobaczyć datę i wartość."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pontos claros são registros salvos naquele momento. Toque perto de um ponto para ver data e valor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бледные точки — записи, сохранённые в тот момент. Нажмите рядом с точкой, чтобы увидеть дату и значение."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
