        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn đã mua thời gian đắt hơn lương giờ của mình. Mật độ có vẻ tăng nhưng thực ra bạn mất %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "买了比自己时薪还贵的时间。密度看似提高，实际却损失了%@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
