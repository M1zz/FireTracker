    "주 투입시간엔 근무만이 아니라 출퇴근·준비·업무 생각까지 넣어야 정직한 시급이 나와요." : {
      "comment" : "A description of the time-based wage calculation.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For an honest hourly wage, weekly hours should include not just work but commuting, getting ready and thinking about work."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For an honest hourly wage, weekly hours should include not just work but commuting, getting ready and thinking about work."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正直な時給を出すには、週の投入時間に勤務だけでなく通勤・準備・仕事のことを考える時間まで含める必要があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要算出真实的时薪，每周投入时间不能只算上班，还要包括通勤、准备以及想着工作的时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要算出真實的時薪，每週投入時間不能只算上班，還要包括通勤、準備以及想著工作的時間。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para un sueldo por hora honesto, las horas semanales deben incluir no solo el trabajo, sino el trayecto, la preparación y el tiempo pensando en el trabajo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für einen ehrlichen Stundenlohn gehören zur Wochenzeit nicht nur die Arbeit, sondern auch Pendeln, Vorbereitung und Gedanken an die Arbeit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour un salaire horaire honnête, les heures hebdomadaires doivent inclure non seulement le travail, mais aussi le trajet, la préparation et le temps passé à penser au travail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per una paga oraria onesta, le ore settimanali devono includere non solo il lavoro ma anche tragitto, preparazione e pensieri sul lavoro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para um valor-hora honesto, as horas semanais devem incluir não só o trabalho, mas o deslocamento, a preparação e o tempo pensando no trabalho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для честной почасовой ставки в недельные часы нужно включать не только работу, но и дорогу, сборы и мысли о работе."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ค่าแรงต่อชั่วโมงที่ตรงไปตรงมาต้องรวมเวลาต่อสัปดาห์ไม่ใช่แค่ทำงาน แต่รวมเดินทาง เตรียมตัว และคิดเรื่องงานด้วย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muốn có lương giờ trung thực, số giờ mỗi tuần phải gồm không chỉ giờ làm việc mà cả đi lại, chuẩn bị và thời gian nghĩ về công việc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro poctivou hodinovou sazbu musí týdenní čas zahrnovat nejen práci, ale i dojíždění, přípravu a přemýšlení o práci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For en ærlig timeløn skal ugentlig tid ikke kun omfatte arbejdet, men også pendling, forberedelse og at tænke på arbejdet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για ειλικρινές ωρομίσθιο, οι εβδομαδιαίες ώρες πρέπει να περιλαμβάνουν όχι μόνο τη δουλειά αλλά και τη μετακίνηση, την προετοιμασία και τη σκέψη για τη δουλειά."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rehellistä tuntipalkkaa varten viikkotuntien tulee sisältää työn lisäksi työmatka, valmistautuminen ja työasioiden miettiminen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk upah per jam yang jujur, jam mingguan harus mencakup bukan hanya kerja, tetapi juga perjalanan, persiapan, dan memikirkan pekerjaan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For en ærlig timelønn må ukentlig tid ikke bare omfatte arbeidet, men også pendling, forberedelser og tanker om jobben."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor een eerlijk uurloon moeten de uren per week niet alleen werk omvatten, maar ook woon-werkverkeer, voorbereiding en piekeren over werk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dla uczciwej stawki godzinowej godziny tygodniowe muszą obejmować nie tylko pracę, ale też dojazd, przygotowanie i myślenie o pracy."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För en ärlig timlön måste veckotiden inkludera inte bara arbetet utan även pendling, förberedelser och tankar på jobbet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dürüst bir saatlik ücret için haftalık saatlere yalnızca iş değil, işe gidiş gelişi, hazırlığı ve işi düşünmeyi de katmalısınız."
          }
        }
      }
    },
