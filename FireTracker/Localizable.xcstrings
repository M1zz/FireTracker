          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skyggen er området åtte av ti utfall havner i. Det blir bredere jo lengre perioden er."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De arcering is het bereik waarin acht van de tien uitkomsten vallen. Hoe langer de periode, hoe breder."
