    "평가액이 가려져 손익·수익률로 계산했어요. 확인해 주세요." : {
      "comment" : "A tooltip that appears when the user hides the amount in a holding.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tržní hodnota byla skrytá, proto jsme počítali ze zisku/ztráty a výnosu. Zkontrolujte to."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markedsværdien var skjult, så vi har regnet ud fra gevinst/tab og afkast. Tjek venligst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
