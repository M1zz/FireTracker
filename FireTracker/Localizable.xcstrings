        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Synchronisierung beginnt, nachdem du die App ganz beendet und neu geöffnet hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο συγχρονισμός ξεκινά αφού κλείσετε εντελώς και ανοίξετε ξανά την εφαρμογή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync starts after you fully close and reopen the app."
