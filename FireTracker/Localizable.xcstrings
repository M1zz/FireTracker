    },
    "지금 월급 %@은 %@년 월급을 오늘 물가로 옮긴 %@보다 %@ 적어요. 그만큼 구매력이 깎인 셈이에요." : {
      "comment" : "A sentence that compares the real purchasing power of a current salary to that of the same salary in the past.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "지금 월급 %1$@은 %2$@년 월급을 오늘 물가로 옮긴 %3$@보다 %4$@ 적어요. 그만큼 구매력이 깎인 셈이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your salary now, %1$@, is %4$@ less than your %2$@ salary in today's prices (%3$@). That's how much purchasing power was lost."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your salary now, %1$@, is %4$@ less than your %2$@ salary in today's prices (%3$@). That's how much purchasing power was lost."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の月給%1$@は、%2$@年の月給を今の物価に換算した%3$@より%4$@少ないです。それだけ購買力が削られたことになります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在的月薪%1$@，比把%2$@年的月薪折算成今天物价后的%3$@少%4$@。相当于购买力被削减了这么多。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在的月薪%1$@，比把%2$@年的月薪折算成今天物價後的%3$@少%4$@。相當於購買力被削減了這麼多。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu sueldo actual, %1$@, es un %4$@ inferior al de %2$@ a precios de hoy (%3$@). Es el poder adquisitivo que has perdido."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein jetziges Gehalt %1$@ liegt %4$@ unter dem Gehalt von %2$@ in heutigen Preisen (%3$@). So viel Kaufkraft ist dir verloren gegangen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre salaire actuel, %1$@, est inférieur de %4$@ à celui de %2$@ aux prix d’aujourd’hui (%3$@). C’est le pouvoir d’achat perdu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo stipendio attuale %1$@ è inferiore del %4$@ a quello del %2$@ ai prezzi di oggi (%3$@). È il potere d’acquisto perso."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu salário atual, %1$@, é %4$@ menor que o de %2$@ a preços de hoje (%3$@). É o poder de compra que se perdeu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша нынешняя зарплата %1$@ на %4$@ меньше зарплаты %2$@ г. в сегодняшних ценах (%3$@). Столько покупательной способности потеряно."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เงินเดือนตอนนี้ %1$@ น้อยกว่าเงินเดือนปี %2$@ ที่แปลงเป็นราคาวันนี้ (%3$@) อยู่ %4$@ เท่ากับอำนาจซื้อลดลงเท่านั้น"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lương hiện tại %1$@ ít hơn %4$@ so với lương năm %2$@ quy đổi theo giá hôm nay (%3$@). Đó là phần sức mua đã mất."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše současná mzda %1$@ je o %4$@ nižší než mzda z roku %2$@ přepočtená na dnešní ceny (%3$@). O tolik klesla kupní síla."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din nuværende løn %1$@ er %4$@ lavere end lønnen fra %2$@ i dagens priser (%3$@). Så meget købekraft er gået tabt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο τρέχων μισθός σας %1$@ είναι κατά %4$@ χαμηλότερος από τον μισθό του %2$@ σε σημερινές τιμές (%3$@). Τόση αγοραστική δύναμη χάθηκε."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nykyinen palkkasi %1$@ on %4$@ pienempi kuin vuoden %2$@ palkka tämän päivän hinnoin (%3$@). Sen verran ostovoimaa on menetetty."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaji Anda sekarang, %1$@, %4$@ lebih rendah dari gaji %2$@ dalam harga hari ini (%3$@). Sebesar itulah daya beli yang hilang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagens lønn %1$@ er %4$@ lavere enn lønnen fra %2$@ i dagens priser (%3$@). Så mye kjøpekraft er tapt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je huidige salaris %1$@ is %4$@ lager dan het salaris van %2$@ tegen de prijzen van nu (%3$@). Zoveel koopkracht is verloren gegaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja obecna pensja %1$@ jest o %4$@ niższa niż pensja z %2$@ w dzisiejszych cenach (%3$@). Tyle siły nabywczej utracono."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din nuvarande lön %1$@ är %4$@ lägre än lönen från %2$@ i dagens priser (%3$@). Så mycket köpkraft har gått förlorad."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şu anki maaşınız %1$@, %2$@ maaşının bugünün fiyatlarıyla karşılığı olan %3$@’den %4$@ az. Bu kadar satın alma gücü kaybedildi."
          }
        }
      }
    },
    "지금 월급도 넣으면 최근 물가(%@년)까지 이어서 볼 수 있어요." : {
      "comment" : "A message that appears when the user hasn't entered their current salary.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add your current salary too to see up to recent prices (%@)."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add your current salary too to see up to recent prices (%@)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の月給も入れると、最近の物価（%@年）まで続けて見られます。"
