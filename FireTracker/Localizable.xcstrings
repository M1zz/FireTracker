    "남은 대출 잔액 %@원과 연 이자율 %@%%가 자산 탭에 ‘부채’로 등록됩니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbývající zůstatek úvěru %@ wonů a roční sazba %@%% se zapíšou na kartu Majetek jako „Dluh“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restgælden på %@ won og den årlige rente på %@ %% registreres som „Gæld“ under Aktiver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Restschuld von %@ Won und der Zinssatz von %@ %% p. a. werden im Vermögen-Tab als „Schulden“ erfasst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το υπόλοιπο δανείου %@ γουόν με ετήσιο επιτόκιο %@%% θα καταχωριστεί ως «Χρέος» στην καρτέλα Περιουσία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The remaining balance of %@ won and %@%% yearly interest will be added to the Assets tab as ‘Debt’."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The remaining balance of %@ won and %@%% yearly interest will be added to the Assets tab as ‘Debt’."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El saldo pendiente de %@ wones y el interés anual del %@%% se registrarán como «Deuda» en Activos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lainan jäljellä oleva saldo %@ wonia ja vuosikorko %@ %% kirjataan Varat-välilehdelle velaksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le capital restant dû de %@ wons et le taux annuel de %@ %% seront enregistrés en « Dette » dans l’onglet Actifs."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisa pinjaman %@ won dengan bunga %@%% per tahun akan didaftarkan sebagai ‘utang’ di tab Aset."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il saldo residuo di %@ won e il tasso annuo del %@%% verranno registrati come «Debito» nella scheda Patrimonio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "残りのローン残高%@ウォンと年利%@%%が、資産タブに「負債」として登録されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
