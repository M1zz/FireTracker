          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回はiCloudに接続できず、デバイス内の保存領域でアプリを開きました。iCloudのサインインを確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上次未能连接iCloud，App用设备内存储打开。请检查iCloud登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上次未能連線iCloud，App用裝置記憶體儲開啟。請檢查iCloud登入。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La última vez no se pudo conectar con iCloud, así que la app se abrió con el almacenamiento del dispositivo. Revisa tu inicio de sesión en iCloud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letztes Mal konnte keine Verbindung zu iCloud hergestellt werden, daher wurde die App mit lokalem Speicher geöffnet. Prüfe deine iCloud-Anmeldung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
