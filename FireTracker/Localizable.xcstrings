    "주식·코인·부동산·전세·현금 — 시세는 자동으로" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akcie, krypto, nemovitosti, jeonse, hotovost — ceny se doplní samy"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktier, krypto, ejendomme, jeonse, kontanter – kurserne hentes automatisk"
