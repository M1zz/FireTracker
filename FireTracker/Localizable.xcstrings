          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資産が稼ぐ時給が自分の限界時給を超えました。時間を売らなくてもよい領域です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
