    "구매력 탭 기록이 %@ %@ 통화라 원화 계산과 섞이지 않게 가져오지 않았어요. 여기 직접 적어 주세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Buying Power records use %@ %@ currency, so we didn't bring them in to keep them separate from won. Enter it here instead."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Buying Power records use %@ %@ currency, so we didn't bring them in to keep them separate from won. Enter it here instead."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購買力タブの記録は%@ %@の通貨なので、ウォンでの計算と混ざらないよう取り込んでいません。ここに直接入力してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "购买力页的记录是%@ %@的货币，为避免和韩元计算混在一起没有导入。请在这里直接填写。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購買力頁的記錄是%@ %@的貨幣，為了不和韓元計算混在一起而沒有匯入。請在這裡直接填寫。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El historial de Poder adquisitivo está en la moneda de %@ %@, así que no lo importamos para no mezclarlo con cálculos en wones. Introdúcelo aquí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einträge im Kaufkraft-Tab sind in der Währung von %@ %@, deshalb haben wir sie nicht in die Won-Rechnung übernommen. Trag den Betrag bitte hier ein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’historique de l’onglet Pouvoir d’achat est en devise %@ %@ : il n’a pas été importé pour ne pas le mélanger aux calculs en wons. Saisissez le montant ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli stipendi nella scheda Potere d’acquisto sono nella valuta di %@ %@, quindi non li ho importati per non mescolarli con i calcoli in won. Inseriscili qui."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O registro da aba Poder de compra está na moeda de %@ %@, então não foi trazido para não misturar com wons. Digite aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записи на вкладке покупательной способности в валюте страны %@ %@, поэтому мы не стали их переносить, чтобы не смешивать с расчётами в вонах. Введите сумму здесь вручную."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกในแท็บอำนาจซื้อเป็นสกุลเงิน %@ %@ จึงไม่ได้นำมาใช้เพื่อไม่ให้ปนกับการคำนวณเป็นวอน กรุณากรอกที่นี่เอง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản ghi ở tab Sức mua dùng tiền tệ của %@ %@, nên chưa lấy về để không lẫn với phép tính bằng won. Hãy nhập trực tiếp ở đây."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Záznamy na kartě kupní síly jsou v měně země %@ %@, proto jsme je nepřevzali, aby se nemíchaly s výpočty ve wonech. Zadejte částku sem ručně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lønningerne under fanen Købekraft er i %@ %@ valuta og blev ikke hentet, så de ikke blandes med won. Angiv beløbet her."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η καρτέλα Αγοραστική δύναμη είναι σε νόμισμα %@ %@, οπότε δεν μεταφέρθηκε για να μην ανακατευτεί με υπολογισμούς σε γουόν. Γράψτε το εδώ."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostovoima-välilehden merkinnät ovat valuutassa %@ %@, joten niitä ei tuotu, jotta ne eivät sekoitu wonilaskelmaan. Syötä summa tähän itse."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catatan di tab Daya beli memakai mata uang %@ %@, jadi tidak diambil agar tidak tercampur dengan perhitungan won. Silakan isi langsung di sini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lønningene under fanen Kjøpekraft er i %@ %@ valuta og ble ikke hentet, så de ikke blandes med won. Legg inn beløpet her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gegevens op het tabblad Koopkracht staan in de valuta van %@ %@. Om ze niet met won te mengen, halen we ze niet op. Vul het hier zelf in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historia na karcie siły nabywczej jest w walucie kraju %@ %@, więc jej nie przenieśliśmy, by nie mieszać z obliczeniami w wonach. Wpisz kwotę tutaj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lönerna på fliken Köpkraft är i %@ %@ valuta och hämtades inte, så att de inte blandas med won. Ange beloppet här."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satın alma gücü sekmesindeki kayıt %@ %@ para biriminde; won hesaplarıyla karışmasın diye alınmadı. Lütfen buraya elle girin."
          }
        }
      }
    },
    "구매력 탭에 월급을 적어 두면 여기서 자동으로 가져와요." : {
