        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasarruf edilen faiz"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lãi tiết kiệm được"
          }
        },
        "zh-Hans" : {
