        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask Siri how long until you can quit, and get the answer instantly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregúntale a Siri cuánto falta para poder dejarlo y te lo dirá al instante."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
