    "펼치는 아이폰에서 넓은 화면을 두 쪽으로 나눠 써요." : {
      "comment" : "Roadmap item detail: foldable iPhone layout",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Využijte širokou obrazovku skládacího iPhonu jako dva panely vedle sebe."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug den brede skærm på en foldbar iPhone som to ruder side om side."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze den breiten Bildschirm eines faltbaren iPhones als zwei nebeneinanderliegende Bereiche."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιήστε την πλατιά οθόνη ενός αναδιπλούμενου iPhone ως δύο πλαϊνά τμήματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the wide screen of a foldable iPhone as two side-by-side panes."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the wide screen of a foldable iPhone as two side-by-side panes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la pantalla ancha de un iPhone plegable como dos paneles en paralelo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä taittuvan iPhonen leveää näyttöä kahtena rinnakkaisena ruutuna."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez le grand écran d’un iPhone pliable comme deux volets côte à côte."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan layar lebar iPhone lipat sebagai dua panel berdampingan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa lo schermo largo di un iPhone pieghevole come due pannelli affiancati."
