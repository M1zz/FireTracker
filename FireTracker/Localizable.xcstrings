    "월급은 올랐어도 물가가 더 올라서, 실제 살 수 있는 양은 줄었어요." : {
      "comment" : "Text describing the difference between real and nominal wages.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mzda vzrostla, ale ceny vzrostly víc, takže to, co si skutečně koupíte, kleslo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din løn steg, men priserne steg mere, så det, du reelt kan købe, faldt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Gehalt ist gestiegen, aber die Preise sind stärker gestiegen, deshalb ist das, was du dir tatsächlich leisten kannst, gesunken."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο μισθός σας αυξήθηκε, αλλά οι τιμές αυξήθηκαν περισσότερο, οπότε ό,τι μπορείτε πράγματι να αγοράσετε μειώθηκε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your salary rose, but prices rose more, so what you can actually buy went down."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your salary rose, but prices rose more, so what you can actually buy went down."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu sueldo subió, pero los precios subieron más, así que lo que realmente puedes comprar bajó."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palkkasi nousi, mutta hinnat nousivat enemmän, joten se, mitä voit oikeasti ostaa, väheni."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre salaire a augmenté, mais les prix ont augmenté davantage : ce que vous pouvez réellement acheter a diminué."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaji Anda naik, tetapi harga naik lebih banyak, sehingga yang benar-benar bisa dibeli berkurang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo stipendio è salito, ma i prezzi sono saliti di più, quindi ciò che puoi davvero comprare è diminuito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "給料は上がったのに物価がもっと上がり、実際に買える量は減りました。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lønnen din steg, men prisene steg mer, så det du faktisk kan kjøpe, sank."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je salaris steeg, maar de prijzen stegen meer, dus wat je echt kunt kopen is gedaald."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja pensja wzrosła, ale ceny wzrosły bardziej, więc to, co naprawdę możesz kupić, spadło."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu salário subiu, mas os preços subiram mais, então o que você realmente consegue comprar diminuiu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зарплата выросла, но цены выросли сильнее, поэтому реально купить можно меньше."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din lön steg, men priserna steg mer, så det du faktiskt kan köpa minskade."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เงินเดือนขึ้นแต่ราคาสินค้าขึ้นมากกว่า ของที่ซื้อได้จริงจึงลดลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maaşınız arttı ama fiyatlar daha çok arttı; bu yüzden gerçekten alabildiğiniz miktar azaldı."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lương đã tăng nhưng giá cả tăng nhiều hơn nên lượng hàng thực sự mua được đã giảm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月薪涨了，但物价涨得更多，实际能买到的东西减少了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月薪漲了，但物價漲得更多，實際能買到的東西減少了。"
          }
        }
      }
    },
