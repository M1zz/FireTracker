    "시장 몫은 석 달 뒤면 뒤집힐 수 있지만, 내가 모은 돈은 남아요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The market's share can reverse in three months; what you saved stays."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시장 몫은 석 달 뒤면 뒤집힐 수 있지만, 내가 모은 돈은 남아요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The market's share can reverse in three months; what you saved stays."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "市場の取り分は3か月後に逆転することもありますが、自分で貯めたお金は残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "市场带来的那部分三个月后可能逆转，但你攒下的钱会留下。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "市場帶來的那部分三個月後可能逆轉，但你攢下的錢會留下。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La parte del mercado puede revertirse en tres meses; lo que ahorraste se queda."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Anteil des Marktes kann sich in drei Monaten umkehren; was du gespart hast, bleibt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La part du marché peut s’inverser en trois mois ; ce que vous avez épargné reste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La parte dovuta al mercato può invertirsi in tre mesi; quello che hai risparmiato resta."
          }
        }
      }
    },
    "시장이 나쁘게 흘러가는 10번 중 1번은 %lld세쯤 돈이 바닥나요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In 1 of 10 bad market paths, money runs out around age %lld."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시장이 나쁘게 흘러가는 10번 중 1번은 %lld세쯤 돈이 바닥나요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In 1 of 10 bad market paths, money runs out around age %lld."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相場が悪く推移する10回に1回は、%lld歳ごろにお金が尽きます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在10次糟糕的行情中，有1次会在%lld岁左右花光钱。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在10次糟糕的行情中，有1次會在%lld歲左右花光錢。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En 1 de cada 10 trayectorias malas del mercado, el dinero se acaba hacia los %lld años."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei 1 von 10 schlechten Marktverläufen geht das Geld etwa mit %lld aus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans 1 trajectoire de marché défavorable sur 10, l’argent s’épuise vers %lld ans."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
