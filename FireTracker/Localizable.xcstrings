    "모두 들떠 있어요. 크게 사기보다 점검할 때예요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everyone's excited. A time to review, not to buy big."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모두 들떠 있어요. 크게 사기보다 점검할 때예요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everyone's excited. A time to review, not to buy big."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "みんな浮かれています。大きく買うより、見直すときです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大家都很兴奋。现在适合复盘，而不是大举买入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大家都很興奮。現在適合覆盤，而不是大舉買入。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos están eufóricos. Es momento de revisar, no de comprar a lo grande."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle sind euphorisch. Zeit zum Prüfen, nicht für große Käufe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout le monde est euphorique. C’est le moment de vérifier, pas d’acheter gros."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono tutti euforici. È il momento di controllare, non di comprare in grande."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo mundo está eufórico. É hora de revisar, não de comprar pesado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все в эйфории. Время проверять, а не покупать много."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทุกคนกำลังตื่นเต้น ถึงเวลาตรวจสอบ ไม่ใช่ซื้อก้อนใหญ่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ai cũng đang phấn khích. Đây là lúc rà soát chứ không phải mua lớn."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všichni jsou nadšení. Čas na kontrolu, ne na velké nákupy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle er i festhumør. Tid til at gennemgå, ikke til at købe stort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλοι είναι ενθουσιασμένοι. Ώρα για έλεγχο, όχι για μεγάλες αγορές."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki ovat innoissaan. On aika tarkistaa, ei ostaa isosti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua orang sedang euforia. Saatnya meninjau, bukan membeli besar-besaran."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle er i feststemning. På tide å gå gjennom, ikke kjøpe stort."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iedereen is uitbundig. Tijd om te toetsen, niet om groot in te kopen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszyscy są w euforii. Czas na przegląd, a nie na duże zakupy."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla är euforiska. Dags att granska, inte att köpa stort."
