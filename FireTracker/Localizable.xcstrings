          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для смеси акций и облигаций обычно берут реальную доходность 3–5 % и волатильность 8–15 %."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En blandning av aktier och obligationer förutsätter vanligtvis 3–5 % real avkastning och 8–15 % variation."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่วนผสมหุ้นกับพันธบัตรมักสมมติผลตอบแทนที่แท้จริง 3–5% และความผันผวน 8–15%"
