    "탭하면 그때 넣었던 조건을 계산기로 되돌려요. 지금 계산기에 있는 값은 덮어써집니다." : {
      "comment" : "A footer for the list of saved calculations.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap to put the settings you entered then back into the calculator. Values now in the calculator will be overwritten."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap to put the settings you entered then back into the calculator. Values now in the calculator will be overwritten."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タップすると、そのとき入れた条件を計算機に戻します。今計算機に入っている値は上書きされます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按即可把当时填入的条件放回计算器。计算器里现有的值会被覆盖。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下即可把當時填入的條件放回計算器。計算器裡現有的值會被覆蓋。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca para volver a poner en la calculadora las condiciones que introdujiste entonces. Los valores actuales de la calculadora se sobrescribirán."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe, um die damals eingegebenen Werte zurück in den Rechner zu legen. Die aktuellen Werte im Rechner werden überschrieben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez pour remettre dans le calculateur les conditions saisies alors. Les valeurs actuelles du calculateur seront écrasées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca per rimettere nel calcolatore le condizioni inserite allora. I valori attuali del calcolatore verranno sovrascritti."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque para devolver à calculadora as condições informadas na época. Os valores atuais da calculadora serão sobrescritos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите, чтобы вернуть в калькулятор введённые тогда условия. Текущие значения в калькуляторе будут перезаписаны."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะเพื่อใส่เงื่อนไขที่กรอกไว้ตอนนั้นกลับเข้าเครื่องคิดเลข ค่าในเครื่องคิดเลขตอนนี้จะถูกเขียนทับ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm để đưa lại vào máy tính các điều kiện đã nhập khi đó. Các giá trị hiện có trong máy tính sẽ bị ghi đè."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepnutím vrátíte do kalkulačky podmínky zadané tehdy. Aktuální hodnoty v kalkulačce se přepíšou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk for at lægge de betingelser, du indtastede dengang, tilbage i beregneren. De nuværende værdier i beregneren overskrives."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε για να βάλετε ξανά στον υπολογιστή τις συνθήκες που είχατε εισαγάγει τότε. Οι τρέχουσες τιμές του υπολογιστή θα αντικατασταθούν."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta palauttaaksesi silloin syöttämäsi ehdot laskuriin. Laskurin nykyiset arvot korvataan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk untuk mengembalikan kondisi yang dimasukkan saat itu ke kalkulator. Nilai yang ada di kalkulator akan tertimpa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk for å legge vilkårene du skrev inn den gang, tilbake i kalkulatoren. Dagens verdier i kalkulatoren overskrives."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik om de voorwaarden die je toen invoerde terug in de rekenmachine te zetten. De huidige waarden in de rekenmachine worden overschreven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij, aby wstawić do kalkulatora warunki wpisane wtedy. Bieżące wartości w kalkulatorze zostaną nadpisane."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck för att lägga tillbaka villkoren du angav då i räknaren. Nuvarande värden i räknaren skrivs över."
          }
        }
      }
    },
    "탭하면 조건을 바꿀 수 있어요. 확률은 같은 시장 가정으로 계산해 서로 비교할 수 있어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap to change conditions. All chances use the same market assumptions, so they're comparable."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭하면 조건을 바꿀 수 있어요. 확률은 같은 시장 가정으로 계산해 서로 비교할 수 있어요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap to change conditions. All chances use the same market assumptions, so they're comparable."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タップして条件を変えられます。どの確率も同じ市場の仮定を使うので、比べられます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按可更改条件。所有概率使用相同的市场假设，因此可以相互比较。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下可更改條件。所有機率使用相同的市場假設，因此可以相互比較。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca para cambiar las condiciones. Todas las probabilidades usan los mismos supuestos de mercado, así que son comparables."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe, um Bedingungen zu ändern. Alle Chancen nutzen dieselben Marktannahmen und sind daher vergleichbar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez pour modifier les conditions. Toutes les chances utilisent les mêmes hypothèses de marché et sont donc comparables."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca per cambiare le condizioni. Tutte le probabilità usano le stesse ipotesi di mercato, quindi sono confrontabili."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque para mudar as condições. Todas as chances usam as mesmas premissas de mercado, então são comparáveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите, чтобы изменить условия. Все шансы используют одни и те же допущения рынка, поэтому их можно сравнивать."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะเพื่อเปลี่ยนเงื่อนไข ทุกโอกาสใช้สมมติฐานตลาดเดียวกัน จึงเปรียบเทียบกันได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm để đổi điều kiện. Mọi khả năng đều dùng cùng giả định thị trường nên so sánh được với nhau."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepnutím změníte podmínky. Všechny šance používají stejné tržní předpoklady, takže jsou srovnatelné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk for at ændre betingelserne. Alle chancer bruger de samme markedsantagelser, så de kan sammenlignes."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε για να αλλάξετε τις συνθήκες. Όλες οι πιθανότητες χρησιμοποιούν τις ίδιες παραδοχές αγοράς, οπότε είναι συγκρίσιμες."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta muuttaaksesi ehtoja. Kaikki todennäköisyydet käyttävät samoja markkinaoletuksia, joten ne ovat vertailukelpoisia."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk untuk mengubah kondisi. Semua peluang memakai asumsi pasar yang sama, sehingga dapat dibandingkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk for å endre vilkårene. Alle sjansene bruker de samme markedsantakelsene, så de kan sammenlignes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik om de voorwaarden te wijzigen. Alle kansen gebruiken dezelfde marktaannames, dus ze zijn vergelijkbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij, aby zmienić warunki. Wszystkie szanse używają tych samych założeń rynkowych, więc można je porównywać."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck för att ändra villkoren. Alla chanser använder samma marknadsantaganden, så de är jämförbara."
          }
        }
      }
    },
