        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągnij, a krzywa od razu się zmieni. Stuknij liczbę, aby ją wpisać; przesuń po wykresie, aby zobaczyć aktywa według wieku."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra så ändras kurvan direkt. Tryck på ett tal för att ange det; svep över diagrammet för att se tillgångar per ålder."
