    "그때의 ‘충분’, 지금도 그런가요?" : {
      "comment" : "A question that asks whether the value of a life has changed.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is your old idea of ‘enough’ still true today?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is your old idea of ‘enough’ still true today?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あのときの「十分」は、今も同じですか？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当时的“够用”，现在还是这样吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當時的「夠用」，現在還是這樣嗎？"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Lo que entonces era «suficiente» lo sigue siendo hoy?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "War das „genug“ von damals auch heute noch genug?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce « assez » d’alors, l’est-il encore aujourd’hui ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il «abbastanza» di allora, vale ancora oggi?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O “suficiente” daquela época ainda vale hoje?"
