        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giá trị thị trường bị ẩn nên chúng tôi tính từ lãi/lỗ và lợi suất. Hãy kiểm tra lại."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tržní hodnota byla skrytá, proto jsme počítali ze zisku/ztráty a výnosu. Zkontrolujte to."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markedsværdien var skjult, så vi har regnet ud fra gevinst/tab og afkast. Tjek venligst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αγοραία αξία ήταν κρυμμένη, οπότε υπολογίσαμε από το κέρδος/ζημιά και την απόδοση. Ελέγξτε την."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markkina-arvo oli piilossa, joten laskimme voitosta/tappiosta ja tuotosta. Tarkista."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nilai pasar tersembunyi, jadi kami menghitung dari untung/rugi dan imbal hasil. Mohon periksa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markedsverdien var skjult, så vi har regnet ut fra gevinst/tap og avkastning. Sjekk den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De marktwaarde was verborgen, dus we hebben berekend vanuit winst/verlies en rendement. Controleer het even."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartość rynkowa była ukryta, więc obliczyliśmy ją z zysku/straty i zwrotu. Sprawdź to."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marknadsvärdet var dolt, så vi räknade från vinst/förlust och avkastning. Kontrollera det."
          }
        }
      }
    },
