        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "換新iPhone後，我的資產記錄也會透過iCloud原樣延續。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia a un iPhone nuevo y tu historial de ahorro continúa gracias a iCloud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch mit einem neuen iPhone bleibt dein Vermögensverlauf über iCloud erhalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Même si vous changez d’iPhone, l’historique de votre patrimoine suit via iCloud."
