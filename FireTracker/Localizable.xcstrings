    "살 때 정한 %@원에 닿았어요(지금 %@원). 팔기로 한 가격이에요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cena dosáhla %@ wonů určených při nákupu (teď %@ wonů). Za tuto cenu jste chtěli prodat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prisen på %@ won, som du satte ved købet, er nået (nu %@ won). Det er prisen, du besluttede at sælge ved."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein beim Kauf gesetztes Ziel von %@ Won ist erreicht (jetzt %@ Won). Zu diesem Preis wolltest du verkaufen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έφτασε τα %@ γουόν που ορίσατε κατά την αγορά (τώρα %@ γουόν). Αυτή είναι η τιμή πώλησης που επιλέξατε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hit the %@ won you set when buying (now %@ won). This is your sell price."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hit the %@ won you set when buying (now %@ won). This is your sell price."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha llegado a los %@ wones que fijaste al comprar (ahora %@ wones). Es el precio al que decidiste vender."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostaessa asettamasi %@ wonia saavutettiin (nyt %@ wonia). Tämä on hinta, jolla päätit myydä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le prix de %@ wons fixé à l’achat est atteint (actuellement %@ wons). C’est le prix auquel vous aviez prévu de vendre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyentuh %@ won yang Anda tetapkan saat membeli (sekarang %@ won). Ini harga yang Anda putuskan untuk jual."
          }
        },
        "it" : {
          "stringUnit" : {
