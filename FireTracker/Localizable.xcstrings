        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din nuværende løn %1$@ er %4$@ højere end lønnen fra %2$@ i dagens priser (%3$@)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο τρέχων μισθός σας %1$@ είναι κατά %4$@ υψηλότερος από τον μισθό του %2$@ σε σημερινές τιμές (%3$@)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nykyinen palkkasi %1$@ on %4$@ suurempi kuin vuoden %2$@ palkka tämän päivän hinnoin (%3$@)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaji Anda sekarang, %1$@, %4$@ lebih tinggi dari gaji %2$@ dalam harga hari ini (%3$@)."
