    "매매 내역도 함께 지워져요. 지난 기록은 남습니다. 되돌릴 수 없어요." : {
      "comment" : "A message that appears when the user tries to delete",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smaže se i historie obchodů. Dřívější záznamy zůstanou. Nelze vrátit zpět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handelshistorikken slettes også. Tidligere registreringer bliver. Kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Handelsverlauf wird ebenfalls gelöscht. Frühere Einträge bleiben. Das lässt sich nicht rückgängig machen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαγράφεται και το ιστορικό συναλλαγών. Οι παλιές καταγραφές μένουν. Δεν μπορεί να αναιρεθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The trade history is deleted too. Past records stay. This can't be undone."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The trade history is deleted too. Past records stay. This can't be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El historial de operaciones también se elimina. Los registros pasados se conservan. No se puede deshacer."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Myös kauppahistoria poistetaan. Aiemmat merkinnät säilyvät. Tätä ei voi perua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’historique des opérations est aussi supprimé. Les enregistrements passés restent. Cette action est irréversible."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riwayat transaksi juga terhapus. Catatan lampau tetap ada. Tidak dapat dibatalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche la cronologia delle operazioni viene eliminata. Le registrazioni passate restano. Non si può annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "売買履歴も一緒に消えます。過去の記録は残ります。元に戻せません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handelshistorikken slettes også. Tidligere registreringer blir. Kan ikke angres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De transactiegeschiedenis wordt ook verwijderd. Eerdere registraties blijven. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historia transakcji także zostanie usunięta. Wcześniejsze zapisy zostają. Nie można tego cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O histórico de operações também é excluído. Os registros passados permanecem. Não é possível desfazer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "История сделок тоже удаляется. Прошлые записи остаются. Это нельзя отменить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affärshistoriken tas också bort. Tidigare registreringar blir kvar. Kan inte ångras."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ประวัติซื้อขายจะถูกลบไปด้วย บันทึกในอดีตยังอยู่ ย้อนกลับไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşlem geçmişi de silinir. Geçmiş kayıtlar kalır. Geri alınamaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lịch sử giao dịch cũng bị xóa. Các bản ghi trước đó vẫn còn. Không thể hoàn tác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "交易明细也会一并删除。过去的记录会保留。无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "交易明細也會一併刪除。過去的記錄會保留。無法撤銷。"
          }
