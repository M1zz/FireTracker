            "state": "translated",
            "value": "%lld years later"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld년 늦게"
          }
        }
      }
    },
    "%lld년 일찍": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld years earlier"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld년 일찍"
          }
