    "데모 중에 넣은 내용은 끄면 사라져요. 끄면 내 데이터로 돌아가요." : {
      "comment" : "A description of the effect of toggling the demo mode.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co zadáte během ukázky, zmizí po vypnutí. Po vypnutí se vrátíte k vlastním datům."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det, du tilføjer under demoen, forsvinder, når du slår den fra. Slår du den fra, er du tilbage ved dine data."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was du während der Demo einträgst, verschwindet beim Ausschalten. Danach siehst du wieder deine Daten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όσα βάλετε κατά το demo χάνονται όταν το απενεργοποιήσετε. Όταν το απενεργοποιήσετε, επιστρέφετε στα δικά σας δεδομένα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anything you add during the demo disappears when you turn it off. Turning it off brings back your data."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anything you add during the demo disappears when you turn it off. Turning it off brings back your data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que añadas durante la demostración desaparece al desactivarla. Al desactivarla vuelves a tus datos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demon aikana lisäämäsi katoaa, kun kytket sen pois. Pois kytkettynä palaat omiin tietoihisi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que vous ajoutez pendant la démo disparaît à la désactivation. Vous retrouvez ensuite vos données."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yang Anda masukkan selama demo hilang saat dinonaktifkan. Setelah dinonaktifkan, Anda kembali ke data Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto inserisci durante la demo sparisce quando la disattivi. Disattivandola torni ai tuoi dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デモ中に入れた内容は、オフにすると消えます。オフにすると自分のデータに戻ります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det du legger inn under demoen, forsvinner når du slår den av. Slår du den av, er du tilbake til dataene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat je tijdens de demo invoert, verdwijnt zodra je hem uitzet. Zet je hem uit, dan ben je terug bij je gegevens."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To, co dodasz podczas demo, zniknie po jego wyłączeniu. Po wyłączeniu wrócisz do swoich danych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que você adicionar durante a demonstração some ao desativá-la. Ao desativar, você volta aos seus dados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё, что вы добавили в демо, исчезнет при выключении. После выключения вернутся ваши данные."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det du lägger in under demon försvinner när du slår av den. Slår du av den är du tillbaka till dina data."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สิ่งที่ใส่ระหว่างโหมดตัวอย่างจะหายเมื่อปิด เมื่อปิดจะกลับไปที่ข้อมูลของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demo sırasında girdikleriniz kapatınca silinir. Kapatınca verilerinize dönersiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những gì bạn nhập trong chế độ mẫu sẽ mất khi tắt. Tắt đi sẽ quay về dữ liệu của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "演示中填入的内容在关闭后会消失。关闭后回到我自己的数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "演示中填入的內容在關閉後會消失。關閉後回到我自己的資料。"
          }
        }
      }
    },
