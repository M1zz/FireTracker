        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "例：換工作讓儲蓄增加就填+30%，搬家使生活費減少就填−20%。"
          }
        },
        "es" : {
          "stringUnit" : {
