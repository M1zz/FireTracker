    "순자산 %@원 중 실제 쓸 수 있는 돈입니다. 실거주 부동산·전세보증금·연금·부채는 묶인 돈으로 빠집니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The part of your %@ won net worth you can actually spend. Your own home, jeonse deposits, pensions and debt are left out as locked-up money."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The part of your %@ won net worth you can actually spend. Your own home, jeonse deposits, pensions and debt are left out as locked-up money."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "純資産%@ウォンのうち、実際に使えるお金です。住んでいる不動産・チョンセ保証金・年金・負債は拘束されたお金として除きます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是净资产%@韩元中真正能用的钱。自住房产、全租押金、养老金和负债属于被占用的钱，不计入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是淨資產%@韓元中真正能用的錢。自住房地產、全租押金、年金和負債屬於被佔用的錢，不計入。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es el dinero que de verdad puedes usar de tus %@ wones de patrimonio neto. Quedan fuera el dinero inmovilizado: la vivienda donde vives, fianzas jeonse, pensiones y deudas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Teil deines Nettovermögens von %@ Won, über den du wirklich verfügen kannst. Selbstgenutzte Immobilien, Jeonse-Kautionen, Renten und Schulden sind gebunden und werden abgezogen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur votre patrimoine net de %@ wons, voici l’argent réellement utilisable. Résidence principale, caution jeonse, retraite et dettes sont exclues comme argent bloqué."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono i soldi davvero spendibili dei %@ won di patrimonio netto. Casa in cui abiti, cauzione jeonse, pensioni e debiti sono soldi vincolati ed esclusi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É o dinheiro que você pode usar de fato dos %@ wons de patrimônio líquido. Imóvel onde mora, caução jeonse, pensões e dívidas ficam de fora, por ser dinheiro preso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Из чистого капитала %@ вон это деньги, которые реально можно потратить. Жильё, где вы живёте, залог чонсе, пенсии и долги не учитываются — это связанные деньги."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เงินที่ใช้ได้จริงจากความมั่งคั่งสุทธิ %@ วอน อสังหาฯ ที่อยู่อาศัยเอง เงินมัดจำช็อนเซ บำนาญ และหนี้ ถือเป็นเงินที่ถูกผูกไว้จึงไม่นับรวม"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đây là số tiền thực sự dùng được trong %@ won tài sản ròng. Bất động sản đang ở, tiền đặt cọc jeonse, lương hưu và nợ được tính là tiền bị khóa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z čistého jmění %@ wonů jsou to peníze, které můžete skutečně utratit. Bydlení, kde žijete, jeonse kauce, důchody a dluhy se nepočítají — jsou to vázané peníze."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Af din nettoformue på %@ won er dette de penge, du faktisk kan bruge. Bolig, du selv bor i, jeonse-depositum, pension og gæld trækkes fra som bundne penge."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Από την καθαρή περιουσία των %@ γουόν, αυτά είναι όσα μπορείτε πραγματικά να ξοδέψετε. Η κατοικία σας, η εγγύηση jeonse, οι συντάξεις και το χρέος εξαιρούνται ως δεσμευμένα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osuus %@ wonin nettovarallisuudesta, jonka voit oikeasti käyttää. Oma asunto, jeonse-vakuus, eläkkeet ja velat jätetään pois sidottuna rahana."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagian dari kekayaan bersih %@ won yang benar-benar bisa dipakai. Properti yang ditinggali, deposit jeonse, pensiun, dan utang dihitung sebagai uang terkunci."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av nettoformuen på %@ won er dette pengene du faktisk kan bruke. Bolig du bor i selv, jeonse-depositum, pensjon og gjeld trekkes fra som bundne penger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het deel van je nettovermogen van %@ won dat je echt kunt gebruiken. Eigen woning, jeonse-borg, pensioen en schulden zitten vast en tellen niet mee."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To część wartości netto %@ wonów, którą naprawdę możesz wydać. Mieszkanie, w którym mieszkasz, kaucja jeonse, emerytury i długi są pominięte jako pieniądze zamrożone."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av nettoförmögenheten på %@ won är det här pengar du faktiskt kan använda. Fastighet du bor i, jeonse-deposition, pension och skulder räknas bort som bundna pengar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ won net varlığın gerçekte harcanabilir kısmı. Oturulan konut, jeonse depozitosu, emeklilik ve borçlar bağlı para olarak çıkarılır."
          }
        }
      }
    },
