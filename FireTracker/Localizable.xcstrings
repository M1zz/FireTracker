    "밀면 곡선이 바로 바뀌어요. 숫자를 누르면 직접 입력, 차트를 훑으면 나이별 자산." : {
      "comment" : "A description of the functionality of the view.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tažením se křivka hned změní. Klepnutím na číslo ho zadáte, přejetím po grafu uvidíte majetek podle věku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træk, og kurven ændres. Tryk på et tal for at skrive det; stryg over diagrammet for aktiver efter alder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen ändert die Kurve sofort. Zahl antippen zum Eingeben, übers Diagramm wischen für Vermögen je Alter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σύρετε και η καμπύλη αλλάζει. Πατήστε έναν αριθμό για εισαγωγή· σύρετε στο γράφημα για την περιουσία ανά ηλικία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag and the curve updates. Tap a number to type it; sweep the chart for assets by age."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag and the curve updates. Tap a number to type it; sweep the chart for assets by age."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra y la curva cambia. Toca un número para escribirlo; recorre el gráfico para ver activos por edad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedä, niin käyrä muuttuu heti. Napauta lukua syöttääksesi sen; liu’uta kaaviota nähdäksesi varat iän mukaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glissez et la courbe suit. Touchez un chiffre pour le saisir ; parcourez le graphique pour les actifs par âge."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seret dan kurva langsung berubah. Ketuk angka untuk memasukkannya; geser di grafik untuk melihat aset menurut usia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina e la curva cambia subito. Tocca un numero per inserirlo, scorri il grafico per vedere il patrimonio per età."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグすると曲線がすぐに変わります。数字をタップして直接入力、チャートをなぞると年齢別の資産が見られます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra, så endres kurven. Trykk på et tall for å skrive det; stryk over diagrammet for eiendeler etter alder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep en de curve verandert. Tik een getal om te typen; veeg over de grafiek voor bezit per leeftijd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągnij, a krzywa się zmieni. Stuknij liczbę, by ją wpisać; przesuń po wykresie, by zobaczyć aktywa wg wieku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste e a curva muda na hora. Toque em um número para digitar; deslize pelo gráfico para ver os ativos por idade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потяните — кривая сразу изменится. Нажмите на число, чтобы ввести; проведите по графику — активы по возрасту."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra så ändras kurvan. Tryck på ett tal för att skriva in det; svep över diagrammet för tillgångar per ålder."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลากแล้วเส้นโค้งเปลี่ยนทันที แตะตัวเลขเพื่อกรอกเอง ปาดบนแผนภูมิเพื่อดูสินทรัพย์ตามอายุ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sürükleyin, eğri hemen değişsin. Yazmak için sayıya dokunun; yaşa göre varlıklar için grafikte kaydırın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kéo là đường cong đổi ngay. Chạm vào con số để nhập, lướt trên biểu đồ để xem tài sản theo tuổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动曲线会立刻变化。点按数字可直接输入，滑过图表可看到各年龄的资产。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖動曲線會立刻變化。點一下數字可直接輸入，滑過圖表可看到各年齡的資產。"
          }
        }
      }
    },
