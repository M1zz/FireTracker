        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อขยายขนาดตัวอักษร หน้าจอจะจัดวางใหม่อย่างเรียบร้อยโดยไม่ถูกตัด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi tăng cỡ chữ, màn hình được bố trí lại gọn gàng thay vì bị cắt."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při zvětšení písma se obrazovky přeskládají přehledně a nejsou oříznuté."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du gør teksten større, bliver skærmene sat pænt om i stedet for at blive skåret af."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν μεγαλώνετε το κείμενο, οι οθόνες αναδιατάσσονται σωστά αντί να κόβονται."
