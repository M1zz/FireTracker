    "시장 몫은 석 달 뒤면 뒤집힐 수 있지만, 내가 모은 돈은 남아요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The market's share can reverse in three months; what you saved stays."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시장 몫은 석 달 뒤면 뒤집힐 수 있지만, 내가 모은 돈은 남아요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The market's share can reverse in three months; what you saved stays."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "市場の取り分は3か月後に逆転することもありますが、自分で貯めたお金は残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "市场带来的那部分三个月后可能逆转，但你攒下的钱会留下。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "市場帶來的那部分三個月後可能逆轉，但你攢下的錢會留下。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La parte del mercado puede revertirse en tres meses; lo que ahorraste se queda."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Anteil des Marktes kann sich in drei Monaten umkehren; was du gespart hast, bleibt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La part du marché peut s’inverser en trois mois ; ce que vous avez épargné reste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La parte dovuta al mercato può invertirsi in tre mesi; quello che hai risparmiato resta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A parte do mercado pode se reverter em três meses; o que você juntou fica."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доля рынка за три месяца может развернуться, а накопленное вами остаётся."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่วนของตลาดอาจพลิกกลับได้ภายในสามเดือน แต่เงินที่คุณออมไว้ยังอยู่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phần của thị trường có thể đảo chiều sau ba tháng, còn số tiền bạn đã tiết kiệm vẫn còn."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podíl trhu se může za tři měsíce obrátit, ale to, co jste našetřili, zůstane."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markedets andel kan vende på tre måneder; det, du har sparet op, bliver."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το μερίδιο της αγοράς μπορεί να αντιστραφεί σε τρεις μήνες· όσα έχετε αποταμιεύσει μένουν."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markkinoiden osuus voi kääntyä kolmessa kuukaudessa; se, minkä säästit, jää."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagian dari pasar bisa berbalik dalam tiga bulan; yang sudah Anda tabung tetap ada."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markedets andel kan snu på tre måneder; det du har spart, blir."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het aandeel van de markt kan in drie maanden omslaan; wat je hebt gespaard, blijft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udział rynku może się odwrócić w trzy miesiące; to, co zaoszczędziłeś, zostaje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marknadens andel kan vända på tre månader; det du sparat blir kvar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piyasanın payı üç ayda tersine dönebilir; biriktirdiğiniz para kalır."
          }
        }
      }
    },
