    "피부양자 기준(연소득 2,000만원, 재산 과표 5.4억원)을 넘어 피부양자는 어려워요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Překračuje limity pro vyživovanou osobu (příjem 20 mil. wonů, daňový základ majetku 540 mil. wonů), proto je status vyživované osoby nepravděpodobný."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Over grænserne for forsørgede (indkomst 20 mio. won, formuegrundlag 540 mio. won), så det er usandsynligt, at du kan være forsørget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über den Grenzen für Angehörige (Einkommen 20 Mio. Won, Vermögensbemessung 540 Mio. Won), eine Mitversicherung ist daher unwahrscheinlich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεπερνά τα όρια εξαρτώμενου (εισόδημα 20 εκατ. γουόν, φορολογητέα βάση περιουσίας 540 εκατ. γουόν), οπότε η ιδιότητα εξαρτώμενου είναι απίθανη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Over the dependent limits (20M won income, 540M won property tax base), so dependent status is unlikely."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Over the dependent limits (20M won income, 540M won property tax base), so dependent status is unlikely."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supera los límites de beneficiario (ingresos de 20 M de wones, base imponible patrimonial de 540 M de wones), así que es poco probable que figures como beneficiario."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ylittää huollettavan rajat (tulo 20 milj. wonia, omaisuuden verotusarvo 540 milj. wonia), joten huollettavan asema on epätodennäköinen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dépasse les plafonds d’ayant droit (revenu de 20 M de wons, base imposable du patrimoine de 540 M de wons) : le statut d’ayant droit est peu probable."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melebihi batas tanggungan (pendapatan 20 juta won, dasar pajak kekayaan 540 juta won), jadi status tanggungan sulit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supera i limiti di familiare a carico (reddito 20 mln di won, base imponibile patrimoniale 540 mln di won), quindi è improbabile risultare a carico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被扶養者の上限（所得2,000万ウォン、財産の課税標準5.4億ウォン）を超えているため、被扶養者になるのは難しそうです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "피부양자 기준(연소득 2,000만원, 재산 과표 5.4억원)을 넘어 피부양자는 어려워요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Over grensene for forsørgede (inntekt 20 mill. won, formuesgrunnlag 540 mill. won), så det er lite sannsynlig at du kan være forsørget."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boven de grenzen voor gezinsleden ten laste (inkomen 20 mln won, vermogensgrondslag 540 mln won), dus de status van gezinslid is onwaarschijnlijk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przekracza limity osoby na utrzymaniu (dochód 20 mln wonów, podstawa opodatkowania majątku 540 mln wonów), więc status osoby na utrzymaniu jest mało prawdopodobny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa dos limites de dependente (renda de 20 milhões de wons, base patrimonial de 540 milhões de wons), então é improvável ser dependente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Превышены лимиты иждивенца (доход 20 млн вон, налоговая база имущества 540 млн вон), поэтому статус иждивенца маловероятен."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Överstiger gränserna för försörjd (inkomst 20 milj. won, förmögenhetsunderlag 540 milj. won), så det är osannolikt att du räknas som försörjd."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เกินเกณฑ์ผู้อยู่ในอุปการะ (รายได้ 20 ล้านวอน ฐานภาษีทรัพย์สิน 540 ล้านวอน) จึงยากที่จะเป็นผู้อยู่ในอุปการะ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağımlı sınırlarını aşıyor (gelir 20 milyon won, mülk vergi matrahı 540 milyon won), bu yüzden bağımlı sayılmanız olası değil."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vượt giới hạn người phụ thuộc (thu nhập 20 triệu won, cơ sở thuế tài sản 540 triệu won) nên khó được coi là người phụ thuộc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超过被扶养人上限（收入2,000万韩元、财产计税标准5.4亿韩元），很难成为被扶养人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超過被扶養人上限（收入2,000萬韓元、財產計稅標準5.4億韓元），很難成為被扶養人。"
          }
        }
      }
    },
